---
// TextBlock — the textarea contract: a PLAIN MULTILINE STRING the way a CMS field
// delivers it, never markup. Voices: preamble (the standfirst, default) and body.
// The recipe lives in lib/typography.ts; this file renders it in Astro.
import "./TextBlock.css";
import DevError from "../DevError/DevError.astro";
import { resolveTypography } from "../../lib/typography";

interface Props {
  text?: string;
  element?: string;
  variant?: string;
  size?: string;
  align?: string;
  wrap?: string;
  class?: string;
  [key: string]: unknown;
}

const { text, element, variant, size, align, wrap, class: className, ...rest } = Astro.props;

const childHtml = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
const hasChildContent = childHtml.trim().length > 0;

const t = resolveTypography("TextBlock", { text, element, variant, size, align, wrap, class: className, hasChildContent });

const inner = t.mode === "render" ? `<span class="${t.container.className}">${t.innerHtml}</span>` : "";

const Tag = t.tag as "p";
---

{
  t.mode === "render" ? (
    <Tag class={t.className} {...t.attrs} {...rest} set:html={inner} />
  ) : t.mode === "error" ? (
    <DevError name="TextBlock" message={t.errorMessage} />
  ) : null
}
