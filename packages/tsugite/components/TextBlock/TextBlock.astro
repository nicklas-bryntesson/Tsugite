---
// TextBlock — the textarea contract (lib/typographyFamily.ts).
//
// Third input shape in the family: not a flow you don't control (Prose),
// not an authored single run (Text), but a PLAIN MULTILINE STRING the
// way a CMS textarea delivers it. The contract is enforced by
// construction: only the `text` prop is accepted (escaped), child
// content is a dev-visible error — sub-typography is unrepresentable —
// and line breaks are honored via white-space: pre-line.
//
// Voices: preamble (the standfirst, default) and body. One door per
// look: a single-run body text is Text's job, a body-voiced BLOCK from
// a plain field is this one's.

import { FAMILY, VOICE_SIZES } from "../../lib/typographyFamily.ts";

const VOICES = FAMILY.TextBlock.voices;
const DEFAULT_VARIANT = "preamble";
const DEFAULT_SIZE = "md";

const VALID_ALIGNS = ["left", "center", "right"];
const VALID_WRAPS = ["balance", "pretty", "stable", "nowrap"];

interface Props {
  text?: string;
  element?: string;
  variant?: string;
  size?: string;
  align?: string;
  wrap?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  text,
  element: elementProp = "p",
  variant: variantProp,
  size: sizeProp,
  align = "left",
  wrap = "pretty",
  class: className,
  ...rest
} = Astro.props;

const isDev = import.meta.env.DEV;

const escapeHtml = (s: string) =>
  s
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");

// ── Guards — the plaintext contract ─────────────────

const childHtml = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
const hasChildContent = childHtml.trim().length > 0;

let mode: "render" | "suppress" | "error" = "render";
let errorMessage = "";

if (hasChildContent) {
  mode = "error";
  errorMessage = "TextBlock takes plain text only (the textarea contract) — use the text prop, never child content";
} else if (!text) {
  mode = "suppress";
}

const variant = Object.keys(VOICES).includes((variantProp ?? "").toLowerCase())
  ? variantProp!.toLowerCase()
  : DEFAULT_VARIANT;
const element = VOICES[variant].includes(elementProp.toLowerCase())
  ? elementProp.toLowerCase()
  : "p";
const size = sizeProp && VOICE_SIZES[variant].includes(sizeProp.toLowerCase())
  ? sizeProp.toLowerCase()
  : DEFAULT_SIZE;

const alignAttr = VALID_ALIGNS.includes(align.toLowerCase()) ? align.toLowerCase() : undefined;
const wrapAttr = VALID_WRAPS.includes(wrap.toLowerCase()) ? wrap.toLowerCase() : undefined;

const cssClass = className && String(className).trim() ? `TextBlock ${className}` : "TextBlock";

const inner = mode === "render" ? `<span class="textblock-content">${escapeHtml(text!)}</span>` : "";

const Tag = element as "p";
---

{
  mode === "render" ? (
    <Tag
      class={cssClass}
      data-variant={variant}
      data-size={size}
      data-run="block"
      data-align={alignAttr}
      data-wrap={wrapAttr}
      {...rest}
      set:html={inner}
    />
  ) : mode === "error" && isDev ? (
    <div style="color:red;" set:html={`<!-- TextBlock: ${errorMessage} --><span>&times;</span>`} />
  ) : null
}

<style is:global>
/* =====================================================
   TEXTBLOCK COMPONENT — plain multiline text (textarea contract)
===================================================== */

.TextBlock {
  /* reset */
  word-wrap: break-word;
  overflow-wrap: break-word;
  margin-block: 0;

  /* ================================================
     TEXT CONTAINER (Typography Engine)
  ================================================= */

  .textblock-content {
    display: block;
    font-size: var(--_fontSize);
    line-height: var(--_lineHeight);
    /* the contract: line breaks from the plain field are honored,
       runs of spaces collapse */
    white-space: pre-line;
  }

  /* =====================================================
     VARIANT LAYER (voice + baseline offset)
  ===================================================== */

  &[data-variant="preamble"] {
    --_lineHeight: var(--lineHeight-preamble);
    --_baselineOffset: var(--baseline-offset-preamble);

    font-family: var(--fontFamily-preamble);
    font-weight: var(--fontWeight-preamble);
    letter-spacing: var(--letterSpacing-preamble);
    font-feature-settings: var(--fontFeatureSettings-preamble);

    &[data-size="sm"] { --_fontSize: var(--fontSize-preamble-small); }
    &[data-size="md"] { --_fontSize: var(--fontSize-preamble); }
    &[data-size="lg"] { --_fontSize: var(--fontSize-preamble-large); }
  }

  &[data-variant="body"] {
    --_lineHeight: var(--lineHeight-body);
    --_baselineOffset: var(--baseline-offset-body);

    font-family: var(--fontFamily-body);
    font-weight: var(--fontWeight-body);
    letter-spacing: var(--letterSpacing-body);
    font-feature-settings: var(--fontFeatureSettings-body);

    &[data-size="sm"] { --_fontSize: var(--fontSize-body-small); }
    &[data-size="md"] { --_fontSize: var(--fontSize-body); }
    &[data-size="lg"] { --_fontSize: var(--fontSize-body-large); }
  }

  /* =====================================================
     ALIGNMENT
  ===================================================== */

  &[data-align="left"]   { text-align: left; }
  &[data-align="center"] { text-align: center; }
  &[data-align="right"]  { text-align: right; }

  /* =====================================================
     WRAP STRATEGIES
  ===================================================== */

  &[data-wrap="balance"] { text-wrap: balance; }
  &[data-wrap="pretty"]  { text-wrap: pretty; }
  &[data-wrap="stable"]  { text-wrap: stable; }

  /* =====================================================
     FEATURE LAYER — TEXT TRIM
     Same gates as Heading/Text. Removable in one sweep.
  ===================================================== */

  /* Native trim branch */
  @supports (text-box-trim: trim-both) and (text-box-edge: cap alphabetic) {
    > .textblock-content {
      text-box-trim: trim-both;
      text-box-edge: cap alphabetic;
      margin-block: 0;
    }
  }

  /* Fallback branch */
  @supports not ((text-box-trim: trim-both) and (text-box-edge: cap alphabetic)) {
    > .textblock-content {
      --_effectiveLineHeight: calc(var(--_fontSize) * var(--_lineHeight));
      --_marginBlock: calc((var(--_fontSize) - var(--_effectiveLineHeight)) / 2);
      --_marginBlockStart: calc(var(--_marginBlock) + (var(--_baselineOffset, 0) * var(--_fontSize)));
      --_marginBlockEnd: calc(var(--_marginBlock) - (var(--_baselineOffset, 0) * var(--_fontSize)));

      margin-block-start: var(--_marginBlockStart);
      margin-block-end: var(--_marginBlockEnd);
    }
  }
}
</style>
