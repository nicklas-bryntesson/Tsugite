---
// Port of reference-components DateField — an accessible date input wrapping
// <input type="date">. Canonical markup from DateField.generate.ts; the
// verbatim DateField.ts hydrates it (segments, calendar grid, month/year
// wheels, popup).
import "../../kernel/css/Wheel.css";

interface Props {
  id: string;
  label: string;
  name?: string;
  locale?: string;
  /** YYYY-MM-DD — set on the native input (matches the reference states) */
  value?: string;
  /** YYYY-MM-DD */
  min?: string;
  /** YYYY-MM-DD */
  max?: string;
  disabled?: boolean;
  invalid?: boolean;
  required?: boolean;
  /** raw HTML appended inside the label (e.g. required marker) */
  labelSuffix?: string;
  [key: string]: unknown;
}

const {
  id,
  label,
  name = undefined,
  locale = "en-GB",
  value,
  min = "1900-01-01",
  max = "2100-12-31",
  disabled = false,
  invalid = false,
  required = false,
  labelSuffix,
  ...rest
} = Astro.props;
---

<label for={id}>{label}{labelSuffix && <Fragment set:html={` ${labelSuffix}`} />}</label>
<div
  class="DateField"
  data-component="DateField"
  data-id={id}
  data-name={name ?? id}
  data-locale={locale}
  data-min={min}
  data-max={max}
  data-disabled={disabled ? "true" : undefined}
  data-invalid={invalid ? "true" : undefined}
  {...rest}
>
  <input
    class="native"
    type="date"
    value={value}
    disabled={disabled}
    required={required}
    aria-invalid={invalid ? "true" : undefined}
  />
  <div class="custom" aria-hidden="true">
    <div class="segments" role="group">
      <button
        type="button"
        class="trigger"
        aria-label="Open calendar"
        aria-expanded="false"
        aria-haspopup="dialog"
        disabled={disabled}
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          width="18"
          height="18"
          ><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line
            x1="8"
            y1="2"
            x2="8"
            y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg
        >
      </button>
    </div>
    <div class="rail">
      <template data-template="datefield-calendar">
        <div class="popup" role="dialog" aria-modal="true">
          <div class="calendar-header">
            <button type="button" class="prev-month">&#8249;</button>
            <button type="button" class="month-year-trigger" aria-expanded="false"></button>
            <button type="button" class="next-month">&#8250;</button>
          </div>
          <div data-panel="calendar" data-active="true">
            <table class="calendar-grid" role="grid">
              <thead>
                <tr role="row"
                  ><th scope="col"></th><th scope="col"></th><th scope="col"></th><th scope="col"></th><th
                    scope="col"></th><th scope="col"></th><th scope="col"></th></tr
                >
              </thead>
              <tbody></tbody>
            </table>
          </div>
          <div class="year-month-picker WheelColumns" role="group" data-panel="picker" data-active="false">
            <div class="Wheel" data-picker="month" tabindex="0"></div>
            <div class="Wheel" data-picker="year" tabindex="0"></div>
          </div>
          <div class="calendar-footer">
            <button type="button" class="calendar-footer-clear"></button>
            <button type="button" class="calendar-footer-today"></button>
          </div>
          <div class="arrow"></div>
        </div>
      </template>
    </div>
  </div>
  <div class="announce" aria-live="polite" aria-atomic="true"></div>
</div>

<script>
  import DateField from "./DateField";
  DateField.attach();
</script>

<style is:global>
/* Root — tokens + root-level props only. Every part is a flat, fully-qualified
   `.DateField .element` rule below (ADR-0019). */
.DateField {
  position: relative;
  display: inline-block;
  overflow: hidden;
  /* Public API */
  --_df-calendar-width: 18rem;
  --_df-calendar-gap: 1.5rem;
  --_df-site-max-width: var(--MAX--WIDTH--SITE, 100rem);
  --_df-site-padding: var(--SITE--PADDING, 1rem);
  /* Field-family height contract — every field's bordered box is min 2.5rem tall */
  --_df-field-min-block-size: 2.5rem;
  /* Design tokens — segments */
  --_df-segments-border-color: currentColor;
  --_df-segments-border-color-hover: CanvasText;
  --_df-segments-bg-hover: var(--ui-hover);
  --_df-segments-border-color-invalid: var(--ui-destructive, #c00);
  --_df-segments-color-muted: var(--ui-muted-foreground);
  --_df-trigger-bg-hover: var(--ui-hover);
  --_df-trigger-bg-active: var(--ui-hover);
  /* Design tokens — calendar (shared popover surface) */
  --_df-calendar-bg: var(--ui-surface);
  --_df-calendar-color: var(--ui-surface-foreground);
  --_df-calendar-color-muted: var(--ui-muted-foreground);
  --_df-calendar-border-color: var(--ui-border);
  --_df-calendar-radius: var(--ui-radius);
  --_df-calendar-shadow: var(--ui-shadow);
  --_df-calendar-link-color: var(--ui-primary);
  /* Internal */
  --_df-rail-max-width: calc(var(--_df-site-max-width) + var(--_df-calendar-width));
  --_df-arrow-size: 0.75rem;
  --_df-arrow-corner-radius: 0.25rem;
}

/* ── Native / custom fallback ──────────────────────────────────────────── */
.DateField .native { display: block; }
.DateField .custom { display: none; }

.DateField[data-disabled="true"] {
  opacity: 0.5;
  cursor: not-allowed;
}
.DateField[data-disabled="true"] * {
  pointer-events: none;
}

.DateField[data-input-mode="custom"] .native {
  position: absolute;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  inline-size: 1px;
  block-size: 1px;
  overflow: hidden;
}
.DateField[data-input-mode="custom"] .custom {
  display: block;
}

.DateField[data-input-mode="display"] .native {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  cursor: pointer;
}
.DateField[data-input-mode="display"] .custom {
  display: block;
  pointer-events: none;
}

/* ── Segments ──────────────────────────────────────────────────────────── */
.DateField .segments {
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
  min-block-size: var(--_df-field-min-block-size);
  border: 1px solid var(--_df-segments-border-color);
  padding-inline: 0.5rem;
  padding-block: 0.25rem;
  gap: 0.125rem;
  border-radius: 4px;
}

.DateField .segment {
  font-variant-numeric: tabular-nums;
  min-inline-size: 2ch;
  text-align: center;
  outline: none;
  border-radius: 2px;
  cursor: default;
}
.DateField .segment[data-focused="true"] {
  background-color: var(--ui-primary);
  color: var(--ui-primary-foreground);
}
.DateField .segment[data-placeholder="true"] {
  color: var(--_df-segments-color-muted);
}

.DateField .separator {
  user-select: none;
  color: var(--_df-segments-color-muted);
}

.DateField .segments:hover,
.DateField[data-test-state="hover"] .segments {
  border-color: var(--_df-segments-border-color-hover);
  background-color: var(--_df-segments-bg-hover);
}

.DateField .segments:focus-within,
.DateField[data-test-state="focus"] .segments {
  outline: 2px solid;
  outline-offset: 1px;
}

.DateField[data-invalid="true"] .segments {
  border-color: var(--_df-segments-border-color-invalid);
}

/* ── Trigger ───────────────────────────────────────────────────────────── */
.DateField .trigger {
  margin-inline-start: 0.25rem;
  background: none;
  border: none;
  padding: 0.25rem;
  cursor: pointer;
  border-radius: 2px;
  vertical-align: middle;
}
.DateField .trigger svg {
  /* block — an inline svg reserves baseline descender space below the icon */
  display: block;
}
.DateField .trigger:hover,
.DateField[data-test-state="hover"] .trigger {
  background-color: var(--_df-trigger-bg-hover);
}
.DateField .trigger:active,
.DateField[data-test-state="active"] .trigger {
  background-color: var(--_df-trigger-bg-active);
}
.DateField .trigger:focus-visible {
  outline: 2px solid;
  outline-offset: 2px;
}

/* ── Announce (SR-only) ────────────────────────────────────────────────── */
.DateField .announce {
  position: absolute;
  inline-size: 1px;
  block-size: 1px;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

/* ── Popup surface ─────────────────────────────────────────────────────── */
.DateField .popup {
  position: absolute;
  background: var(--_df-calendar-bg);
  color: var(--_df-calendar-color);
  border: 1px solid var(--_df-calendar-border-color);
  padding: var(--ui-surface-padding);
  font-size: var(--ui-font-size);
  z-index: 100;
  border-radius: var(--_df-calendar-radius);
  box-shadow: var(--_df-calendar-shadow);
}

.DateField .popup .calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-block-end: 0.5rem;
  gap: 0.5rem;
}
.DateField .popup .calendar-header button {
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.25rem 0.5rem;
  border-radius: 2px;
  font-size: var(--ui-font-size);
  line-height: 1;
}
.DateField .popup .calendar-header button:focus-visible {
  outline: 2px solid;
  outline-offset: 2px;
}
.DateField .popup .calendar-header span {
  font-weight: var(--ui-font-weight-strong);
  flex: 1;
  text-align: center;
}

.DateField .popup .calendar-grid {
  width: 100%;
  border-collapse: collapse;
}
.DateField .popup .calendar-grid th {
  border: 0;
  padding: 0;
  padding-block-end: 0.25rem;
  text-align: center;
  font-weight: var(--ui-font-weight);
  color: var(--_df-calendar-color-muted);
  min-inline-size: 2rem;
}
.DateField .popup .calendar-grid td {
  border: 0;
  padding: 0;
}
.DateField .popup .calendar-grid td button {
  display: block;
  inline-size: 2rem;
  block-size: 2rem;
  background: none;
  border: none;
  cursor: pointer;
  border-radius: 2px;
  font-variant-numeric: tabular-nums;
}
.DateField .popup .calendar-grid td button:focus-visible {
  outline: 2px solid;
  outline-offset: 2px;
}
.DateField .popup .calendar-grid td[data-today="true"] button {
  font-weight: var(--ui-font-weight-strong);
}
.DateField .popup .calendar-grid td[data-selected="true"] button {
  background-color: var(--ui-primary);
  color: var(--ui-primary-foreground);
}
.DateField .popup .calendar-grid td[data-disabled="true"] button {
  color: var(--_df-calendar-color-muted);
  cursor: not-allowed;
}
.DateField .popup .calendar-grid td[data-outside-month="true"] button {
  color: var(--_df-calendar-color-muted);
}

.DateField .popup .calendar-footer {
  display: flex;
  justify-content: space-between;
  padding: 0.5rem;
  border-top: 1px solid var(--_df-calendar-border-color);
}
.DateField .popup .calendar-footer button {
  background: none;
  border: none;
  cursor: pointer;
  color: var(--_df-calendar-link-color);
  font: inherit;
  padding: 0.25rem 0.5rem;
  border-radius: 2px;
}
.DateField .popup .calendar-footer button:focus-visible {
  outline: 2px solid;
  outline-offset: 2px;
}
.DateField .popup .calendar-footer button:disabled {
  color: var(--_df-calendar-color-muted);
  cursor: not-allowed;
}

/* ── Panels (deterministic boolean switch) ─────────────────────────────── */
/* Exactly one [data-panel] sibling carries data-active="true"; header + footer
   are always-visible chrome. */
.DateField .popup [data-panel][data-active="false"] {
  display: none;
}
.DateField .popup [data-panel="calendar"][data-active="true"] {
  display: block;
}
/* Month/year picker — two wheels (look from shared Wheel.css) */
.DateField .popup [data-panel="picker"][data-active="true"] {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  overflow: hidden;
  height: 16rem;
}
/* Wider hosts than the time digits so locale month names fit */
.DateField .popup .year-month-picker .Wheel[data-picker="month"] { width: 8rem; }
.DateField .popup .year-month-picker .Wheel[data-picker="year"] { width: 5rem; }

/* Month/year picker trigger — padded + hover to read as interactive.
   The label stays default text colour; only the chevron is accent-coloured. */
.DateField .popup .month-year-trigger {
  padding-inline: 0.5rem;
  border-radius: 4px;
}
.DateField .popup .month-year-trigger:hover {
  background-color: var(--ui-hover);
}
.DateField .popup .month-year-trigger::after {
  content: '›';
  display: inline-block;
  margin-inline-start: 0.3rem;
  color: var(--ui-primary);
  transform: rotate(90deg);
}
.DateField .popup .month-year-trigger[aria-expanded="true"]::after {
  transform: rotate(-90deg);
}

/* ── Initialisation gate ───────────────────────────────────────────────── */
.DateField[data-initialized="true"] {
  overflow: visible;
}

/* ── Slide rail ────────────────────────────────────────────────────────── */
.DateField .rail {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translateX(-50%);
  width: min(100vw, var(--_df-rail-max-width));
  height: 0;
  pointer-events: none;
  z-index: 9999;
}

/* ── Calendar bubble positioning ───────────────────────────────────────── */
.DateField .popup {
  left: var(--_df-popup-offset, 50%);
  transform: translateX(-50%);
  inline-size: var(--_df-calendar-width);
  pointer-events: auto;
}
.DateField[data-direction="bottom"] .popup {
  top: var(--_df-calendar-gap);
}
.DateField[data-direction="top"] .popup {
  bottom: var(--_df-calendar-gap);
}

/* ── Arrow ─────────────────────────────────────────────────────────────── */
.DateField .arrow {
  position: absolute;
  width: var(--_df-arrow-size);
  height: var(--_df-arrow-size);
  background-color: var(--_df-calendar-bg);
  left: 50%;
}
.DateField[data-direction="top"] .arrow {
  bottom: calc(var(--_df-arrow-size) * -0.5);
  transform: translateX(calc(-50% + var(--_df-arrow-offset, 0px))) rotate(45deg);
  border-end-end-radius: var(--_df-arrow-corner-radius);
}
.DateField[data-direction="bottom"] .arrow {
  top: calc(var(--_df-arrow-size) * -0.5);
  transform: translateX(calc(-50% + var(--_df-arrow-offset, 0px))) rotate(45deg);
  border-start-start-radius: var(--_df-arrow-corner-radius);
}
</style>
