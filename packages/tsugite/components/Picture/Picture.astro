---
// Port of AiPoc TagHelpers/PictureTagHelper.cs
// The Umbraco IPublishedContent image prop becomes an ImageMetadata import.
import DevError from "../DevError/DevError.astro";
import type { ImageMetadata } from "astro";
import { PRESETS, buildFigureHtml } from "../../lib/media";

interface Props {
  image?: ImageMetadata | null;
  preset?: string;
  alt?: string;
  /** overrides preset default */
  loading?: string;
  class?: string;
}

const { image, preset = "", alt, loading, class: className } = Astro.props;

let mode: "render" | "error" = "render";
let errorMessage = "";
let html = "";

if (image == null) {
  mode = "error";
  errorMessage = "image is required";
} else if (!PRESETS[preset]) {
  mode = "error";
  errorMessage = `unknown preset "${preset}" — expected: ${Object.keys(PRESETS).join(" | ")}`;
} else {
  html = await buildFigureHtml({
    image,
    preset: PRESETS[preset],
    altText: alt ?? "",
    loading,
    extraClass: className,
  });
}
---

{mode === "render" ? <Fragment set:html={html} /> : <DevError name="app-picture" message={errorMessage} />}

<style is:global>
:where(.Media) {
    margin: 0; /* figure reset */
}

:where(.Media-picture) {
    display: block;

    & img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
}

/* StackedSources / HorizontalSources visibility is controlled
   by the consuming component (e.g. Teaser.css) via container queries.
   Neither class carries display rules here. */
</style>
