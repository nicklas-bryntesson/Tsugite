---
// Picture — a responsive image through the media pipeline, by preset. The recipe
// (image and preset validation) lives in lib/picture.ts; the pipeline is Astro's.
import "./Picture.css";
import DevError from "../DevError/DevError.astro";
import type { ImageMetadata } from "astro";
import { buildFigureHtml } from "../../lib/media";
import { resolvePicture } from "../../lib/picture";

interface Props {
  image?: ImageMetadata | null;
  preset?: string;
  alt?: string;
  /** overrides preset default */
  loading?: string;
  class?: string;
}

const { image, preset = "", alt, loading, class: className } = Astro.props;

const pic = resolvePicture({ hasImage: image != null, preset });
const html =
  pic.mode === "render"
    ? await buildFigureHtml({ image: image!, preset: pic.preset!, altText: alt ?? "", loading, extraClass: className })
    : "";
---

{pic.mode === "render" ? <Fragment set:html={html} /> : <DevError name="Picture" message={pic.errorMessage} />}

