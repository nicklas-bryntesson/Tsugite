---
// Heading — the LOUD voices (heading, display) of the typography family, plus
// body on heading elements. Element farms and voices come from the family
// contract; the door law (one component per voice × element × input) is
// enforced by tests/typographyFamily.test.ts, never re-declared here.
import DevError from "../DevError/DevError.astro";
import { FAMILY, VOICE_SIZES } from "../../lib/typographyFamily.ts";

const VALID_ELEMENTS_BY_VARIANT = FAMILY.Heading.voices;
const VALID_ELEMENTS = [...new Set(Object.values(VALID_ELEMENTS_BY_VARIANT).flat())];
const VALID_VARIANTS = Object.keys(VALID_ELEMENTS_BY_VARIANT);
const VALID_SIZES_BY_VARIANT = VOICE_SIZES;

const DEFAULT_SIZE_BY_VARIANT: Record<string, string> = {
  display: "2",
  body: "md",
};

const HEADING_ELEMENT_TO_SIZE: Record<string, string> = {
  h1: "1", h2: "2", h3: "3", h4: "4", h5: "5", h6: "6",
};

// TODO(decide): the first codebase had a colour axis (primary | dark | light) here.
// Removed: colour is not a value in this system (ADR-0006: voice × volume × four
// modes, all on the region, inherited). If a heading ever needs its own ink, it
// re-enters as a CHANNEL choice, text or textMuted, resolved through the voice.
const VALID_ALIGNS = ["left", "center", "right"];
const VALID_WRAPS = ["balance", "pretty", "stable", "nowrap"];

interface Props {
  text?: string;
  highlight?: string;
  href?: string;
  element?: string;
  size?: string;
  variant?: string;
  align?: string;
  wrap?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  text,
  highlight,
  href,
  element: elementProp = "h2",
  size: sizeProp,
  variant: variantProp,
  align = "left",
  wrap = "balance",
  class: className,
  ...rest
} = Astro.props;

// TODO(decide): a local copy; Teaser imports escapeHtml from lib/buttonShared.
// One shared helper, or one per component?
const escapeHtml = (s: string) =>
  s
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");

const escapeRegex = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

function applyHighlight(t: string, h: string): string {
  const words = h.split(",").map((w) => w.trim()).filter(Boolean);
  if (words.length === 0) return escapeHtml(t);

  const pattern = words
    .sort((a, b) => b.length - a.length)
    .map(escapeRegex)
    .join("|");

  const regex = new RegExp(`(${pattern})`, "i");
  const parts = t.split(new RegExp(`(${pattern})`, "gi"));

  return parts
    .map((part) => (regex.test(part) ? `<mark>${escapeHtml(part)}</mark>` : escapeHtml(part)))
    .join("");
}

const childHtml = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
const hasChildContent = childHtml.trim().length > 0;
const hasText = !!text;
const hasHref = !!href;

let mode: "render" | "suppress" | "error" = "render";
let errorMessage = "";

if (!hasText && !hasChildContent) {
  mode = "suppress";
} else if ((hasText && hasChildContent) || (hasHref && hasChildContent) || (hasHref && !hasText)) {
  mode = "error";
  errorMessage = "invalid combination of text, href, and child content";
}

const element = VALID_ELEMENTS.includes(elementProp.toLowerCase())
  ? elementProp.toLowerCase()
  : "h2";
const variant = VALID_VARIANTS.includes((variantProp ?? "").toLowerCase())
  ? variantProp!.toLowerCase()
  : "heading";

if (mode === "render" && !VALID_ELEMENTS_BY_VARIANT[variant].includes(element)) {
  mode = "error";
  errorMessage = `variant "${variant}" does not allow element "${element}"`;
}

function resolveSize(): string | undefined {
  if (sizeProp && VALID_SIZES_BY_VARIANT[variant]?.includes(sizeProp.toLowerCase()))
    return sizeProp.toLowerCase();
  if (DEFAULT_SIZE_BY_VARIANT[variant]) return DEFAULT_SIZE_BY_VARIANT[variant];
  if (variant === "heading") return HEADING_ELEMENT_TO_SIZE[element] ?? "2";
  return undefined;
}

const resolvedSize = resolveSize();

// TODO(decide): an invalid align or wrap drops the attribute silently; Card raises a
// dev error for an invalid padding. Two policies for invalid input.
const alignAttr = VALID_ALIGNS.includes(align.toLowerCase()) ? align.toLowerCase() : undefined;
const wrapAttr = VALID_WRAPS.includes(wrap.toLowerCase()) ? wrap.toLowerCase() : undefined;

const cssClass = className && String(className).trim() ? `Heading ${className}` : "Heading";

let inner = "";
if (mode === "render") {
  if (hasChildContent) {
    // ADR-0012 §1: child content passes through the same engine container as
    // prop text; no path bypasses size, leading or trim.
    inner = `<span class="heading-text">${childHtml}</span>`;
  } else {
    const encoded = highlight ? applyHighlight(text!, highlight) : escapeHtml(text!);
    inner = hasHref
      ? `<a href="${escapeHtml(href!)}" class="heading-link">${encoded}</a>`
      : `<span class="heading-text">${encoded}</span>`;
  }
}

// ADR-0012 §3: a span is an inline run; every other element is a block run.
const runMode = element === "span" ? "inline" : "block";

const Tag = element as "h2";
---

{
  mode === "render" ? (
    <Tag
      class={cssClass}
      data-variant={variant}
      data-size={resolvedSize}
      data-run={runMode}
      data-align={alignAttr}
      data-wrap={wrapAttr}
      {...rest}
      set:html={inner}
    />
  ) : mode === "error" ? (
    <DevError name="Heading" message={errorMessage} />
  ) : null
}

<style is:global>
/*
 * Heading — the loud voices of the typography family.
 *
 * The root carries the voice (data-variant) and size (data-size); the inner
 * container (.heading-text or .heading-link) receives the resolved font-size,
 * line-height and the cap-to-baseline trim. The engine below is shared word for
 * word with Text and TextBlock (ADR-0012); a change here is a change in three
 * files.
 *
 * Gates:
 *   data-variant   heading | display | body, the voice bundle.
 *   data-size      per voice: 1–6, 1–3, sm | md | lg.
 *   data-run       block | inline, derived from the element (ADR-0012 §3).
 *   data-align     left | center | right.
 *   data-wrap      balance | pretty | stable | nowrap.
 */

/* TODO(decide): the part classes (.heading-text, .heading-link) follow the family's
   prefixed-lowercase scheme; Notice and Card use bare part names (.icon, .content).
   Two schemes for inner parts. Family-wide, decide once. */
/* TODO(decide): the engine slots (--_fontSize, --_lineHeight, --_emBox, ...) are shared
   by Heading, Text and TextBlock. ADR-0013 left the family prefix open. */
.Heading {
  /* TODO(dead): word-wrap is the legacy alias of overflow-wrap; both are declared.
     Same in Text and TextBlock, remove family-wide. */
  word-wrap: break-word;
  overflow-wrap: break-word;
  margin-block: 0;

  & .heading-link,
  & .heading-text {
    font-size: var(--_fontSize);
    line-height: var(--_lineHeight);

    /* ADR-0012 §4, voice sovereignty: an unvoiced inline element inherits the
       run's metrics. In the loud voices that includes strong and em; partial
       bolding of a heading is drift, deliberately flattened. A voiced child
       (data-variant) and everything inside it owns its own bundle. */
    & :where(a, span, strong, em, b, i):where(:not([data-variant], [data-variant] *)) {
      font: inherit;
      line-height: inherit;
      letter-spacing: inherit;
    }
  }

  /* ADR-0012 §3: block runs own their display; inline runs keep the UA's inline
     flow, and receive nothing here. */
  &[data-run="block"] > .heading-link,
  &[data-run="block"] > .heading-text {
    display: block;
  }

  &[data-variant="heading"] {
    --_lineHeight: var(--lineHeight-heading);
    --_baselineOffset: var(--baseline-offset-heading);
    --_emBox: var(--fontEmBox-heading);
    --_capGap: var(--fontCapGap-heading);
    --_descent: var(--fontDescent-heading);

    font-family: var(--fontFamily-heading);
    font-weight: var(--fontWeight-heading);
    letter-spacing: var(--letterSpacing-heading);
    font-feature-settings: var(--fontFeatureSettings-heading);

    &[data-size="1"] {
      --_fontSize: var(--fontSize-h1);
    }

    &[data-size="2"] {
      --_fontSize: var(--fontSize-h2);
    }

    &[data-size="3"] {
      --_fontSize: var(--fontSize-h3);
    }

    &[data-size="4"] {
      --_fontSize: var(--fontSize-h4);
    }

    &[data-size="5"] {
      --_fontSize: var(--fontSize-h5);
    }

    &[data-size="6"] {
      --_fontSize: var(--fontSize-h6);
    }
  }

  &[data-variant="display"] {
    --_lineHeight: var(--lineHeight-display);
    --_baselineOffset: var(--baseline-offset-display);
    --_emBox: var(--fontEmBox-display);
    --_capGap: var(--fontCapGap-display);
    --_descent: var(--fontDescent-display);

    font-family: var(--fontFamily-display);
    font-weight: var(--fontWeight-display);
    letter-spacing: var(--letterSpacing-display);
    font-feature-settings: var(--fontFeatureSettings-display);

    &[data-size="1"] {
      --_fontSize: var(--fontSize-display-1);
    }

    &[data-size="2"] {
      --_fontSize: var(--fontSize-display-2);
    }

    &[data-size="3"] {
      --_fontSize: var(--fontSize-display-3);
    }
  }

  &[data-variant="body"] {
    --_lineHeight: var(--lineHeight-body);
    --_baselineOffset: var(--baseline-offset-body);
    --_emBox: var(--fontEmBox-body);
    --_capGap: var(--fontCapGap-body);
    --_descent: var(--fontDescent-body);

    font-family: var(--fontFamily-body);
    font-weight: var(--fontWeight-body);
    letter-spacing: var(--letterSpacing-body);
    font-feature-settings: var(--fontFeatureSettings-body);

    &[data-size="sm"] {
      --_fontSize: var(--fontSize-body-small);
    }

    &[data-size="md"] {
      --_fontSize: var(--fontSize-body);
    }

    &[data-size="lg"] {
      --_fontSize: var(--fontSize-body-large);
    }
  }

  &[data-align="left"] {
    text-align: left;
  }

  &[data-align="center"] {
    text-align: center;
  }

  &[data-align="right"] {
    text-align: right;
  }

  &[data-wrap="balance"] {
    text-wrap: balance;
  }

  &[data-wrap="pretty"] {
    text-wrap: pretty;
  }

  &[data-wrap="stable"] {
    text-wrap: stable;
  }

  &[data-wrap="nowrap"] {
    text-wrap: nowrap;
  }

  /* Text trim (ADR-0012 §3): a block concept, so both branches sit behind the
     data-run gate and an inline run receives neither. Isolated, removable in
     one sweep. */
  @supports (text-box-trim: trim-both) and (text-box-edge: cap alphabetic) {
    &[data-run="block"] > .heading-link,
    &[data-run="block"] > .heading-text {
      text-box-trim: trim-both;
      text-box-edge: cap alphabetic;
      margin-block: 0;
    }
  }

  @supports not ((text-box-trim: trim-both) and (text-box-edge: cap alphabetic)) {
    &[data-run="block"] > .heading-link,
    &[data-run="block"] > .heading-text {
      /* Emulates text-box-edge: cap alphabetic. The line box's content area is
         the real em box (ascent + descent, 1.19 to 1.36em for our faces, never
         1), so the shave is half of (emBox - lineHeight) plus the cap gap above
         and the descent below. baselineOffset is the artistic nudge on top. */
      /* TODO(dead): the `, 1` and `, 0` fallbacks can never fire, every variant sets
         the slots. Doctrine §2 forbids them. Same in Text and TextBlock. */
      --_marginBlockStart: calc(((var(--_emBox, 1) - var(--_lineHeight)) / 2 - var(--_capGap, 0) + var(--_baselineOffset, 0)) * var(--_fontSize));
      --_marginBlockEnd: calc(((var(--_emBox, 1) - var(--_lineHeight)) / 2 - var(--_descent, 0) - var(--_baselineOffset, 0)) * var(--_fontSize));

      margin-block-start: var(--_marginBlockStart);
      margin-block-end: var(--_marginBlockEnd);
    }
  }
}
</style>
