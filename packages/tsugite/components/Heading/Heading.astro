---
// Heading — the LOUD voices (heading, display) of the typography family, plus body
// on heading elements. The recipe lives in lib/typography.ts and is shared by Text,
// TextBlock and every renderer; this file renders it in Astro. The door law (one
// component per voice × element × input) is enforced by tests/typographyFamily.test.ts.
import "./Heading.css";
import DevError from "../DevError/DevError.astro";
import { resolveTypography } from "../../lib/typography";

// TODO(decide): the first codebase had a colour axis (primary | dark | light) here.
// Removed: colour is not a value in this system (ADR-0006: voice × volume × four
// modes, all on the region, inherited). If a heading ever needs its own ink, it
// re-enters as a CHANNEL choice, text or textMuted, resolved through the voice.
interface Props {
  text?: string;
  /** comma-separated words to wrap in <mark> */
  highlight?: string;
  /** the run becomes a link */
  href?: string;
  element?: string;
  size?: string;
  variant?: string;
  align?: string;
  wrap?: string;
  class?: string;
  [key: string]: unknown;
}

const { text, highlight, href, element, size, variant, align, wrap, class: className, ...rest } = Astro.props;

const childHtml = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
const hasChildContent = childHtml.trim().length > 0;

const t = resolveTypography("Heading", { text, highlight, href, element, size, variant, align, wrap, class: className, hasChildContent });

// ADR-0012 §1: child content passes through the same engine container as prop text.
const inner =
  t.mode === "render"
    ? t.container.tag === "a"
      ? `<a href="${t.container.href!.replace(/&/g, "&amp;").replace(/"/g, "&quot;")}" class="${t.container.className}">${t.innerHtml}</a>`
      : `<span class="${t.container.className}">${hasChildContent ? childHtml : t.innerHtml}</span>`
    : "";

const Tag = t.tag as "h2";
---

{
  t.mode === "render" ? (
    <Tag class={t.className} {...t.attrs} {...rest} set:html={inner} />
  ) : t.mode === "error" ? (
    <DevError name="Heading" message={t.errorMessage} />
  ) : null
}
