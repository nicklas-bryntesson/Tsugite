---
// Button's bench (ADR-0026): every cell of both state maps — rest, each state, each pair
// that can meet, each triple — for every content, one button per line. A link has no
// disabled, so the two front doors draw their own maps. Each case is named on the
// element by data-bench-case="<door>/<content>/<states>" for the suite to address.
import ActionButton from "./ActionButton.astro";
import LinkButton from "./LinkButton.astro";
import { actionStates, linkStates } from "../../../../fixtures/states/button.states";
import { excludedBy, propsFor, type StateMap } from "../../../../fixtures/states/types";

const cellsOf = (map: StateMap) => [
  [],
  ...map.states.map((s) => [s.key]),
  ...Object.entries(map.pairs)
    .filter(([, pair]) => pair.reach !== "no")
    .map(([key]) => key.split("+")),
  ...map.triples.map((t) => [...t.keys]),
];

const cases = [
  { door: "action", map: actionStates, Door: ActionButton },
  { door: "link", map: linkStates, Door: LinkButton },
].flatMap(({ door, map, Door }) =>
  map.contents.flatMap((content) =>
    cellsOf(map)
      .filter((keys) => excludedBy(content, keys) === null)
      .map((keys) => {
        const name = `${door}/${content.key}/${keys.length ? keys.join("+") : map.rest.key}`;
        const { element, label, ...props } = propsFor(map, keys, content);
        return { name, Door, label, props: element === "a" ? { href: "#", ...props } : props };
      }),
  ),
);
---

{/* The icons the bench's buttons draw; a page that mounts Button provides its own. */}
<svg xmlns="http://www.w3.org/2000/svg" style="display: none;">
  <symbol id="icon-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></symbol>
</svg>

{
  cases.map(({ name, Door, label, props }) => (
    <Door {...props} data-bench-case={name} aria-label={label ? undefined : name}>
      {label}
    </Door>
  ))
}
