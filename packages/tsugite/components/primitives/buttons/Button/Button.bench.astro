---
// Button's bench (ADR-0026), in three families (fixtures/states/button.matrix.ts): every
// colour — emphasis × intent × state cell × content × door — at the default geometry;
// every geometry at rest; and a pairwise cover of the full product, which the suite holds
// to the other two. One button per line, named by data-bench-case.
import ActionButton from "./ActionButton.astro";
import LinkButton from "./LinkButton.astro";
import { buttonCases } from "../../../../fixtures/states/button.matrix";

interface Props {
  /** The icons the cases draw. On by default, as the bench app has none; a page that
   *  already carries them (the docs app's sprite) turns it off, or the ids repeat. */
  sprite?: boolean;
}

const { sprite = true } = Astro.props;

const doors = { action: ActionButton, link: LinkButton };
---

{
  sprite && (
    <svg xmlns="http://www.w3.org/2000/svg" style="display: none;">
      <symbol id="icon-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></symbol>
    </svg>
  )
}

{
  buttonCases.map(({ name, door, label, props }) => {
    const Door = doors[door];
    return (
      <Door {...props} data-bench-case={name} aria-label={label ? undefined : name}>
        {label}
      </Door>
    );
  })
}
