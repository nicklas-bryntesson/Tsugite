---
// LinkButton — the front door to the Button table for a link: <a class="Button">,
// intent-neutral. The table is recipes/button.recipe.ts, read by lib/recipe.ts
// (ADR-0018); ActionButton.astro and Button.tsx render the same table.
import "./Button.css";
import "../../ScreenReaderText/ScreenReaderText.css";
import DevError from "../../../DevError/DevError.astro";
import { button } from "../../../../recipes/button.recipe";
import { resolve, type InputOf } from "../../../../lib/recipe";
import { buttonDerive, buttonIconHtml, buttonTextHtml } from "../../../../lib/button";

// TODO(decide): kebab prop names ("icon-position") against camelCase (growInline). One
// convention for props; until then the front door translates.
type Props = Omit<InputOf<typeof button>, "element" | "type" | "disabled" | "intent" | "iconPosition"> & {
  "icon-position"?: InputOf<typeof button>["iconPosition"];
  [key: string]: unknown;
};

const { "icon-position": iconPosition, ...props } = Astro.props;

const childHtml = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
const b = resolve(button, { ...props, iconPosition, element: "a" }, { slots: { text: childHtml.trim().length > 0 }, derive: buttonDerive });

let inner = "";
if (b.parts.text) inner += buttonTextHtml(childHtml, b.parts.srText as string | null);
if (b.parts.icon) inner += buttonIconHtml(b.parts.icon as string);
---

{
  b.mode === "render" ? (
    <a class={b.className} {...b.attrs} {...b.rest} set:html={inner} />
  ) : b.mode === "error" ? (
    <DevError name="LinkButton" message={b.errorMessage} />
  ) : null
}
