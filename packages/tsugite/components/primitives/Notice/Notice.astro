---
// Notice — a message with a severity. The table is recipes/notice.recipe.ts, read by
// lib/recipe.ts (ADR-0018); this file renders it in Astro. It owns no live role, no
// lifetime and no destination: the host's region announces, the host places a dismiss
// control in the `dismiss` slot and owns what it does, and buttons go in `actions`.
import "./Notice.css";
import DevError from "../../DevError/DevError.astro";
import { notice } from "../../../recipes/notice.recipe";
import { resolve, type InputOf } from "../../../lib/recipe";
import { noticeDerive, NOTICE_ICONS } from "../../../lib/notice";

// TODO: do we need an id prop, yes we probably do don't we, and possibly som aria?
type Props = InputOf<typeof notice> & { [key: string]: unknown };

const bodyHtml = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
const n = resolve(notice, Astro.props, {
  slots: { body: bodyHtml.trim().length > 0, actions: Astro.slots.has("actions"), dismiss: Astro.slots.has("dismiss") },
  derive: noticeDerive,
});
const variant = n.attrs["data-variant"] as string;
const Tag = n.tag as "div";
---

{
  n.mode === "render" ? (
    <Tag class={n.className} {...n.attrs} {...n.rest}>
      {n.attrs["data-icon"] === "true" && (
        <div class="icon">
          <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={NOTICE_ICONS[variant]} />
        </div>
      )}
      <div class="content">
        {n.parts.title && <strong class="title">{n.parts.title}</strong>}
        <Fragment set:html={bodyHtml} />
        {n.parts.actions && (
          <div class="actions">
            <slot name="actions" />
          </div>
        )}
      </div>
      {n.parts.dismiss && (
        <div class="dismiss">
          <slot name="dismiss" />
        </div>
      )}
    </Tag>
  ) : (
    <DevError name={notice.name} message={n.errorMessage} />
  )
}
