---
// NavLink — the front door to the NavItem table for a link: <a class="NavItem">, takes the
// reader somewhere within the site. The table is recipes/navitem.recipe.ts, read by
// lib/recipe.ts (ADR-0018); NavButton.astro and NavItem.tsx render the same table.
import "./NavItem.css";
import DevError from "../../DevError/DevError.astro";
import { navitem } from "../../../recipes/navitem.recipe";
import { resolve, type InputOf } from "../../../lib/recipe";
import { navItemDerive, navItemIconHtml, navItemTextHtml } from "../../../lib/navitem";

// TODO(decide): kebab prop names ("icon-position") against camelCase; the front door translates.
type Props = Omit<InputOf<typeof navitem>, "element" | "type" | "aria-controls" | "expanded" | "iconPosition"> & {
  "icon-position"?: InputOf<typeof navitem>["iconPosition"];
  [key: string]: unknown;
};

const { "icon-position": iconPosition, ...props } = Astro.props;

const childHtml = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
const n = resolve(navitem, { ...props, iconPosition, element: "a" }, { slots: { text: childHtml.trim().length > 0 }, derive: navItemDerive });

let inner = "";
if (n.parts.text) inner += navItemTextHtml(childHtml);
if (n.parts.icon) inner += navItemIconHtml(n.parts.icon as string);
---

{
  n.mode === "render" ? (
    <a class={n.className} {...n.attrs} {...n.rest} set:html={inner} />
  ) : n.mode === "error" ? (
    <DevError name="NavLink" message={n.errorMessage} />
  ) : null
}
