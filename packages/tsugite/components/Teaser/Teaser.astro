---
// Teaser — transports the reader to one destination. Image, heading, excerpt and
// child content in a Card frame; the whole card is the link, or a button is. The
// recipe (frame, element, gates, content plan) lives in lib/teaser.ts.
import "./Teaser.css";
import Card from "../Card/Card.astro";
import Heading from "../Heading/Heading.astro";
import Prose from "../Prose/Prose.astro";
import LinkButton from "../Button/LinkButton.astro";
import DevError from "../DevError/DevError.astro";
import type { ImageMetadata } from "astro";
import { PRESETS, buildFigureHtml } from "../../lib/media";
import { escapeHtml } from "../../lib/html";
import { resolveTeaser } from "../../lib/teaser";

interface Props {
  image?: ImageMetadata | null;
  alt?: string;
  heading?: string;
  href?: string;
  excerpt?: string;
  /** true: a button carries the link and the heading is plain; false: the card is the link */
  button?: boolean;
  // TODO(decide): kebab prop names ("button-label", Button's "icon-position") against the
  // camelCase of growInline/capInline. One convention for props.
  "button-label"?: string;
  frame?: string;
  element?: string;
}

const {
  image = null,
  alt,
  heading,
  href,
  excerpt,
  button = false,
  "button-label": buttonLabel,
  frame,
  element,
} = Astro.props;

const childHtml = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
const hasChildContent = childHtml.trim().length > 0;
const hasMedia = image != null;

const t = resolveTeaser({ heading, href, excerpt, button, buttonLabel, frame, element, hasMedia, hasChildContent });

const figureHtml = hasMedia
  ? await buildFigureHtml({
      image: image!,
      preset: PRESETS["teaser"],
      altText: alt ?? "",
      figureClass: "MediaContainer",
      pictureClass: "Media",
    })
  : "";

const Tag = t.tag as "article";
const Frame = t.card ? Card : Fragment;
const frameProps = t.card ?? {};
---

{
  t.mode === "error" ? (
    <DevError name="Teaser" message={t.errorMessage} />
  ) : (
    <Frame {...frameProps}>
      <Tag class="Teaser" {...t.attrs}>
        <div class="LayoutContainer">
          {hasMedia && <Fragment set:html={figureHtml} />}
          {t.hasHeading && (
            <div class="HeadingContainer">
              {t.headingIsLink ? (
                <a class="Teaser-link" href={href}>
                  <Heading element="h2" size="4" text={heading} />
                </a>
              ) : (
                <Heading element="h2" size="4" text={heading} />
              )}
            </div>
          )}
          {t.hasBody && (
            <div class="ContentContainer">
              {t.hasExcerpt && <Prose variant="basic" size="sm" content={`<p>${escapeHtml(excerpt!)}</p>`} />}
              {hasChildContent && <Fragment set:html={childHtml} />}
              {t.button && (
                <div class="Actions">
                  <LinkButton href={href} size="sm" growInline={true}>
                    {t.buttonLabel}
                    {t.hasHeading && <span class="visually-hidden"> about {heading}</span>}
                  </LinkButton>
                </div>
              )}
            </div>
          )}
        </div>
      </Tag>
    </Frame>
  )
}

