---
// Notice — a presentational message with a severity. The recipe (attributes, icon)
// lives in lib/notice.ts and is shared by every renderer; this file renders it in Astro.
import "./Notice.css";
import DevError from "../DevError/DevError.astro";
import { resolveNotice } from "../../lib/notice";

// TODO: do we need an id prop, yes we probably do don't we, and possibly som aria?
interface Props {
  variant?: string;
  /** false drops the icon and collapses the grid to one column */
  icon?: boolean;
  /** full border in the accent colour */
  border?: boolean;
  /** a stronger visual weight, drawn in the accent colour */
  emphasis?: boolean;
  /** optional bold title above the body */
  title?: string;
  /** may the box take more inline space than its content? (ADR-0015) */
  growInline?: boolean;
  /** is there a reading ceiling on the inline size? (ADR-0015) */
  capInline?: boolean;
  class?: string;
  [key: string]: unknown;
}

const { variant, icon, border, emphasis, growInline, capInline, title, class: className, ...rest } = Astro.props;

const n = resolveNotice({ variant, icon, border, emphasis, growInline, capInline, class: className });
---

{
  n.mode === "render" ? (
    <div class={n.className} {...n.attrs} {...rest}>
      {n.icon && (
        <div class="icon">
          <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={n.iconPath} />
        </div>
      )}
      <div class="content">
        {title && <strong class="title">{title}</strong>}
        <slot />
      </div>
    </div>
  ) : (
    <DevError name="Notice" message={n.errorMessage} />
  )
}
