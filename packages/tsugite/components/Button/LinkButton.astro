---
// LinkButton — a Button that is a link: <a class="Button">, intent-neutral. The recipe
// lives in lib/button.ts and is shared with ActionButton and Button.tsx.
import "./Button.css";
import DevError from "../DevError/DevError.astro";
import { resolveButton, buttonIconHtml } from "../../lib/button";

interface Props {
  href?: string;
  target?: string;
  emphasis?: string;
  pill?: boolean;
  /** may the button take more inline space than its label? (ADR-0015) */
  growInline?: boolean;
  size?: string;
  icon?: string;
  "icon-position"?: string;
  "aria-label"?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  target,
  emphasis,
  pill,
  growInline,
  size,
  icon,
  "icon-position": iconPosition,
  "aria-label": ariaLabel,
  class: className,
  ...rest
} = Astro.props;

const childHtml = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
const hasText = childHtml.trim().length > 0;

const b = resolveButton({ kind: "link", href, target, emphasis, pill, growInline, size, icon, iconPosition, ariaLabel, class: className, hasText });

let inner = "";
if (hasText) inner += `<span class="Button-text">${childHtml}</span>`;
if (b.iconName) inner += buttonIconHtml(b.iconName);
---

{
  b.mode === "render" ? (
    <a class={b.className} {...b.attrs} {...rest} set:html={inner} />
  ) : b.mode === "error" ? (
    <DevError name="LinkButton" message={b.errorMessage} />
  ) : null
}
