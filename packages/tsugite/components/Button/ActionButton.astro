---
// ActionButton — a Button that acts: <button class="Button">, with intent. The recipe
// lives in lib/button.ts and is shared with LinkButton and Button.tsx.
import "./Button.css";
import DevError from "../DevError/DevError.astro";
import { resolveButton, buttonIconHtml } from "../../lib/button";

interface Props {
  "button-type"?: string;
  disabled?: boolean;
  emphasis?: string;
  intent?: string;
  pill?: boolean;
  /** may the button take more inline space than its label? (ADR-0015) */
  growInline?: boolean;
  size?: string;
  icon?: string;
  "icon-position"?: string;
  "aria-label"?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  "button-type": buttonType,
  disabled,
  emphasis,
  intent = "neutral",
  pill,
  growInline,
  size,
  icon,
  "icon-position": iconPosition,
  "aria-label": ariaLabel,
  class: className,
  ...rest
} = Astro.props;

const childHtml = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
const hasText = childHtml.trim().length > 0;

const b = resolveButton({ kind: "action", buttonType, disabled, emphasis, intent, pill, growInline, size, icon, iconPosition, ariaLabel, class: className, hasText });

let inner = "";
if (hasText) inner += `<span class="Button-text">${childHtml}</span>`;
if (b.iconName) inner += buttonIconHtml(b.iconName);
---

{
  b.mode === "render" ? (
    <button class={b.className} {...b.attrs} disabled={b.disabled} {...rest} set:html={inner} />
  ) : b.mode === "error" ? (
    <DevError name="ActionButton" message={b.errorMessage} />
  ) : null
}
