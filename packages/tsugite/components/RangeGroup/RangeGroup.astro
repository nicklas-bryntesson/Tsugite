---
// Port of reference-components RangeGroup — a dual-thumb range (lower/upper)
// composed from two RangeFields on one RangeScale lane inside a fieldset.
// This component IS the canonical() from RangeGroup.generate.ts; the verbatim
// RangeGroup.ts keeps --_rs-a/--_rs-b and the readouts live.
import "../RangeField/RangeField.css";
import "../RangeScale/RangeScale.css";

interface Props {
  id: string;
  rootId?: string;
  legend: string;
  lowerLabel: string;
  upperLabel: string;
  suffix?: string;
  min: number;
  max: number;
  step: number;
  lower: number;
  upper: number;
  /** attributes on the fieldset root (e.g. disabled) */
  group?: Record<string, string>;
  /** attributes on the inner .RangeScale */
  scale?: Record<string, string>;
  /** attributes on both fields (e.g. data-test-state, data-invalid) */
  field?: Record<string, string>;
}

const {
  id,
  rootId,
  legend,
  lowerLabel,
  upperLabel,
  suffix,
  min,
  max,
  step,
  lower,
  upper,
  group = {},
  scale = {},
  field = {},
} = Astro.props;

const idLower = `${id}-lower`;
const idUpper = `${id}-upper`;
const p = (v: number) => (max === min ? 0 : (v - min) / (max - min));

const { style: scaleStyle, ...scaleRest } = scale;
const style = [`--_rs-a: ${p(lower)}`, `--_rs-b: ${p(upper)}`, scaleStyle]
  .filter(Boolean)
  .join("; ");

const fieldAttrs = { min: String(min), max: String(max), step: String(step), ...field };
---

<fieldset class="RangeGroup" data-component="RangeGroup" data-id={rootId} {...group}>
  <legend>{legend}</legend>
  <div class="roles">
    <label for={idLower}
      >{lowerLabel}
      <b data-readout="lower" aria-hidden="true" data-suffix={suffix || undefined}
        ><span class="digits">{lower}</span>{suffix ? ` ${suffix}` : ""}</b
      ></label
    >
    <label for={idUpper}
      >{upperLabel}
      <b data-readout="upper" aria-hidden="true" data-suffix={suffix || undefined}
        ><span class="digits">{upper}</span>{suffix ? ` ${suffix}` : ""}</b
      ></label
    >
  </div>
  <div class="RangeScale" data-component="RangeScale" data-fields="2" {...scaleRest} style={style}>
    <span class="track"></span>
    <span class="fill"></span>
    <input
      class="RangeField"
      type="range"
      id={idLower}
      name={idLower}
      data-role="lower"
      value={String(lower)}
      {...fieldAttrs}
    />
    <input
      class="RangeField"
      type="range"
      id={idUpper}
      name={idUpper}
      data-role="upper"
      value={String(upper)}
      {...fieldAttrs}
    />
  </div>
</fieldset>

<script>
  import RangeGroup from "./RangeGroup";
  RangeGroup.attach();
</script>

<style is:global>
/* src/partials/components/RangeGroup/RangeGroup.css */
/*
 * RangeGroup — a <fieldset> holding two RangeFields on one shared RangeScale.
 *
 * Native <fieldset> gives the group its intrinsic name from <legend> and the
 * disabled cascade for free; native <input type="range"> gives each end its role,
 * its keyboard and its own entry in the form data (?lower=&upper=, which is what
 * a server wanted anyway). This file is layout: the legend, the two role labels
 * and their readouts. The lane draws, the class in RangeGroup.ts owns the rules
 * that are about the pair.
 *
 * There is no `data-clamp`. Hard stop is the only behaviour, because the other two
 * strategies are not styling choices: push silently moves a value the user did not
 * touch, and swap changes a control's identity mid-interaction while focus stays
 * put — which no ARIA mechanism can announce.
 *
 * Lengths are relative, like the rest of the family.
 *
 * One root, one tree (ADR-0010): the root carries tokens + root props; the
 * legend, the roles row and the disabled state are nested rules.
 */

.RangeGroup {
  /* ── Public API ──────────────────────────────────────────────────────── */
  --_rg-gap: 0.5em;                  /* legend → roles → lane */
  --_rg-role-size: 0.875em;
  --_rg-role-color: currentColor;
  --_rg-readout-color: currentColor;

  border: 0;
  padding: 0;
  margin: 0;
  min-inline-size: 0;                /* a fieldset will not shrink below its content otherwise */
  display: grid;
  row-gap: var(--_rg-gap);

  /* <legend> must be the first child of <fieldset> — a spec requirement, and the
     only INTRINSIC group name: no id plumbing, no document-outline dependency. */
  & > legend {
    padding: 0;
    font-size: var(--_rg-role-size);
    color: var(--_rg-role-color);
  }

  /* The two ends are named, because "lowest" and "highest" is what each control
     actually is — a span is not one value with two handles. */
  & .roles {
    display: flex;
    justify-content: space-between;
    gap: var(--_rg-gap);
    font-size: var(--_rg-role-size);
    color: var(--_rg-role-color);

    & label {
      display: flex;
      gap: 0.35em;
    }

    & [data-readout] {
      font-variant-numeric: tabular-nums;
      font-weight: var(--ui-font-weight-strong);
      color: var(--_rg-readout-color);
      /* A number plus a unit is its own bidi run; isolating it keeps it from
         reordering the text around it in a mixed-direction document. */
      unicode-bidi: isolate;

      /* Room for the widest NUMBER this group can show, so the component's width does
         not follow its content: a value crossing into another digit otherwise widened
         the whole group, and with it the lane, which made the thumb jump mid-drag.

         Digits only, and in `ch` — under tabular numerals that is exactly a digit's
         width. The unit sits outside this element and costs its natural width, because
         reserving the whole string over-reserved by a quarter. Set by RangeGroup.ts from
         min/max; override --_rg-readout-digits by hand for an unusual format. */
      & .digits {
        display: inline-block;
        min-inline-size: calc(var(--_rg-readout-digits, 0) * 1ch);
        text-align: end;
      }
    }

    /* The end labels mirror the lane's ends, so in RTL they swap with it. */
    & label:last-child {
      text-align: end;
    }
  }

  /* Native gives the disabled cascade; this only makes it visible, and matches the
     field's own treatment so the whole group dims as one thing. */
  &:disabled {
    opacity: 0.5;
  }
}
</style>
