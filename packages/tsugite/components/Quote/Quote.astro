---
// Quote — attributes words to a source. The table is recipes/quote.recipe.ts, read by
// lib/recipe.ts (ADR-0018); lib/quote.ts fills its holes; this file renders it in Astro.
// The portrait is a Picture; the echo behind it is the same image at 64px through the
// host's resolver, blurred by Quote.css.
import "./Quote.css";
import DevError from "../DevError/DevError.astro";
import Picture from "../Picture/Picture.astro";
import type { ImageMetadata } from "astro";
import { quote as recipe } from "../../recipes/quote.recipe";
import { resolve, type InputOf } from "../../lib/recipe";
import { quoteDefaults, quoteDerive, quotePlan } from "../../lib/quote";
import { astroImageResolver } from "../../lib/media.astro";

type Props = InputOf<typeof recipe> & {
  image?: ImageMetadata | null;
  alt?: string;
  [key: string]: unknown;
};

const { image = null, alt, ...props } = Astro.props;

const childHtml = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
const q = resolve(recipe, props, {
  slots: { children: childHtml.trim().length > 0, media: image != null },
  derive: quoteDerive,
  defaults: quoteDefaults,
});
const plan = quotePlan(q);
const Tag = q.tag as "figure";
const mediaWith = recipe.parts.media.with;
const echoSrc = image ? await astroImageResolver(image, 64, 64, "webp") : null;
---

{
  q.mode === "render" ? (
    <Tag class={q.className} {...q.attrs} {...q.rest}>
      <div class="body">
        <svg class="mark" aria-hidden="true" focusable="false"><use href="#icon-quote"></use></svg>
        {q.tag === "aside" ? (
          <p class="quote" id={plan.quoteId ?? undefined}>
            {q.parts.children ? <Fragment set:html={childHtml} /> : plan.words}
          </p>
        ) : (
          <blockquote class="quote">{q.parts.children ? <Fragment set:html={childHtml} /> : <p>{plan.words}</p>}</blockquote>
        )}
        {q.parts.media && (
          <div class="thumbnail">
            <Picture image={image} alt={alt ?? ""} {...mediaWith} />
            <img class="echo" src={echoSrc!} width="64" height="64" alt="" aria-hidden="true" loading="lazy" decoding="async" />
          </div>
        )}
        {q.parts.source && <figcaption class="source">{plan.source}</figcaption>}
      </div>
    </Tag>
  ) : q.mode === "error" ? (
    <DevError name={recipe.name} message={q.errorMessage} />
  ) : null
}
