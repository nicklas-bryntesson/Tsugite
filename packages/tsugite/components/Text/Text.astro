---
// Text — the QUIET voices (body, label) on plain text elements: authored single-run
// UI text, the family member next to Heading and Prose. The recipe lives in
// lib/typography.ts; this file renders it in Astro.
import "./Text.css";
import DevError from "../DevError/DevError.astro";
import { resolveTypography } from "../../lib/typography";

interface Props {
  text?: string;
  element?: string;
  variant?: string;
  size?: string;
  align?: string;
  wrap?: string;
  class?: string;
  [key: string]: unknown;
}

const { text, element, variant, size, align, wrap, class: className, ...rest } = Astro.props;

const childHtml = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
const hasChildContent = childHtml.trim().length > 0;

const t = resolveTypography("Text", { text, element, variant, size, align, wrap, class: className, hasChildContent });

// ADR-0012 §1: child content passes through the same engine container as prop text.
const inner = t.mode === "render" ? `<span class="${t.container.className}">${hasChildContent ? childHtml : t.innerHtml}</span>` : "";

const Tag = t.tag as "p";
---

{
  t.mode === "render" ? (
    <Tag class={t.className} {...t.attrs} {...rest} set:html={inner} />
  ) : t.mode === "error" ? (
    <DevError name="Text" message={t.errorMessage} />
  ) : null
}
