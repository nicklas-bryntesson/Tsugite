---
// NavButton — the front door to the NavItem table for a disclosure: <button class="NavItem">,
// opens the next level of the site. The table is recipes/navitem.recipe.ts, read by
// lib/recipe.ts (ADR-0018); NavLink.astro and NavItem.tsx render the same table. What the
// button does on press is the host's (or the kernel's); this renders the control.
import "./NavItem.css";
import DevError from "../DevError/DevError.astro";
import { navitem } from "../../recipes/navitem.recipe";
import { resolve, type InputOf } from "../../lib/recipe";
import { navItemDerive, navItemIconHtml, navItemTextHtml } from "../../lib/navitem";

type Props = Omit<InputOf<typeof navitem>, "element" | "href" | "target" | "type" | "iconPosition"> & {
  "icon-position"?: InputOf<typeof navitem>["iconPosition"];
  [key: string]: unknown;
};

const { "icon-position": iconPosition, ...props } = Astro.props;

const childHtml = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
const n = resolve(navitem, { ...props, iconPosition, element: "button" }, { slots: { text: childHtml.trim().length > 0 }, derive: navItemDerive });

let inner = "";
if (n.parts.text) inner += navItemTextHtml(childHtml);
if (n.parts.icon) inner += navItemIconHtml(n.parts.icon as string);
---

{
  n.mode === "render" ? (
    <button class={n.className} {...n.attrs} {...n.rest} set:html={inner} />
  ) : n.mode === "error" ? (
    <DevError name="NavButton" message={n.errorMessage} />
  ) : null
}
