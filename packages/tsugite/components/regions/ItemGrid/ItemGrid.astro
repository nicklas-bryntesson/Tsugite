---
// ItemGrid — equal items over as many columns as its width allows, and a last row that is
// decided (ADR-0028). The table is recipes/itemgrid.recipe.ts, read by lib/recipe.ts
// (ADR-0018); lib/itemgrid.ts holds the list role; this file renders it in Astro. The items
// stand in ItemGridItem cells, one per item.
import "./ItemGrid.css";
import DevError from "../../DevError/DevError.astro";
import { itemGrid } from "../../../recipes/itemgrid.recipe";
import { resolve, type InputOf } from "../../../lib/recipe";
import { itemGridDerive } from "../../../lib/itemgrid";

type Props = InputOf<typeof itemGrid> & { [key: string]: unknown };

const childHtml = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
const r = resolve(itemGrid, Astro.props, { hasContent: childHtml.trim().length > 0, derive: itemGridDerive });
const Tag = r.tag as "ul";
---

{
  r.mode === "render" ? (
    <Tag class={r.className} {...r.attrs} {...r.rest} set:html={childHtml} />
  ) : r.mode === "error" ? (
    <DevError name={itemGrid.name} message={r.errorMessage} />
  ) : null
}
