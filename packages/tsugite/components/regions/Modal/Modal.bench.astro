---
// Modal's bench (ADR-0026). Every modal is opened by a Button speaking the platform's
// invoker command (the kernel fills it in where the engine lacks it), named by a Heading on
// the title channel and closed by a Button on the close channel (ADR-0029 §5), which knows
// no id — the system's own components on both sides of the seam. The modal is a
// transparent layer; each child draws its own sheet (a Card on the page ground) and places
// itself.
//
// Contract cases:
// - one modal per dismiss value, data-bench-case="<dismiss>"; its close sits in a <form>,
//   beside a bare <button>, which is a submit button unless it says otherwise;
// - nested: a close three layers down, and a region inside the modal;
// - alert: role alertdialog, dismiss none, a description, and the child's own gate — the
//   close waits until the phrase is typed; the field takes focus with autofocus;
// - label: no visible title, named by the label prop (a video player);
// - lang: a Swedish title on an English page — the name keeps the title's lang.
//
// Use cases — the layer holding real shapes, each placing itself:
// - signup: the site's container and twelve-column layout grid inside the modal, the form
//   on the middle four columns from the desktop tier;
// - long: content taller than the viewport scrolls in the layer, the page stays put; the
//   title takes focus, so the layer opens at the top and not at the button at the end;
// - drawer: a sheet at the inline end, the full height of the layer;
// - banner: a consent banner at the block end that only its own choice closes.
import Modal from "./Modal.astro";
import ActionButton from "../../primitives/buttons/Button/ActionButton.astro";
import Card from "../../primitives/Card/Card.astro";
import Heading from "../../primitives/typography/Heading/Heading.astro";
import Text from "../../primitives/typography/Text/Text.astro";
import { modal } from "../../../recipes/modal.recipe";

const cases = modal.axes.dismiss.values;
const PHRASE = "I know what I am doing";
const paragraphs = Array.from({ length: 24 }, (_, i) => i + 1);
---

<Heading element="h2" text="Contract cases" />

{
  cases.map((dismiss) => (
    <div class="bench-line">
      <ActionButton emphasis="secondary" command="show-modal" commandfor={`modal-${dismiss}`} data-bench-opener={dismiss}>
        Open {dismiss}
      </ActionButton>
      <Modal id={`modal-${dismiss}`} dismiss={dismiss} data-bench-case={dismiss}>
        <Card elevation="md" class="bench-sheet bench-centre">
          <form>
            <Heading element="h2" text={`Dismiss: ${dismiss}`} data-channel="title" />
            <ActionButton data-channel="close" value={`closed-${dismiss}`}>Close</ActionButton>
            {/* a bare button in a form is a submit button: the channel must refuse the submit */}
            <button data-channel="close" value="bare" data-bench-close="bare">Close (bare button)</button>
          </form>
        </Card>
      </Modal>
    </div>
  ))
}

<div class="bench-line">
  <ActionButton emphasis="secondary" command="show-modal" commandfor="modal-nested" data-bench-opener="nested">
    Open nested
  </ActionButton>
  <Modal id="modal-nested" data-bench-case="nested">
    <Card elevation="md" class="bench-sheet bench-centre">
      <Heading element="h2" text="Nested" data-channel="title" />
      <div class="bench-grid">
        <div class="bench-card">
          <form>
            <Text text="A close three layers down." />
            <ActionButton data-channel="close" value="deep" data-bench-close="deep">Close modal</ActionButton>
          </form>
        </div>
        <div class="bench-card" data-region data-bench-inner-region>
          <Heading element="h3" text="Inner region" data-channel="title" data-bench-inner-title />
          <ActionButton emphasis="secondary" data-channel="close" value="inner" data-bench-close="inner">Close inner region</ActionButton>
        </div>
      </div>
    </Card>
  </Modal>
</div>

<div class="bench-line">
  <ActionButton emphasis="secondary" intent="destructive" command="show-modal" commandfor="modal-alert" data-bench-opener="alert">
    Open alert
  </ActionButton>
  <Modal id="modal-alert" role="alertdialog" dismiss="none" data-bench-case="alert">
    <Card elevation="md" class="bench-sheet bench-centre">
      <Heading element="h2" text="Delete everything?" data-channel="title" />
      <Text text={`Type “${PHRASE}” to unlock the button.`} data-channel="description" />
      <input type="text" aria-label="Confirmation phrase" autofocus data-bench-gate data-phrase={PHRASE} />
      <div class="bench-row">
        <ActionButton intent="destructive" data-channel="close" value="confirmed" disabled data-bench-close="confirm">Delete</ActionButton>
        <ActionButton emphasis="secondary" data-channel="close" value="cancelled" data-bench-close="cancel">Cancel</ActionButton>
      </div>
    </Card>
  </Modal>
</div>

<div class="bench-line">
  <ActionButton emphasis="secondary" command="show-modal" commandfor="modal-label" data-bench-opener="label">
    Open label
  </ActionButton>
  <Modal id="modal-label" label="Product video" data-bench-case="label">
    <Card elevation="md" class="bench-sheet bench-centre">
      <div class="bench-card bench-video">(a video player)</div>
      <ActionButton emphasis="secondary" data-channel="close" value="closed">Close</ActionButton>
    </Card>
  </Modal>
</div>

<div class="bench-line">
  <ActionButton emphasis="secondary" command="show-modal" commandfor="modal-lang" data-bench-opener="lang">
    Open lang
  </ActionButton>
  <Modal id="modal-lang" data-bench-case="lang">
    <Card elevation="md" class="bench-sheet bench-centre">
      <Heading element="h2" text="Välkommen tillbaka" lang="sv" data-channel="title" />
      <ActionButton emphasis="secondary" data-channel="close" value="closed">Close</ActionButton>
    </Card>
  </Modal>
</div>

<Heading element="h2" text="Use cases" />

<div class="bench-line">
  <ActionButton command="show-modal" commandfor="modal-signup" data-bench-opener="signup">Sign up</ActionButton>
  <Modal id="modal-signup" data-bench-case="signup">
    <div class="bench-container">
      <div class="bench-layout">
        <Card elevation="md" class="bench-sheet bench-middle-four" data-bench-signup-card>
          <form>
            <div class="bench-row bench-row-between">
              <Heading element="h2" text="Create an account" data-channel="title" />
              <ActionButton emphasis="secondary" data-channel="close" value="dismissed" aria-label="Close">×</ActionButton>
            </div>
            <Text text="One address, one password. Nothing else." data-channel="description" />
            <label class="bench-field">Email <input type="email" name="email" autocomplete="email" /></label>
            <label class="bench-field">Password <input type="password" name="password" autocomplete="new-password" /></label>
            <ActionButton data-channel="close" value="submitted">Create account</ActionButton>
          </form>
        </Card>
      </div>
    </div>
  </Modal>
</div>

<div class="bench-line">
  <ActionButton emphasis="secondary" command="show-modal" commandfor="modal-long" data-bench-opener="long">Read the terms</ActionButton>
  <Modal id="modal-long" dismiss="any" data-bench-case="long">
    <Card elevation="md" class="bench-sheet bench-centre bench-gap">
      {/* focus goes to the first focusable element on opening — here the button at the end,
           which would open the layer scrolled to the bottom; the child takes focus to its top */}
      <Heading element="h2" text="Terms" data-channel="title" tabindex="-1" autofocus data-bench-long-title />
      {paragraphs.map((n) => <Text text={`Paragraph ${n}. Long enough content to be taller than the viewport, so the layer scrolls and the page behind it does not.`} />)}
      <ActionButton data-channel="close" value="read" data-bench-close="long">Done</ActionButton>
    </Card>
  </Modal>
</div>

<div class="bench-line">
  <ActionButton emphasis="secondary" command="show-modal" commandfor="modal-drawer" data-bench-opener="drawer">Open drawer</ActionButton>
  <Modal id="modal-drawer" dismiss="any" data-bench-case="drawer">
    <Card elevation="lg" class="bench-sheet bench-drawer" data-bench-drawer>
      <div class="bench-row bench-row-between">
        <Heading element="h2" text="Filters" data-channel="title" />
        <ActionButton emphasis="secondary" data-channel="close" value="dismissed" aria-label="Close">×</ActionButton>
      </div>
      <Text text="A drawer is not a placement of the modal: it is a child that sits at the inline end and takes the full height." />
    </Card>
  </Modal>
</div>

<div class="bench-line">
  <ActionButton emphasis="secondary" command="show-modal" commandfor="modal-banner" data-bench-opener="banner">Show consent banner</ActionButton>
  <Modal id="modal-banner" dismiss="none" data-bench-case="banner">
    <Card elevation="lg" class="bench-sheet bench-banner" data-bench-banner>
      <Heading element="h2" text="Cookies" data-channel="title" />
      <Text text="Only a choice closes this banner. The consent decision itself is a kernel job of its own, not built here." data-channel="description" />
      <div class="bench-row">
        <ActionButton data-channel="close" value="accepted">Accept</ActionButton>
        <ActionButton emphasis="secondary" data-channel="close" value="rejected">Reject</ActionButton>
      </div>
    </Card>
  </Modal>
</div>

<div class="bench-tall" aria-hidden="true">Page content below, to show the page does not scroll behind an open modal.</div>

<script>
  // The inner region is a div: it has no close() and hears region:close instead.
  document.querySelector("[data-bench-inner-region]")?.addEventListener("region:close", (event) => {
    const region = event.currentTarget as HTMLElement;
    region.dataset.closedWith = (event as CustomEvent<{ returnValue: string }>).detail.returnValue;
  });

  // The alert's gate belongs to its content, not to the region (ADR-0029 §8).
  const gate = document.querySelector<HTMLInputElement>("[data-bench-gate]");
  const confirm = document.querySelector<HTMLButtonElement>('[data-bench-close="confirm"]');
  gate?.addEventListener("input", () => {
    if (confirm) confirm.disabled = gate.value !== gate.dataset.phrase;
  });
</script>

<style is:global>
  /* The sheet each child draws: the modal itself has no surface. */
  .bench-sheet {
    display: grid;
    gap: var(--size-md);
    padding: var(--size-lg);
    background-color: var(--color-surface-page);
  }

  .bench-centre {
    justify-self: center;
    inline-size: min(32rem, 100% - 2 * var(--size-md));
    margin-block: var(--size-xl);
  }

  .bench-gap {
    gap: var(--size-sm);
  }

  .bench-grid {
    display: grid;
    gap: var(--size-sm);
  }

  .bench-card {
    padding: var(--size-sm);
    border: 1px solid currentColor;
  }

  .bench-video {
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
  }

  .bench-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-sm);
    align-items: center;
  }

  .bench-row-between {
    flex-wrap: nowrap;
    justify-content: space-between;
  }

  .bench-sheet form {
    display: grid;
    gap: var(--size-md);
  }

  .bench-field {
    display: grid;
    gap: var(--size-xs);
  }

  /* The site's grids, inside the layer: the container centres the main column, the layout
     splits it into the tier's columns. */
  .bench-container {
    display: grid;
    grid-template-columns: var(--grid-container-columns);
  }

  .bench-layout {
    grid-column: main;
    display: grid;
    column-gap: var(--grid-layout-gap);
    grid-template-columns: var(--grid-layout-columns);
  }

  .bench-middle-four {
    grid-column: 1 / -1;
  }

  @media (min-width: 48.75rem) {
    .bench-middle-four {
      grid-column: 5 / span 4;
    }
  }

  .bench-drawer {
    justify-self: end;
    align-self: stretch;
    inline-size: min(24rem, 100%);
    align-content: start;
  }

  .bench-banner {
    align-self: end;
    margin: var(--size-md);
  }

  .bench-tall {
    block-size: 150vh;
    padding-block-start: var(--size-xl);
  }
</style>
