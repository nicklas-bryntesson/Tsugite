---
// Shared error rendering — mirrors the RenderError helpers in the AiPoc
// TagHelpers: visible red box in dev, suppressed output in prod.
interface Props {
  name: string;
  message: string;
}

const { name, message } = Astro.props;
const isDev = import.meta.env.DEV;
---

{
  isDev && (
    <div
      style="color:red; border: 2px solid red; padding: 0.5rem;"
      set:html={`<!-- ${name}: ${message} --><span>&times; ${name}: ${message}</span>`}
    />
  )
}
