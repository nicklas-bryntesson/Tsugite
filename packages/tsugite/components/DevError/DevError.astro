---
// Shared error rendering: a visible box in development, nothing in production. Its
// colours are the kernel's debug palette (kernel/css/debug.css), not brand tokens — a
// diagnosis looks the same on every brand. The React and Vue renderers mirror this box.
import "../../kernel/css/debug.css";

interface Props {
  name: string;
  message: string;
}

const { name, message } = Astro.props;
const isDev = import.meta.env.DEV;
---

{
  isDev && (
    <div
      style="color: var(--debug-ink); border: 2px solid var(--debug-ink); padding: 0.5rem;"
      set:html={`<!-- ${name}: ${message} --><span>&times; ${name}: ${message}</span>`}
    />
  )
}
