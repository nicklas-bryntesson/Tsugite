{
  "$comment": "TextBlock — the contract as data. `children` is the default slot's presence, reported by the renderer so the table can REFUSE it: a plain field carries no markup. `text` is the field's string; the CSS honours its line breaks. Attribute order: the axes in table order, the derived run last. TextBlock is always a block (ADR-0024 §5): the derived data-text-box is written as block, last.",
  "component": "TextBlock",
  "cases": [
    {
      "name": "default: p, preamble md, pretty, block",
      "input": {
        "text": "Standfirst",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "p",
        "className": "TextBlock",
        "attrs": {
          "data-voice": "preamble",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "preamble lg",
      "input": {
        "text": "T",
        "size": "lg",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "p",
        "className": "TextBlock",
        "attrs": {
          "data-voice": "preamble",
          "data-size": "lg",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "body voice, sm, on a div",
      "input": {
        "text": "T",
        "element": "div",
        "voice": "body",
        "size": "sm",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "div",
        "className": "TextBlock",
        "attrs": {
          "data-voice": "body",
          "data-size": "sm",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "align and wrap",
      "input": {
        "text": "T",
        "alignInline": "center",
        "wrap": "stable",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "p",
        "className": "TextBlock",
        "attrs": {
          "data-voice": "preamble",
          "data-size": "md",
          "data-align-inline": "center",
          "data-wrap": "stable",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "a span is not in the farm: falls back to p, a block",
      "input": {
        "text": "T",
        "element": "span",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "p",
        "className": "TextBlock",
        "attrs": {
          "data-voice": "preamble",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "extra class",
      "input": {
        "text": "T",
        "class": "extra",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "p",
        "className": "TextBlock extra",
        "attrs": {
          "data-voice": "preamble",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "no words: suppressed",
      "input": {
        "children": false
      },
      "expect": {
        "mode": "suppress"
      }
    },
    {
      "name": "child content is the one thing a field cannot be",
      "input": {
        "children": true
      },
      "expect": {
        "mode": "error",
        "errorMessage": "TextBlock takes plain text only (the textarea contract) — use the text prop, never child content"
      }
    },
    {
      "name": "child content beside text is refused too",
      "input": {
        "text": "T",
        "children": true
      },
      "expect": {
        "mode": "error",
        "errorMessage": "TextBlock takes plain text only (the textarea contract) — use the text prop, never child content"
      }
    },
    {
      "name": "a size outside the voice's set",
      "input": {
        "text": "T",
        "size": "xl",
        "children": false
      },
      "expect": {
        "mode": "error",
        "errorMessage": "invalid size \"xl\" for voice \"preamble\" — expected sm | md | lg"
      }
    },
    {
      "name": "an unknown voice",
      "input": {
        "text": "T",
        "voice": "label",
        "children": false
      },
      "expect": {
        "mode": "error",
        "errorMessage": "invalid voice \"label\" — expected preamble | body"
      }
    },
    {
      "name": "capInline false: the standfirst runs the width",
      "input": {
        "text": "A standfirst",
        "capInline": false,
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "p",
        "className": "TextBlock",
        "attrs": {
          "data-voice": "preamble",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "false",
          "data-text-box": "block"
        }
      }
    }
  ]
}
