{
  "$comment": "Text — the contract as data. `children` is the default slot's presence, reported by the renderer; `text` is a text part. One reading voice, body, on twelve elements, three sizes, md by default; the element never decides the size. The mode is intent (ADR-0024): `inline` puts the words in a line, the element follows (a span by default), the elements that cannot sit in a line are refused and the reading ceiling does not exist. The UI voices are Caption's. Attribute order: the axes in table order (inline is never written), the derived data-text-box last.",
  "component": "Text",
  "cases": [
    {
      "name": "default: p, body md, pretty, block",
      "input": {
        "text": "Hello",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "p",
        "className": "Text",
        "attrs": {
          "data-voice": "body",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "body sm",
      "input": {
        "text": "T",
        "size": "sm",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "p",
        "className": "Text",
        "attrs": {
          "data-voice": "body",
          "data-size": "sm",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "label is not a reading voice — that door is Caption",
      "input": {
        "text": "T",
        "voice": "label",
        "children": false
      },
      "expect": {
        "mode": "error",
        "errorMessage": "invalid voice \"label\" — expected body"
      }
    },
    {
      "name": "a span without inline is a block (ADR-0024)",
      "input": {
        "text": "T",
        "element": "span",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "span",
        "className": "Text",
        "attrs": {
          "data-voice": "body",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "a div is a block run",
      "input": {
        "text": "T",
        "element": "div",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "div",
        "className": "Text",
        "attrs": {
          "data-voice": "body",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "the element never decides the size",
      "input": {
        "text": "T",
        "element": "span",
        "size": "lg",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "span",
        "className": "Text",
        "attrs": {
          "data-voice": "body",
          "data-size": "lg",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "body voice on a legend",
      "input": {
        "text": "Contact details",
        "element": "legend",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "legend",
        "className": "Text",
        "attrs": {
          "data-voice": "body",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "body voice on a figcaption",
      "input": {
        "text": "A caption",
        "element": "figcaption",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "figcaption",
        "className": "Text",
        "attrs": {
          "data-voice": "body",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "body voice on a label element",
      "input": {
        "text": "Email",
        "element": "label",
        "size": "sm",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "label",
        "className": "Text",
        "attrs": {
          "data-voice": "body",
          "data-size": "sm",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "body voice on an h3 — a heading that reads like text (ADR-0023)",
      "input": {
        "text": "T",
        "element": "h3",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "h3",
        "className": "Text",
        "attrs": {
          "data-voice": "body",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "an h1 does not decide the size either",
      "input": {
        "text": "T",
        "element": "h1",
        "size": "sm",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "h1",
        "className": "Text",
        "attrs": {
          "data-voice": "body",
          "data-size": "sm",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "align and wrap",
      "input": {
        "text": "T",
        "alignInline": "center",
        "wrap": "balance",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "p",
        "className": "Text",
        "attrs": {
          "data-voice": "body",
          "data-size": "md",
          "data-align-inline": "center",
          "data-wrap": "balance",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "an invalid element falls back to p",
      "input": {
        "text": "T",
        "element": "section",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "p",
        "className": "Text",
        "attrs": {
          "data-voice": "body",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "extra class",
      "input": {
        "text": "T",
        "class": "extra",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "p",
        "className": "Text extra",
        "attrs": {
          "data-voice": "body",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "children pass through the engine container",
      "input": {
        "children": true
      },
      "expect": {
        "mode": "render",
        "tag": "p",
        "className": "Text",
        "attrs": {
          "data-voice": "body",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "no words: suppressed",
      "input": {
        "children": false
      },
      "expect": {
        "mode": "suppress"
      }
    },
    {
      "name": "text and children together",
      "input": {
        "text": "X",
        "children": true
      },
      "expect": {
        "mode": "error",
        "errorMessage": "use text OR child content, not both"
      }
    },
    {
      "name": "a size outside the voice's set",
      "input": {
        "text": "T",
        "size": "1",
        "children": false
      },
      "expect": {
        "mode": "error",
        "errorMessage": "invalid size \"1\" for voice \"body\" — expected sm | md | lg"
      }
    },
    {
      "name": "an unknown voice",
      "input": {
        "text": "T",
        "voice": "heading",
        "children": false
      },
      "expect": {
        "mode": "error",
        "errorMessage": "invalid voice \"heading\" — expected body"
      }
    },
    {
      "name": "an invalid wrap is refused, not dropped",
      "input": {
        "text": "T",
        "wrap": "loose",
        "children": false
      },
      "expect": {
        "mode": "error",
        "errorMessage": "invalid wrap \"loose\" — expected balance | pretty | stable | nowrap"
      }
    },
    {
      "name": "capInline false on a paragraph",
      "input": {
        "text": "Runs the width",
        "capInline": false,
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "p",
        "className": "Text",
        "attrs": {
          "data-voice": "body",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "false",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "a span block run carries its reading ceiling",
      "input": {
        "element": "span",
        "text": "inline",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "span",
        "className": "Text",
        "attrs": {
          "data-voice": "body",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "inline: a span by default, no box, no ceiling",
      "input": {
        "text": "T",
        "inline": true,
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "span",
        "className": "Text",
        "attrs": {
          "data-voice": "body",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-text-box": "inline"
        }
      }
    },
    {
      "name": "inline on a label",
      "input": {
        "text": "T",
        "inline": true,
        "element": "label",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "label",
        "className": "Text",
        "attrs": {
          "data-voice": "body",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-text-box": "inline"
        }
      }
    },
    {
      "name": "inline as a string, the way a CMS sends it",
      "input": {
        "text": "T",
        "inline": "true",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "span",
        "className": "Text",
        "attrs": {
          "data-voice": "body",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-text-box": "inline"
        }
      }
    },
    {
      "name": "inline false is a block p",
      "input": {
        "text": "T",
        "inline": false,
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "p",
        "className": "Text",
        "attrs": {
          "data-voice": "body",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "an inline p is refused",
      "input": {
        "text": "T",
        "inline": true,
        "element": "p",
        "children": false
      },
      "expect": {
        "mode": "error",
        "errorMessage": "an inline Text sits in a line, and p cannot — use span or label"
      }
    },
    {
      "name": "an inline h2 is refused",
      "input": {
        "text": "T",
        "inline": true,
        "element": "h2",
        "children": false
      },
      "expect": {
        "mode": "error",
        "errorMessage": "an inline Text sits in a line, and h2 cannot — use span or label"
      }
    },
    {
      "name": "an inline Text has no reading ceiling",
      "input": {
        "text": "T",
        "inline": true,
        "capInline": true,
        "children": false
      },
      "expect": {
        "mode": "error",
        "errorMessage": "capInline does not exist on a Text with inline true"
      }
    },
    {
      "name": "an invalid inline is refused",
      "input": {
        "text": "T",
        "inline": "yes",
        "children": false
      },
      "expect": {
        "mode": "error",
        "errorMessage": "invalid inline \"yes\" — expected true | false"
      }
    }
  ]
}
