{
  "$comment": "Text — the contract as data. `children` is the default slot's presence, reported by the renderer; `text` is a text part. One reading voice, body, on six elements — p, span, div, and the captions legend, figcaption, label — three sizes, md by default; the element never decides the size. The UI voices are Caption's. Attribute order: the axes in table order, the derived run last.",
  "component": "Text",
  "cases": [
    {
      "name": "default: p, body md, pretty, block run",
      "input": {
        "text": "Hello",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "p",
        "className": "Text",
        "attrs": {
          "data-variant": "body",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-run": "block"
        }
      }
    },
    {
      "name": "body sm",
      "input": {
        "text": "T",
        "size": "sm",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "p",
        "className": "Text",
        "attrs": {
          "data-variant": "body",
          "data-size": "sm",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-run": "block"
        }
      }
    },
    {
      "name": "label is not a reading voice — that door is Caption",
      "input": {
        "text": "T",
        "variant": "label",
        "children": false
      },
      "expect": {
        "mode": "error",
        "errorMessage": "invalid variant \"label\" — expected body"
      }
    },
    {
      "name": "a span is an inline run",
      "input": {
        "text": "T",
        "element": "span",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "span",
        "className": "Text",
        "attrs": {
          "data-variant": "body",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-run": "inline"
        }
      }
    },
    {
      "name": "a div is a block run",
      "input": {
        "text": "T",
        "element": "div",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "div",
        "className": "Text",
        "attrs": {
          "data-variant": "body",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-run": "block"
        }
      }
    },
    {
      "name": "the element never decides the size",
      "input": {
        "text": "T",
        "element": "span",
        "size": "lg",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "span",
        "className": "Text",
        "attrs": {
          "data-variant": "body",
          "data-size": "lg",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-run": "inline"
        }
      }
    },
    {
      "name": "body voice on a legend",
      "input": {
        "text": "Contact details",
        "element": "legend",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "legend",
        "className": "Text",
        "attrs": {
          "data-variant": "body",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-run": "block"
        }
      }
    },
    {
      "name": "body voice on a figcaption",
      "input": {
        "text": "A caption",
        "element": "figcaption",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "figcaption",
        "className": "Text",
        "attrs": {
          "data-variant": "body",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-run": "block"
        }
      }
    },
    {
      "name": "body voice on a label element",
      "input": {
        "text": "Email",
        "element": "label",
        "size": "sm",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "label",
        "className": "Text",
        "attrs": {
          "data-variant": "body",
          "data-size": "sm",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-run": "block"
        }
      }
    },
    {
      "name": "body voice on an h3 — a heading that reads like text (ADR-0023)",
      "input": {
        "text": "T",
        "element": "h3",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "h3",
        "className": "Text",
        "attrs": {
          "data-variant": "body",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-run": "block"
        }
      }
    },
    {
      "name": "an h1 does not decide the size either",
      "input": {
        "text": "T",
        "element": "h1",
        "size": "sm",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "h1",
        "className": "Text",
        "attrs": {
          "data-variant": "body",
          "data-size": "sm",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-run": "block"
        }
      }
    },
    {
      "name": "align and wrap",
      "input": {
        "text": "T",
        "alignInline": "center",
        "wrap": "balance",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "p",
        "className": "Text",
        "attrs": {
          "data-variant": "body",
          "data-size": "md",
          "data-align-inline": "center",
          "data-wrap": "balance",
          "data-cap-inline": "true",
          "data-run": "block"
        }
      }
    },
    {
      "name": "an invalid element falls back to p",
      "input": {
        "text": "T",
        "element": "section",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "p",
        "className": "Text",
        "attrs": {
          "data-variant": "body",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-run": "block"
        }
      }
    },
    {
      "name": "extra class",
      "input": {
        "text": "T",
        "class": "extra",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "p",
        "className": "Text extra",
        "attrs": {
          "data-variant": "body",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-run": "block"
        }
      }
    },
    {
      "name": "children pass through the engine container",
      "input": {
        "children": true
      },
      "expect": {
        "mode": "render",
        "tag": "p",
        "className": "Text",
        "attrs": {
          "data-variant": "body",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-run": "block"
        }
      }
    },
    {
      "name": "no words: suppressed",
      "input": {
        "children": false
      },
      "expect": {
        "mode": "suppress"
      }
    },
    {
      "name": "text and children together",
      "input": {
        "text": "X",
        "children": true
      },
      "expect": {
        "mode": "error",
        "errorMessage": "use text OR child content, not both"
      }
    },
    {
      "name": "a size outside the voice's set",
      "input": {
        "text": "T",
        "size": "1",
        "children": false
      },
      "expect": {
        "mode": "error",
        "errorMessage": "invalid size \"1\" for variant \"body\" — expected sm | md | lg"
      }
    },
    {
      "name": "an unknown voice",
      "input": {
        "text": "T",
        "variant": "heading",
        "children": false
      },
      "expect": {
        "mode": "error",
        "errorMessage": "invalid variant \"heading\" — expected body"
      }
    },
    {
      "name": "an invalid wrap is refused, not dropped",
      "input": {
        "text": "T",
        "wrap": "loose",
        "children": false
      },
      "expect": {
        "mode": "error",
        "errorMessage": "invalid wrap \"loose\" — expected balance | pretty | stable | nowrap"
      }
    },
    {
      "name": "capInline false on a paragraph",
      "input": {
        "text": "Runs the width",
        "capInline": false,
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "p",
        "className": "Text",
        "attrs": {
          "data-variant": "body",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "false",
          "data-run": "block"
        }
      }
    },
    {
      "name": "span: the gate is written, the inline run has no inline size to cap",
      "input": {
        "element": "span",
        "text": "inline",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "span",
        "className": "Text",
        "attrs": {
          "data-variant": "body",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-run": "inline"
        }
      }
    }
  ]
}
