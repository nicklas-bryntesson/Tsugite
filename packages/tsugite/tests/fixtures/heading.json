{
  "$comment": "Heading — the contract as data. `children` is the default slot's presence, reported by the renderer; text, href and highlight are text parts. The size set depends on the voice and the default size on the element (lib/heading.ts fills that hole). Attribute order: the axes in table order, the highlight style only when there are words to mark, the derived data-text-box last. The mode is intent (ADR-0024): `inline` puts the words in a line, the element follows (a span by default), the block-only elements are refused and the reading ceiling does not exist; inline is never written.",
  "component": "Heading",
  "cases": [
    {
      "name": "default: h2, heading 2, block",
      "input": {
        "text": "Hello",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "h2",
        "className": "Heading",
        "attrs": {
          "data-voice": "heading",
          "data-size": "2",
          "data-align-inline": "start",
          "data-wrap": "balance",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "h4 infers size 4",
      "input": {
        "text": "T",
        "element": "h4",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "h4",
        "className": "Heading",
        "attrs": {
          "data-voice": "heading",
          "data-size": "4",
          "data-align-inline": "start",
          "data-wrap": "balance",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "display defaults to size 2",
      "input": {
        "text": "T",
        "element": "h1",
        "voice": "display",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "h1",
        "className": "Heading",
        "attrs": {
          "data-voice": "display",
          "data-size": "2",
          "data-align-inline": "start",
          "data-wrap": "balance",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "display size 1",
      "input": {
        "text": "T",
        "element": "h1",
        "voice": "display",
        "size": "1",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "h1",
        "className": "Heading",
        "attrs": {
          "data-voice": "display",
          "data-size": "1",
          "data-align-inline": "start",
          "data-wrap": "balance",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "a span without inline is a block (ADR-0024)",
      "input": {
        "text": "T",
        "element": "span",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "span",
        "className": "Heading",
        "attrs": {
          "data-voice": "heading",
          "data-size": "2",
          "data-align-inline": "start",
          "data-wrap": "balance",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "link: the run becomes a link",
      "input": {
        "text": "Latest posts",
        "element": "h3",
        "href": "/blog",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "h3",
        "className": "Heading",
        "attrs": {
          "data-voice": "heading",
          "data-size": "3",
          "data-align-inline": "start",
          "data-wrap": "balance",
          "data-cap-inline": "true",
          "data-text-box": "block"
        },
        "parts": {
          "href": "/blog"
        }
      }
    },
    {
      "name": "highlight, marked by default",
      "input": {
        "text": "Build better with Tsugite",
        "highlight": "Tsugite",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "h2",
        "className": "Heading",
        "attrs": {
          "data-voice": "heading",
          "data-size": "2",
          "data-align-inline": "start",
          "data-wrap": "balance",
          "data-cap-inline": "true",
          "data-highlight-style": "mark",
          "data-text-box": "block"
        },
        "parts": {
          "highlight": "Tsugite"
        }
      }
    },
    {
      "name": "highlight, underlined",
      "input": {
        "text": "Build better with Tsugite",
        "highlight": "Tsugite",
        "highlightStyle": "underline",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "h2",
        "className": "Heading",
        "attrs": {
          "data-voice": "heading",
          "data-size": "2",
          "data-align-inline": "start",
          "data-wrap": "balance",
          "data-cap-inline": "true",
          "data-highlight-style": "underline",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "align and wrap",
      "input": {
        "text": "T",
        "alignInline": "center",
        "wrap": "pretty",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "h2",
        "className": "Heading",
        "attrs": {
          "data-voice": "heading",
          "data-size": "2",
          "data-align-inline": "center",
          "data-wrap": "pretty",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "an invalid element falls back to h2",
      "input": {
        "text": "T",
        "element": "table",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "h2",
        "className": "Heading",
        "attrs": {
          "data-voice": "heading",
          "data-size": "2",
          "data-align-inline": "start",
          "data-wrap": "balance",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "extra class",
      "input": {
        "text": "T",
        "class": "extra",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "h2",
        "className": "Heading extra",
        "attrs": {
          "data-voice": "heading",
          "data-size": "2",
          "data-align-inline": "start",
          "data-wrap": "balance",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "children pass through the engine container",
      "input": {
        "children": true
      },
      "expect": {
        "mode": "render",
        "tag": "h2",
        "className": "Heading",
        "attrs": {
          "data-voice": "heading",
          "data-size": "2",
          "data-align-inline": "start",
          "data-wrap": "balance",
          "data-cap-inline": "true",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "no words: suppressed",
      "input": {
        "children": false
      },
      "expect": {
        "mode": "suppress"
      }
    },
    {
      "name": "text and children together",
      "input": {
        "text": "X",
        "children": true
      },
      "expect": {
        "mode": "error",
        "errorMessage": "invalid combination of text, href, and child content"
      }
    },
    {
      "name": "href without text",
      "input": {
        "href": "/x",
        "children": true
      },
      "expect": {
        "mode": "error",
        "errorMessage": "invalid combination of text, href, and child content"
      }
    },
    {
      "name": "a size outside the voice's set",
      "input": {
        "text": "T",
        "size": "lg",
        "children": false
      },
      "expect": {
        "mode": "error",
        "errorMessage": "invalid size \"lg\" for voice \"heading\" — expected 1 | 2 | 3 | 4 | 5 | 6"
      }
    },
    {
      "name": "an invalid alignInline is refused, not dropped",
      "input": {
        "text": "T",
        "alignInline": "middle",
        "children": false
      },
      "expect": {
        "mode": "error",
        "errorMessage": "invalid alignInline \"middle\" — expected start | center | end"
      }
    },
    {
      "name": "a highlight style without words to mark",
      "input": {
        "text": "T",
        "highlightStyle": "underline",
        "children": false
      },
      "expect": {
        "mode": "error",
        "errorMessage": "highlightStyle does not exist on a Heading without highlight"
      }
    },
    {
      "name": "capInline false: the ceiling off, the run still block",
      "input": {
        "text": "A headline allowed to run the width",
        "capInline": false,
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "h2",
        "className": "Heading",
        "attrs": {
          "data-voice": "heading",
          "data-size": "2",
          "data-align-inline": "start",
          "data-wrap": "balance",
          "data-cap-inline": "false",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "inline: a span by default, no box, no ceiling",
      "input": {
        "text": "T",
        "inline": true,
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "span",
        "className": "Heading",
        "attrs": {
          "data-voice": "heading",
          "data-size": "2",
          "data-align-inline": "start",
          "data-wrap": "balance",
          "data-text-box": "inline"
        }
      }
    },
    {
      "name": "inline display, the size from the voice",
      "input": {
        "text": "T",
        "inline": true,
        "voice": "display",
        "size": "1",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "span",
        "className": "Heading",
        "attrs": {
          "data-voice": "display",
          "data-size": "1",
          "data-align-inline": "start",
          "data-wrap": "balance",
          "data-text-box": "inline"
        }
      }
    },
    {
      "name": "an inline h2 is refused",
      "input": {
        "text": "T",
        "inline": true,
        "element": "h2",
        "children": false
      },
      "expect": {
        "mode": "error",
        "errorMessage": "an inline Heading sits in a line, and h2 cannot — use span"
      }
    },
    {
      "name": "an inline Heading has no reading ceiling",
      "input": {
        "text": "T",
        "inline": true,
        "capInline": false,
        "children": false
      },
      "expect": {
        "mode": "error",
        "errorMessage": "capInline does not exist on a Heading with inline true"
      }
    }
  ]
}
