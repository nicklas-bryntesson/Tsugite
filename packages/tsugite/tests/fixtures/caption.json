{
  "$comment": "Caption — the contract as data. `children` is the default slot's presence, reported by the renderer; `text` is a text part. Three UI voices, label, button and nav, three sizes each, md by default; the element is any of the family's farm, span by default (an inline run), and never decides the size. Attribute order: the axes in table order, the derived run last. The mode is intent (ADR-0024): a Caption is a block, a p by default; `inline` puts it in a line, the element follows (a span by default, label allowed) and the block-only elements are refused; inline is never written; the derived data-text-box comes last.",
  "component": "Caption",
  "cases": [
    {
      "name": "default: a p in the label voice, md, block",
      "input": {
        "text": "Email",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "p",
        "className": "Caption",
        "attrs": {
          "data-voice": "label",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "a form label",
      "input": {
        "text": "Email",
        "element": "label",
        "size": "sm",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "label",
        "className": "Caption",
        "attrs": {
          "data-voice": "label",
          "data-size": "sm",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "a legend in the label voice — the wizard's inner group",
      "input": {
        "text": "Address",
        "element": "legend",
        "size": "lg",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "legend",
        "className": "Caption",
        "attrs": {
          "data-voice": "label",
          "data-size": "lg",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "a legend that is a heading semantically, label visually",
      "input": {
        "text": "Contact",
        "element": "h3",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "h3",
        "className": "Caption",
        "attrs": {
          "data-voice": "label",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "a figcaption",
      "input": {
        "text": "Figure 1",
        "element": "figcaption",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "figcaption",
        "className": "Caption",
        "attrs": {
          "data-voice": "label",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "the button voice, standalone",
      "input": {
        "text": "Save",
        "voice": "button",
        "size": "lg",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "p",
        "className": "Caption",
        "attrs": {
          "data-voice": "button",
          "data-size": "lg",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "the nav voice, standalone",
      "input": {
        "text": "Products",
        "voice": "nav",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "p",
        "className": "Caption",
        "attrs": {
          "data-voice": "nav",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "align and wrap",
      "input": {
        "text": "T",
        "element": "p",
        "alignInline": "center",
        "wrap": "nowrap",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "p",
        "className": "Caption",
        "attrs": {
          "data-voice": "label",
          "data-size": "md",
          "data-align-inline": "center",
          "data-wrap": "nowrap",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "an unknown element falls back to p",
      "input": {
        "text": "T",
        "element": "th",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "p",
        "className": "Caption",
        "attrs": {
          "data-voice": "label",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "extra class",
      "input": {
        "text": "T",
        "class": "extra",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "p",
        "className": "Caption extra",
        "attrs": {
          "data-voice": "label",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "children pass through the engine container",
      "input": {
        "element": "label",
        "children": true
      },
      "expect": {
        "mode": "render",
        "tag": "label",
        "className": "Caption",
        "attrs": {
          "data-voice": "label",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "no words: suppressed",
      "input": {
        "children": false
      },
      "expect": {
        "mode": "suppress"
      }
    },
    {
      "name": "text and children together",
      "input": {
        "text": "X",
        "children": true
      },
      "expect": {
        "mode": "error",
        "errorMessage": "use text OR child content, not both"
      }
    },
    {
      "name": "body is not a UI voice",
      "input": {
        "text": "T",
        "voice": "body",
        "children": false
      },
      "expect": {
        "mode": "error",
        "errorMessage": "invalid voice \"body\" — expected label | button | nav"
      }
    },
    {
      "name": "a size outside the voice's set",
      "input": {
        "text": "T",
        "size": "1",
        "children": false
      },
      "expect": {
        "mode": "error",
        "errorMessage": "invalid size \"1\" for voice \"label\" — expected sm | md | lg"
      }
    },
    {
      "name": "inline: a span in a line",
      "input": {
        "text": "Email",
        "inline": true,
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "span",
        "className": "Caption",
        "attrs": {
          "data-voice": "label",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-text-box": "inline"
        }
      }
    },
    {
      "name": "inline on a label",
      "input": {
        "text": "Email",
        "inline": true,
        "element": "label",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "label",
        "className": "Caption",
        "attrs": {
          "data-voice": "label",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-text-box": "inline"
        }
      }
    },
    {
      "name": "a span without inline is a block (ADR-0024)",
      "input": {
        "text": "T",
        "element": "span",
        "children": false
      },
      "expect": {
        "mode": "render",
        "tag": "span",
        "className": "Caption",
        "attrs": {
          "data-voice": "label",
          "data-size": "md",
          "data-align-inline": "start",
          "data-wrap": "pretty",
          "data-text-box": "block"
        }
      }
    },
    {
      "name": "an inline legend is refused",
      "input": {
        "text": "T",
        "inline": true,
        "element": "legend",
        "children": false
      },
      "expect": {
        "mode": "error",
        "errorMessage": "an inline Caption sits in a line, and legend cannot — use span or label"
      }
    }
  ]
}
