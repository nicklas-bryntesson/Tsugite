---
// Port of reference-components DateField.html — states mirror
// DateField.generate.ts StateDefinition[] one to one.
import Heading from "../components/Heading/Heading.astro";
import DateField from "../components/DateField/DateField.astro";
---

<section class="KitchenSink-section" id="DateField">
  <Heading text="DateField" element="h2" size="2" />

  {/* Interaction states */}
  <Heading text="Interaction states" element="h3" variant="body" size="lg" />
  <table class="state-table">
    <thead>
      <tr>
        <th scope="col">State</th>
        <th scope="col">default</th>
        <th scope="col">hover</th>
        <th scope="col">focus</th>
        <th scope="col">active</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <th scope="row">empty</th>
        <td><DateField id="state-empty-default" label="Date" /></td>
        <td><DateField id="state-empty-hover" label="Date" data-test-state="hover" /></td>
        <td><DateField id="state-empty-focus" label="Date" data-test-state="focus" /></td>
        <td><DateField id="state-empty-active" label="Date" data-test-state="active" /></td>
      </tr>
      <tr>
        <th scope="row">filled</th>
        <td><DateField id="state-filled-default" label="Date" value="1990-06-15" /></td>
        <td><DateField id="state-filled-hover" label="Date" value="1990-06-15" data-test-state="hover" /></td>
        <td><DateField id="state-filled-focus" label="Date" value="1990-06-15" data-test-state="focus" /></td>
        <td><DateField id="state-filled-active" label="Date" value="1990-06-15" data-test-state="active" /></td>
      </tr>
    </tbody>
  </table>

  {/* Disabled */}
  <Heading text="Disabled" element="h3" variant="body" size="lg" />
  <table class="state-table">
    <tbody>
      <tr>
        <th scope="row">empty</th>
        <td><DateField id="state-disabled-empty" label="Date" disabled={true} /></td>
      </tr>
      <tr>
        <th scope="row">filled</th>
        <td><DateField id="state-disabled-filled" label="Date" value="1990-06-15" disabled={true} /></td>
      </tr>
    </tbody>
  </table>

  {/* Invalid */}
  <Heading text="Invalid" element="h3" variant="body" size="lg" />
  <table class="state-table">
    <tbody>
      <tr>
        <th scope="row">required + empty</th>
        <td>
          <DateField
            id="state-invalid-empty"
            label="Date"
            labelSuffix={'<span aria-hidden="true">*</span>'}
            invalid={true}
            required={true}
          />
        </td>
      </tr>
      <tr>
        <th scope="row">out of range</th>
        <td><DateField id="state-invalid-filled" label="Date" value="1800-01-01" invalid={true} /></td>
      </tr>
    </tbody>
  </table>

  {/* Live demo */}
  <Heading text="Live demo" element="h3" variant="body" size="lg" />
  <div>
    <DateField id="birthdate" label="Date" />
  </div>

  {/* Localization: segment order + language */}
  <Heading text="Localization" element="h3" variant="body" size="lg" />
  <table class="state-table">
    <tbody>
      <tr>
        <th scope="row">en-GB</th>
        <td><DateField id="df-locale-en-gb" label="Date (en-GB — D/M/Y)" locale="en-GB" value="1990-06-15" /></td>
      </tr>
      <tr>
        <th scope="row">en-US</th>
        <td><DateField id="df-locale-en-us" label="Date (en-US — M/D/Y)" locale="en-US" value="1990-06-15" /></td>
      </tr>
      <tr>
        <th scope="row">sv-SE</th>
        <td><DateField id="df-locale-sv-se" label="Date (sv-SE — Y/M/D)" locale="sv-SE" value="1990-06-15" /></td>
      </tr>
    </tbody>
  </table>

  {/* Native reference */}
  <Heading text="Native reference" element="h3" variant="body" size="lg" />
  <table class="state-table">
    <tbody>
      <tr>
        <th scope="row">default</th>
        <td>
          <label for="state-native-default">Date</label>
          <input
            type="date"
            id="state-native-default"
            name="state-native-default"
            min="1900-01-01"
            max="2100-12-31"
          />
        </td>
      </tr>
    </tbody>
  </table>
</section>
