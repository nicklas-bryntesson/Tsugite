---
// Buttons — the bench: the button state map (fixtures/states/button.states.ts) for an action in
// the two emphases that paint differently, and the door to full coverage, where every
// emphasis, intent and content is drawn (ButtonCoverage.astro, /docs/button/coverage).
import LinkButton from "../components/primitives/buttons/Button/LinkButton.astro";
import Text from "../components/primitives/typography/Text/Text.astro";
import Caption from "../components/primitives/typography/Caption/Caption.astro";
import StateMatrix from "./states/StateMatrix.astro";
import ButtonCell from "./states/ButtonCell.astro";
import { actionStates } from "./states/button.states";

const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---

<section class="KitchenSink-section ButtonStates" id="ButtonStates">
  <Text text="The state map" element="h3" size="lg" />
  <Caption element="p" text="An action, neutral, in the two emphases that paint differently — primary fills, secondary outlines: one table per content — a label, a label and an icon, an icon alone — with sm, md and lg in every cell. Idle stands above the table; each state is alone on the diagonal and two states meet below it. What cannot happen is hatched with its reason; pairs not yet measured are marked." />
  <div class="coverage-door">
    <LinkButton href="/docs/button/coverage" emphasis="secondary">Full coverage: every emphasis, intent and content</LinkButton>
  </div>
  {(["primary", "secondary"] as const).map((emphasis) => (
    <>
      <Text text={capitalize(emphasis)} element="h4" size="lg" />
      <StateMatrix map={{ ...actionStates, base: { ...actionStates.base, emphasis } }} component={ButtonCell} name={`${capitalize(emphasis)} button`} />
    </>
  ))}
</section>
