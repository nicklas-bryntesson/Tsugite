---
// Port of AiPoc Views/Shared/Partials/KitchenSink/_CtaButton.cshtml
import Heading from "../components/Heading/Heading.astro";
import Prose from "../components/Prose/Prose.astro";
import CtaLinkButton from "../components/CtaLinkButton/CtaLinkButton.astro";

const STATES = ["hover", "active", "focus", "disabled"] as const;
---

{/* ═══════════════════════════════════════════
    CTA LINK BUTTON
    ═══════════════════════════════════════════ */}

<section class="component-map" style="--_colWidth: 14rem;">
  <header>
    <Heading element="h3" text="CTA Link Button" />
    <Prose variant="basic" size="sm"><p>variant: glow</p></Prose>
  </header>
  <table>
    <thead>
      <tr>
        <th></th>
        <th scope="col">Default</th>
        <th scope="col">Hover</th>
        <th scope="col">Active</th>
        <th scope="col">Focus</th>
        <th scope="col">Disabled</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <th scope="row">glow</th>
        <td><CtaLinkButton href="#">Get started</CtaLinkButton></td>
        {
          STATES.map((state) => (
            <td>
              <CtaLinkButton href="#" data-test-state={state}>Get started</CtaLinkButton>
            </td>
          ))
        }
      </tr>
    </tbody>
  </table>
</section>
