---
// Teaser — frame axis, media/no media, container-query switching, button
// axis, slot content, the invalid state. Split from Components.astro.
import Heading from "../components/Heading/Heading.astro";
import Text from "../components/Text/Text.astro";
import Teaser from "../components/Teaser/Teaser.astro";

import img1 from "./media/amal-s.jpg";
import img2 from "./media/david-becker.jpg";
import img3 from "./media/jean-philippe.jpg";

const frames = [
  { frame: "bordered", label: "bordered (default)" },
  { frame: "elevated", label: "elevated" },
  { frame: "bare", label: "bare" },
];
---

{/* ═══════════════════════════════════════════
    TEASER
    ═══════════════════════════════════════════ */}

<section class="KitchenSink-section">
  <Heading text="Teaser" element="h2" size="2" />
  <p>
    Composable content card. CQ-driven: flow-vertical below 25rem, flow-horizontal above. Card
    wraps the article — frame axis controls the Card variant.
  </p>

  {/* — Frame axis ——————————————————————————————— */}
  <Heading text="Frame axis" element="h3" variant="body" size="lg" />
  <div style="display:flex; gap:1.5rem; flex-wrap:wrap; align-items:flex-start;">
    {
      frames.map(({ frame, label }) => (
        <div style="width:22rem; display:flex; flex-direction:column; gap:0.5rem;">
          <Heading element="h4" variant="body" size="sm" text={label} />
          <Teaser
            frame={frame}
            image={img2}
            alt="Sample image"
            heading="Post title"
            href="#"
            excerpt="Short excerpt giving a taste of the content."
          >
            <time datetime="2025-01-15">15 January 2025</time>
          </Teaser>
        </div>
      ))
    }
  </div>

  {/* — Without image ————————————————————————————— */}
  <Heading text="Without image" element="h3" variant="body" size="lg" />
  <div style="width:22rem;">
    <Teaser
      heading="Text-only teaser"
      href="#"
      excerpt="No image prop passed — MediaContainer is not rendered."
    />
  </div>

  {/* — CQ switching —————————————————————————————— */}
  <Heading text="CQ switching — drag to resize" element="h3" variant="body" size="lg" />
  <Text variant="label" text="Below 25rem → flow-vertical. Above 25rem → flow-horizontal." />
  <div style="display:flex; flex-direction:column; gap:1rem;">
    <div>
      <Heading element="h4" variant="body" size="sm" text="stretched link" />
      <div
        style="resize:horizontal; overflow:auto; min-width:24rem; max-width:100%; border:1px dashed var(--color-border-default); padding:0.5rem;"
      >
        <Teaser
          image={img1}
          alt="Sample image"
          heading="Resize to see layout switch"
          href="#"
          excerpt="Drag the handle to cross the 25rem threshold."
        />
      </div>
    </div>
    <div>
      <Heading element="h4" variant="body" size="sm" text="button=true" />
      <div
        style="resize:horizontal; overflow:auto; min-width:24rem; max-width:100%; border:1px dashed var(--color-border-default); padding:0.5rem;"
      >
        <Teaser
          button={true}
          image={img2}
          alt="Sample image"
          heading="Button stays bottom-left at any width"
          href="#"
          excerpt="Drag the handle to cross the 25rem threshold."
        />
      </div>
    </div>
  </div>

  {/* — Button axis ———————————————————————————————— */}
  <Heading text="Button axis" element="h3" variant="body" size="lg" />
  <div style="display:flex; gap:1.5rem; flex-wrap:wrap; align-items:flex-start;">
    <div style="width:22rem; display:flex; flex-direction:column; gap:0.5rem;">
      <Heading element="h4" variant="body" size="sm" text="button=false — stretched link (default)" />
      <Teaser
        image={img3}
        alt="Sample image"
        heading="Entire card is clickable"
        href="#"
        excerpt="Teaser-link::after covers the full card area."
      />
    </div>
    <div style="width:22rem; display:flex; flex-direction:column; gap:0.5rem;">
      <Heading element="h4" variant="body" size="sm" text="button=true — default label" />
      <Teaser
        button={true}
        image={img3}
        alt="Sample image"
        heading="Heading is not a link"
        href="#"
        excerpt={'button-label defaults to "Read more" with sr-only context.'}
      />
    </div>
    <div style="width:22rem; display:flex; flex-direction:column; gap:0.5rem;">
      <Heading element="h4" variant="body" size="sm" text="button=true — custom label" />
      <Teaser
        button={true}
        button-label="Read the post"
        image={img1}
        alt="Sample image"
        heading="Custom button label"
        href="#"
        excerpt="Pass button-label to override the default."
      />
    </div>
    <div style="width:22rem; display:flex; flex-direction:column; gap:0.5rem;">
      <Heading element="h4" variant="body" size="sm" text="button=true — no image" />
      <Teaser
        button={true}
        heading="Text and button, no image"
        href="#"
        excerpt="Image prop omitted — MediaContainer not rendered."
      />
    </div>
    <div style="width:22rem; display:flex; flex-direction:column; gap:0.5rem;">
      <Heading element="h4" variant="body" size="sm" text="button=true — no excerpt" />
      <Teaser button={true} image={img2} alt="Sample image" heading="Heading and button only" href="#" />
    </div>
  </div>

  {/* — Escape hatch ——————————————————————————————— */}
  <Heading text="Escape hatch — custom child slot" element="h3" variant="body" size="lg" />
  <Text variant="label" text="No href, no button prop. Caller owns the child slot entirely." />
  <div style="width:22rem;">
    <Teaser image={img1} alt="Sample image" heading="Custom slot content">
      <Text
        variant="label"
        style="margin-block-end:0.75rem;"
        text="Arbitrary child content — use sparingly, only when the prop API cannot express what you need."
      />
      <a class="Button" href="#" data-emphasis="secondary" data-size="sm" data-pill="false">
        <span class="Button-text">Custom action</span>
      </a>
    </Teaser>
  </div>

  {/* — Guard / error state ————————————————————————— */}
  <Heading text="Guard — misconfiguration" element="h3" variant="body" size="lg" />
  <Text variant="label" text="button=true without href — visible error in dev, silently suppressed in prod." />
  <div style="width:22rem;">
    <Teaser
      button={true}
      image={img2}
      alt="Sample image"
      heading="This teaser is misconfigured"
      excerpt="button=true is set but href is missing."
    />
  </div>
</section>
