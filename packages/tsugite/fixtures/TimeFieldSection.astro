---
// Port of reference-components TimeField.html — states mirror
// TimeField.generate.ts StateDefinition[] one to one.
import Heading from "../components/Heading/Heading.astro";
import TimeField from "../components/TimeField/TimeField.astro";
---

<section class="KitchenSink-section" id="TimeField">
  <Heading text="TimeField" element="h2" size="2" />

  {/* Interaction states */}
  <Heading text="Interaction states" element="h3" variant="body" size="lg" />
  <table class="state-table">
    <thead>
      <tr>
        <th scope="col">State</th>
        <th scope="col">default</th>
        <th scope="col">hover</th>
        <th scope="col">focus</th>
        <th scope="col">active</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <th scope="row">empty</th>
        <td><TimeField id="tf-empty-default" label="Time" /></td>
        <td><TimeField id="tf-empty-hover" label="Time" data-test-state="hover" /></td>
        <td><TimeField id="tf-empty-focus" label="Time" data-test-state="focus" /></td>
        <td><TimeField id="tf-empty-active" label="Time" data-test-state="active" /></td>
      </tr>
      <tr>
        <th scope="row">filled</th>
        <td><TimeField id="tf-filled-default" label="Time" value="13:45" /></td>
        <td><TimeField id="tf-filled-hover" label="Time" value="13:45" data-test-state="hover" /></td>
        <td><TimeField id="tf-filled-focus" label="Time" value="13:45" data-test-state="focus" /></td>
        <td><TimeField id="tf-filled-active" label="Time" value="13:45" data-test-state="active" /></td>
      </tr>
    </tbody>
  </table>

  {/* Disabled */}
  <Heading text="Disabled" element="h3" variant="body" size="lg" />
  <table class="state-table">
    <tbody>
      <tr>
        <th scope="row">empty</th>
        <td><TimeField id="tf-disabled-empty" label="Time" disabled={true} /></td>
      </tr>
      <tr>
        <th scope="row">filled</th>
        <td><TimeField id="tf-disabled-filled" label="Time" value="13:45" disabled={true} /></td>
      </tr>
    </tbody>
  </table>

  {/* Invalid */}
  <Heading text="Invalid" element="h3" variant="body" size="lg" />
  <table class="state-table">
    <tbody>
      <tr>
        <th scope="row">required + empty</th>
        <td>
          <TimeField
            id="tf-invalid-empty"
            label="Time"
            labelSuffix={'<span aria-hidden="true">*</span>'}
            invalid={true}
            required={true}
          />
        </td>
      </tr>
      <tr>
        <th scope="row">out of range</th>
        <td><TimeField id="tf-invalid-filled" label="Time" value="07:00" invalid={true} /></td>
      </tr>
    </tbody>
  </table>

  {/* With seconds (step < 60) */}
  <Heading text="Variants" element="h3" variant="body" size="lg" />
  <table class="state-table">
    <tbody>
      <tr>
        <th scope="row">with seconds</th>
        <td><TimeField id="tf-with-seconds" label="Time" value="13:45:30" step="1" /></td>
      </tr>
    </tbody>
  </table>

  {/* Live demo */}
  <Heading text="Live demo" element="h3" variant="body" size="lg" />
  <div>
    <TimeField id="meeting-time" label="Meeting time" />
  </div>

  {/* Localization: the hour cycle differs by locale */}
  <Heading text="Localization" element="h3" variant="body" size="lg" />
  <table class="state-table">
    <tbody>
      <tr>
        <th scope="row">en-GB</th>
        <td><TimeField id="tf-locale-en-gb" label="Time (en-GB — 24h)" locale="en-GB" value="13:45" /></td>
      </tr>
      <tr>
        <th scope="row">en-US</th>
        <td><TimeField id="tf-locale-en-us" label="Time (en-US — 12h)" locale="en-US" value="13:45" /></td>
      </tr>
    </tbody>
  </table>

  {/* Native reference */}
  <Heading text="Native reference" element="h3" variant="body" size="lg" />
  <table class="state-table">
    <tbody>
      <tr>
        <th scope="row">default</th>
        <td>
          <label for="tf-native-default">Tid</label>
          <input type="time" id="tf-native-default" name="tf-native-default" />
        </td>
      </tr>
      <tr>
        <th scope="row">disabled</th>
        <td>
          <label for="tf-native-disabled">Tid</label>
          <input type="time" id="tf-native-disabled" name="tf-native-disabled" value="13:45" disabled />
        </td>
      </tr>
    </tbody>
  </table>
</section>
