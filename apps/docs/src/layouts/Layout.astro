---
// Port of AiPoc Views/Shared/_Layout.cshtml
import "../styles/global.css";
import Header from "../components/Header/Header.astro";
import Footer from "../components/Footer/Footer.astro";
import SvgSprite from "../components/SvgSprite/SvgSprite.astro";
interface Props {
  title?: string;
  /** Mirrors Umbraco's Model.ContentType.Alias on #App */
  template?: string;
  /** Mirrors _Layout.cshtml's HeroPosterUrl preload for hero media */
  preloadImage?: string;
}

const { title = "Tsugite", template, preloadImage } = Astro.props;
---

<!doctype html>
{/* No data-appearance here: absence means "follow the OS" (ADR-0021), and
    ThemeSwitch owns the user override at runtime. The legacy primitives are
    still light-only — resolved by the upcoming color-system pass. */}
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>
      // FOUC guard (reference-components PORTING.md): restore an explicit
      // appearance override before first paint. Inline and synchronous by
      // design — a module runs after parsing, which is too late. `system`
      // needs no restore: color-scheme already follows the OS.
      try {
        var a = localStorage.getItem("appearance-preference");
        if (a === "light" || a === "dark") document.documentElement.setAttribute("data-appearance", a);
      } catch (e) {
        /* storage blocked — fall back to following the OS */
      }
    </script>
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
  </head>
  <body>
    <div id="App" class="Layout" data-template={template}>
      <Header />

      <slot />

      <Footer />
    </div>

    <SvgSprite />
  </body>
</html>
