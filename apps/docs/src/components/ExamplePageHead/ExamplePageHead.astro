---
// ExamplePageHead — the head every /docs page shares, so each one opens the same way:
// the breadcrumb to the map, the title, the tags and the preamble. It knows nothing of
// the manifest: DocPage hands a component's row in as section, title and tags, and a
// foundation page hands its own. The parts are one group and sit close; the page's sections keep their
// distance from the group, not from each other part of it.
import Heading from "tsugite/Heading/Heading.astro";
import Caption from "tsugite/Caption/Caption.astro";
import TextBlock from "tsugite/TextBlock/TextBlock.astro";
/** One tag: its words, and whether it is the page's own kind (drawn stronger). */
export interface Tag {
  text: string;
  primary?: boolean;
}

interface Props {
  /** Where the page sits on the map: the breadcrumb's last step. */
  section: string;
  title: string;
  tags?: Tag[];
  /** The preamble: what the page is about, in a sentence or three. */
  lead?: string;
}
const { section, title, tags = [], lead } = Astro.props;
---

<header class="ExamplePageHead">
  <nav class="breadcrumb" aria-label="Map">
    <Caption element="p" size="sm"><a href="/map">Map</a> <span aria-hidden="true">/</span> {section}</Caption>
  </nav>

  <Heading element="h1" size="1" text={title} />

  {tags.length > 0 && (
    <ul class="tags">
      {tags.map((t) => <li class="chip" data-primary={t.primary ? "true" : "false"}><Caption size="sm" text={t.text} /></li>)}
    </ul>
  )}

  {lead && <TextBlock text={lead} />}
</header>

<style is:global>
/* Arrangement and ink only: the words are the typography doors', which set no colour, so
   the muted channel rides the wrapper and is inherited. */
.ExamplePageHead {
  display: flex;
  flex-direction: column;
  gap: var(--size-md);
  /* the head stands a step further from the sections than they stand from each other */
  margin-block-end: var(--size-md);

  & .breadcrumb {
    color: var(--color-text-secondary);

    & a {
      color: var(--color-interactive-secondary-text);
    }
  }

  & .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-xs);
  }

  /* TODO(decide): the chip is a faux pill until the Pill primitive is designed. */
  & .chip {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-secondary);
    background-color: var(--color-surface-chrome);

    &[data-primary="true"] {
      border-color: var(--color-interactive-primary);
      color: var(--color-text-primary);
    }
  }
}
</style>
