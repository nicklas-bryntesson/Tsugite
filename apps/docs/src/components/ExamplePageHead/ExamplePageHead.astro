---
// ExamplePageHead — the head every /docs page shares, so each one opens the same way:
// the breadcrumb to the map, the component's title, its tags (pillar, family, ADRs) and
// the preamble. The parts are one group and sit close; the page's sections keep their
// distance from the group, not from each other part of it.
import Heading from "tsugite/Heading/Heading.astro";
import Caption from "tsugite/Caption/Caption.astro";
import TextBlock from "tsugite/TextBlock/TextBlock.astro";
import { pillarLabels, type ManifestEntry } from "../../lib/manifest.ts";

interface Props {
  entry: ManifestEntry;
  /** The preamble: what the component is, in a sentence or three. */
  lead?: string;
}
const { entry, lead } = Astro.props;
---

<header class="ExamplePageHead">
  <nav class="breadcrumb" aria-label="Map">
    <Caption element="p" size="sm"><a href="/map">Map</a> <span aria-hidden="true">/</span> {pillarLabels[entry.pillar]}</Caption>
  </nav>

  <Heading element="h1" size="1" text={entry.title} />

  <ul class="tags">
    <li class="chip" data-kind="pillar"><Caption size="sm" text={pillarLabels[entry.pillar]} /></li>
    {entry.family && <li class="chip" data-kind="family"><Caption size="sm" text={entry.family} /></li>}
    {entry.adrs?.map((n) => <li class="chip" data-kind="adr"><Caption size="sm" text={`ADR-${n}`} /></li>)}
  </ul>

  {lead && <TextBlock text={lead} />}
</header>

<style is:global>
/* Arrangement and ink only: the words are the typography doors', which set no colour, so
   the muted channel rides the wrapper and is inherited. */
.ExamplePageHead {
  display: flex;
  flex-direction: column;
  gap: var(--size-md);
  /* the head stands a step further from the sections than they stand from each other */
  margin-block-end: var(--size-md);

  & .breadcrumb {
    color: var(--color-text-secondary);

    & a {
      color: var(--color-interactive-secondary-text);
    }
  }

  & .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-xs);
  }

  /* TODO(decide): the chip is a faux pill until the Pill primitive is designed. */
  & .chip {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-secondary);
    background-color: var(--color-surface-chrome);

    &[data-kind="pillar"] {
      border-color: var(--color-interactive-primary);
      color: var(--color-text-primary);
    }
  }
}
</style>
