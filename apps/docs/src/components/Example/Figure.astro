---
// Figure — the visual half of a documentation example.
//
// A framed surface that renders the example exactly as a consumer would see
// it. It owns the frame only; the example inside is the same component the
// package ships, so what is shown is what is used. Pair it with <Code> via
// <Example>, which feeds both from one source file.
interface Props {
  /** Visible caption under the frame. */
  caption?: string;
  /** Let the example stretch to the full frame width (layout examples). */
  block?: boolean;
  class?: string;
}
const { caption, block = false, class: className } = Astro.props;
---

<figure class:list={["Figure", className]} data-block={block ? "true" : undefined}>
  <div class="Figure-stage">
    <slot />
  </div>
  {caption && <figcaption class="Figure-caption">{caption}</figcaption>}
</figure>

<style is:global>
.Figure {
  margin: 0;
  display: grid;
  gap: var(--size-sm);

  & .Figure-stage {
    padding: var(--size-lg);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--ui-radius);
    background-color: var(--color-surface-page);
    /* the example decides its own width; a layout example asks for the frame */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--size-md);
  }

  &[data-block="true"] .Figure-stage {
    align-items: stretch;
  }

  & .Figure-caption {
    font-size: var(--fontSize-label-small);
    color: var(--color-text-secondary);
  }
}
</style>
