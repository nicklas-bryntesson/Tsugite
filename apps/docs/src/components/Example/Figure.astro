---
// Figure — the visual half of a documentation example.
//
// A framed surface that renders the example exactly as a consumer would see
// it. It owns the frame only; the example inside is the same component the
// package ships, so what is shown is what is used. Pair it with <Code> via
// <Example>, which feeds both from one source file.
import Card from "tsugite/Card/Card.astro";
import Caption from "tsugite/Caption/Caption.astro";

interface Props {
  /** Visible caption under the frame. */
  caption?: string;
  /** Let the example stretch to the full frame width (layout examples). */
  block?: boolean;
  /** Lay the example's items out in a wrapping row (inline components: buttons, chips). */
  row?: boolean;
  class?: string;
}
const { caption, block = false, row = false, class: className } = Astro.props;
---

<figure class:list={["Figure", className]} data-block={block ? "true" : undefined} data-row={row ? "true" : undefined}>
  <Card border={true} padding="lg">
    <div class="Figure-stage">
      <slot />
    </div>
  </Card>
  {caption && <figcaption class="Figure-caption"><Caption element="p" size="sm" text={caption} /></figcaption>}
</figure>

<style is:global>
.Figure {
  margin: 0;
  display: grid;
  gap: var(--size-sm);

  /* the frame is Card's; the stage only arranges what the example puts in it */
  & .Figure-stage {
    /* the example decides its own width; a layout example asks for the frame */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--size-md);
  }

  &[data-block="true"] .Figure-stage {
    align-items: stretch;
  }

  &[data-row="true"] .Figure-stage {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
  }

  & .Figure-caption {
    color: var(--color-text-secondary);
  }
}
</style>
