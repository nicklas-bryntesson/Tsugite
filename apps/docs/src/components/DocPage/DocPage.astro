---
// DocPage — the shell every /docs page shares: the head (ExamplePageHead), then
// the page's own content. Explicit pages (docs/notice.astro) and the fallback
// (docs/[slug].astro) both use it, and so do the foundation pages, which have
// no manifest row and hand their head's words in themselves.
import ExamplePageHead, { type Tag } from "../ExamplePageHead/ExamplePageHead.astro";
import { pillarLabels, type ManifestEntry } from "../../lib/manifest.ts";

/** A component's page hands its manifest row; a page that has none (a foundation)
 *  hands its head's words itself. */
type Props =
  | { entry: ManifestEntry; lead?: string }
  | { section: string; title: string; tags?: Tag[]; lead?: string };
const props = Astro.props;

// The row, read as a head: the pillar is the section and the page's own kind.
const head =
  "entry" in props
    ? {
        section: pillarLabels[props.entry.pillar],
        title: props.entry.title,
        tags: [
          { text: pillarLabels[props.entry.pillar], primary: true },
          ...(props.entry.family ? [{ text: props.entry.family }] : []),
          ...(props.entry.adrs ?? []).map((n) => ({ text: `ADR-${n}` })),
        ],
      }
    : { section: props.section, title: props.title, tags: props.tags };
---

<main class="Main DocPage grid-container">
  <div class="content">
    <ExamplePageHead {...head} lead={props.lead} />

    <slot />
  </div>
</main>

<style is:global>
.DocPage {
  padding-block: 3rem 4rem;
  background-color: var(--color-surface-page);

  & .content {
    /* placed in the main area by the .grid-container > * default */
    display: flex;
    flex-direction: column;
    gap: var(--size-xl);
  }

  & .doc-note {
    color: var(--color-text-secondary);
  }

  /* sections carry bench classes; give them the same breathing room */
  & .doc-demo,
  & .doc-bench {
    display: flex;
    flex-direction: column;
    gap: var(--size-md);
    inline-size: 100%;
  }

  & .doc-bench {
    padding-block-start: var(--size-xl);
    border-block-start: 1px solid var(--color-border-subtle);
  }
}
</style>
