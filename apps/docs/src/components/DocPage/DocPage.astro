---
// DocPage — the shell every /docs page shares: the head (ExamplePageHead), then
// the page's own content. Explicit pages (docs/notice.astro) and the fallback
// (docs/[slug].astro) both use it, so the chrome lives here once.
import ExamplePageHead from "../ExamplePageHead/ExamplePageHead.astro";
import type { ManifestEntry } from "../../lib/manifest.ts";

interface Props {
  entry: ManifestEntry;
  /** The preamble, handed to the head. */
  lead?: string;
}
const { entry, lead } = Astro.props;
---

<main class="Main DocPage grid-container">
  <div class="content">
    <ExamplePageHead entry={entry} lead={lead} />

    <slot />
  </div>
</main>

<style is:global>
.DocPage {
  padding-block: 3rem 4rem;
  background-color: var(--color-surface-page);

  & .content {
    /* placed in the main area by the .grid-container > * default */
    display: flex;
    flex-direction: column;
    gap: var(--size-xl);
  }

  & .doc-note {
    color: var(--color-text-secondary);
  }

  /* sections carry bench classes; give them the same breathing room */
  & .doc-demo,
  & .doc-bench {
    display: flex;
    flex-direction: column;
    gap: var(--size-md);
    inline-size: 100%;
  }

  & .doc-bench {
    padding-block-start: var(--size-xl);
    border-block-start: 1px solid var(--color-border-subtle);
  }
}
</style>
