---
// ResolutionPanel — the componentized Resolution probes from
// /control-room, extended: one droppable panel answering "what does
// THIS browser and window resolve to, right now".
//
// Three kinds of pills:
//   1. Support gates (read-only) — which branch each @supports gate
//      takes here; the gamut probe stays subscribed so dragging the
//      window between displays updates the row.
//   2. Resolved state (read-only, live) — the appearance × contrast
//      cell (pinned vs system), the viewport tier (the ADR-0001
//      ranges), and window width.
//   3. The type-scale control — steps --TYPE-SCALE on :root along
//      Chrome's font-size ladder (×0.75–×2). Every fontSize token is
//      FLOOR × TYPE-SCALE, so one override scales the whole ramp and
//      composes with the tier stops; ×1 removes the override.
//
// The Header's ThemeSwitch stays the only appearance control — this
// panel never writes data-appearance. Contrast is media-keyed only, so
// it is readable but not spoofable from the app (upstream finding).
---

<div class="ResolutionPanel">
  <ul class="resolution-list">
    <li><span class="res-name">display gamut</span> <output class="res-value" data-probe="gamut"></output></li>
    <li><span class="res-name">oklch</span> <output class="res-value" data-probe="oklch"></output></li>
    <li><span class="res-name">@property</span> <output class="res-value" data-probe="property"></output></li>
    <li><span class="res-name">color-mix</span> <output class="res-value" data-probe="colormix"></output></li>
    <li><span class="res-name">container queries</span> <output class="res-value" data-probe="cq"></output></li>
    <li><span class="res-name">text-box-trim</span> <output class="res-value" data-probe="textboxtrim"></output></li>
    <li><span class="res-name">appearance</span> <output class="res-value" data-probe="appearance"></output></li>
    <li><span class="res-name">contrast</span> <output class="res-value" data-probe="contrast"></output></li>
    <li><span class="res-name">tier</span> <output class="res-value" data-probe="tier"></output></li>
    <li><span class="res-name">width</span> <output class="res-value" data-probe="width"></output></li>
    <li class="res-control">
      <label class="res-name" for="res-type-scale">type scale</label>
      <select id="res-type-scale" data-control="type-scale">
        <option value="0.75">Small ×0.75</option>
        <option value="1" selected>Medium ×1</option>
        <option value="1.25">Large ×1.25</option>
        <option value="1.5">Very large ×1.5</option>
        <option value="2">×2</option>
      </select>
    </li>
  </ul>
</div>

<script>
  const set = (probe: string, value: string, active = false) => {
    for (const out of document.querySelectorAll<HTMLElement>(`[data-probe="${probe}"]`)) {
      out.textContent = value;
      out.dataset.active = String(active);
    }
  };

  // — Support gates —
  const gamuts: Array<[string, MediaQueryList]> = [
    ["rec2020", matchMedia("(color-gamut: rec2020)")],
    ["p3", matchMedia("(color-gamut: p3)")],
    ["srgb", matchMedia("(color-gamut: srgb)")],
  ];
  const readGamut = () => {
    const hit = gamuts.find(([, mq]) => mq.matches);
    set("gamut", hit ? hit[0] : "unknown", !!hit && hit[0] !== "srgb");
  };
  readGamut();
  for (const [, mq] of gamuts) mq.addEventListener("change", readGamut);

  const supports = (probe: string, ok: boolean) =>
    set(probe, ok ? "supported" : "fallback branch", ok);
  supports("oklch", CSS.supports("color", "oklch(1 0 0)"));
  supports("property", typeof CSSPropertyRule !== "undefined");
  supports("colormix", CSS.supports("color", "color-mix(in oklch, red, blue)"));
  supports("cq", CSS.supports("container-type: inline-size"));
  supports("textboxtrim", CSS.supports("text-box-trim", "trim-both"));

  // — Resolved state —
  const root = document.documentElement;

  // A data-appearance attribute is a pinned user override (ThemeSwitch,
  // ADR-0021); absence means the OS decides.
  const darkQuery = matchMedia("(prefers-color-scheme: dark)");
  const readAppearance = () => {
    const pinned = root.getAttribute("data-appearance");
    set(
      "appearance",
      pinned ? `${pinned} (pinned)` : `${darkQuery.matches ? "dark" : "light"} (system)`,
    );
  };
  readAppearance();
  darkQuery.addEventListener("change", readAppearance);
  new MutationObserver(readAppearance).observe(root, {
    attributes: true,
    attributeFilter: ["data-appearance"],
  });

  const contrastQuery = matchMedia("(prefers-contrast: more)");
  const readContrast = () =>
    set("contrast", contrastQuery.matches ? "more" : "no-preference");
  readContrast();
  contrastQuery.addEventListener("change", readContrast);

  // The same bounded ranges as the token ramps (ADR-0001).
  const tiers: Array<[string, MediaQueryList]> = [
    ["FLOOR", matchMedia("(max-width: 21.24999rem)")],
    ["MOBILE", matchMedia("(min-width: 21.25rem) and (max-width: 48.74rem)")],
    ["DESKTOP", matchMedia("(min-width: 48.75rem) and (max-width: 89.99rem)")],
    ["WIDE", matchMedia("(min-width: 90rem)")],
  ];
  const readTier = () => {
    const hit = tiers.find(([, mq]) => mq.matches);
    set("tier", hit ? hit[0] : "unknown");
  };
  readTier();
  for (const [, mq] of tiers) mq.addEventListener("change", readTier);

  const readWidth = () => set("width", `${window.innerWidth}px`);
  readWidth();
  window.addEventListener("resize", readWidth);

  // — Type scale —
  const scale = document.querySelector<HTMLSelectElement>('[data-control="type-scale"]');
  scale?.addEventListener("change", () => {
    if (scale.value === "1") root.style.removeProperty("--TYPE-SCALE");
    else root.style.setProperty("--TYPE-SCALE", scale.value);
  });
</script>

<style is:global>
.ResolutionPanel {
  inline-size: 100%;

  & .resolution-list {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(14rem, 100%), 1fr));
    gap: 0.5rem;
    inline-size: 100%;
  }

  & .resolution-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.5rem;
  }

  & .res-name { font-size: 0.85rem; color: var(--color-text-secondary); }

  & .res-value {
    font-family: monospace;
    font-size: 0.8rem;
    color: var(--color-text-primary);

    /* active-branch marker is a decorative dot — small green TEXT on the
       page ground fails AA (2.4:1), a finding this page's own axe twin
       caught on first light */
    &[data-active="true"]::before {
      content: "";
      display: inline-block;
      inline-size: 0.5rem;
      block-size: 0.5rem;
      border-radius: 50%;
      background-color: var(--color-feedback-success);
      margin-inline-end: 0.4rem;
      vertical-align: 0.05em;
    }
  }

  & .res-control select {
    font: inherit;
    font-family: monospace;
    font-size: 0.8rem;
    color: var(--color-text-primary);
    background-color: var(--color-surface-inset);
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.25rem;
    padding: 0.125rem 0.375rem;
  }
}
</style>
