---
// The text-box bench (ADR-0024): every component on the engine, twice — as this browser
// resolves it, and with the fallback forced (data-test-text-box="fallback" on the cell).
// Each sample sits in its own Card (neutral × primary); a row puts the two side by side,
// and the native text's cap line and baseline are drawn across both, so a fallback that
// slides shows against the line. The controls row sets every md control beside a field —
// the one size that meets the field today. The composed card stacks every door the way
// a real page does, so drift that adds up shows too. Two switches: the guides (on) and
// "visualize spacing" (off), which paints padding, gaps and content boxes. A component
// joins with a row here when it moves onto the engine.
import "../../styles/instruments/instruments.css";
import Card from "tsugite/Card/Card.astro";
import ChoiceField from "tsugite/ChoiceField/ChoiceField.astro";
import Text from "tsugite/Text/Text.astro";
import Heading from "tsugite/Heading/Heading.astro";
import Caption from "tsugite/Caption/Caption.astro";
import TextBlock from "tsugite/TextBlock/TextBlock.astro";
import ActionButton from "tsugite/Button/ActionButton.astro";
import AffixField from "tsugite/AffixField/AffixField.astro";

type Sample = {
  key: string;
  component: "Text" | "Heading" | "Caption" | "TextBlock" | "ActionButton" | "Controls";
  props?: Record<string, unknown>;
  label?: string;
  narrow?: true;
};
const samples: Sample[] = [
  { key: "Text sm", component: "Text", props: { size: "sm", text: "One line in body sm" } },
  { key: "Text md", component: "Text", props: { size: "md", text: "One line in body md" } },
  { key: "Text lg", component: "Text", props: { size: "lg", text: "One line in body lg" } },
  { key: "Text md, wrapped", component: "Text", props: { size: "md", text: "Wrapped body md, so the leading between the lines shows" }, narrow: true },
  { key: "Heading 2", component: "Heading", props: { size: "2", text: "A heading in size 2" } },
  { key: "Heading 6", component: "Heading", props: { size: "6", text: "A heading in size 6" } },
  { key: "Display 2", component: "Heading", props: { variant: "display", size: "2", text: "Display 2" } },
  { key: "Heading 3, link", component: "Heading", props: { element: "h3", href: "#TextBox", text: "A heading that is a link" } },
  { key: "Heading 3, wrapped", component: "Heading", props: { element: "h3", text: "A wrapped heading, the leading between its lines" }, narrow: true },
  { key: "Caption label sm", component: "Caption", props: { size: "sm", text: "A hint under a field" } },
  { key: "Caption label md", component: "Caption", props: { text: "A form label" } },
  { key: "Caption button md", component: "Caption", props: { variant: "button", text: "The button voice" } },
  { key: "Caption nav md", component: "Caption", props: { variant: "nav", text: "The nav voice" } },
  { key: "TextBlock preamble md", component: "TextBlock", props: { text: "A standfirst from a field" } },
  { key: "TextBlock body md", component: "TextBlock", props: { variant: "body", text: "A plain field in the body voice" } },
  { key: "TextBlock preamble, two field lines", component: "TextBlock", props: { text: "First line of the field\nSecond line of the field" } },
  { key: "Button sm", component: "ActionButton", props: { size: "sm", emphasis: "secondary" }, label: "Press" },
  { key: "Button md", component: "ActionButton", props: { size: "md", emphasis: "secondary" }, label: "Press" },
  { key: "Button lg", component: "ActionButton", props: { size: "lg", emphasis: "secondary" }, label: "Press" },
  { key: "Button md, wrapped", component: "ActionButton", props: { size: "md", emphasis: "secondary" }, label: "Press this button, please", narrow: true },
  { key: "Button md, icon", component: "ActionButton", props: { size: "md", emphasis: "secondary", icon: "icon-search" }, label: "Search" },
  { key: "Button md, icon only", component: "ActionButton", props: { size: "md", emphasis: "secondary", icon: "icon-search", "aria-label": "Search" } },
  { key: "Controls md", component: "Controls" },
];
const components = { Text, Heading, Caption, TextBlock, ActionButton };
const sides = ["native", "fallback"] as const;
const forced = (side: (typeof sides)[number]) => (side === "fallback" ? { "data-test-text-box": "fallback" } : {});
const voice = { "data-theme": "neutral", "data-prominence": "primary" };
---

<div class="TextBoxBench" data-visualize="false" data-show-guides="true">
  <div class="controls">
    <p class="note" data-branch></p>
    <div class="switches">
      <ChoiceField type="checkbox" id="bench-guides" name="bench-guides" label="Show guides" checked />
      <ChoiceField type="checkbox" id="bench-visualize" name="bench-visualize" label="Visualize spacing" />
    </div>
  </div>

  <div class="head">
    <span>As this browser resolves it</span>
    <span>Fallback forced — the margin formula</span>
  </div>

  <div class="rows" data-guides>
    {samples.map((s) => {
      const Component = s.component === "Controls" ? null : components[s.component];
      return (
        <div class="row" data-sample={s.key}>
          {sides.map((side) => (
            <div class="cell" data-side={side} data-narrow={s.narrow ? "true" : "false"} {...forced(side)}>
              <Card class="probe" border={true} padding="md" {...voice}>
                {Component ? (
                  <Component {...s.props}>{s.label}</Component>
                ) : (
                  <div class="control-line">
                    <ActionButton size="md" emphasis="primary">Send</ActionButton>
                    <ActionButton size="md" emphasis="secondary" icon="icon-search">Search</ActionButton>
                    <ActionButton size="md" emphasis="secondary" icon="icon-search" aria-label="Search" />
                    <AffixField id={`bench-field-${side}`} label="Amount" input={{ inputmode: "decimal" }} />
                  </div>
                )}
              </Card>
            </div>
          ))}
        </div>
      );
    })}
  </div>

  <p class="note">
    Composed: every door stacked as a page would stack them — eyebrow, heading, two
    paragraphs, an inset with its own label, a button, the small print. The guides run
    from every native text box across both cards.
  </p>
  <div class="composed" data-guides>
    {sides.map((side) => (
      <div class="cell" data-side={side} {...forced(side)}>
        <Card element="article" class="card" border={true} padding="lg" {...voice}>
          <div class="stack">
            <Caption size="sm" text="For your team" />
            <Heading element="h3" size="3" text="Your trial ends on Friday" />
            <Text text="Your project is ready to go live, and the plan you are on keeps it running until the end of the week." />
            <Text text="Here is a code for the first month of the next plan. It works on every plan above it, in any currency." />
            <Card class="inset" border={true} padding="md">
              <div class="stack tight">
                <Caption size="sm" text="Your personal code" />
                <Text text="TRIAL-20-K7QX takes the first month off any plan above the one you have. It works once." />
              </div>
            </Card>
            <div>
              <ActionButton size="md" emphasis="primary">Claim the month</ActionButton>
            </div>
            <Text size="sm" text="The code is personal to this account, works once, and cannot be combined with another offer." />
          </div>
        </Card>
      </div>
    ))}
  </div>

  <output class="readout"></output>
</div>

<script>
  const px = (n: number) => `${n.toFixed(2)}px`;

  /** An empty inline-block at the end of a text: its bottom edge is the last baseline. */
  function baselineMark(text: HTMLElement) {
    let mark = text.querySelector<HTMLElement>(":scope > [data-baseline-mark]");
    if (!mark) {
      mark = document.createElement("span");
      mark.dataset.baselineMark = "";
      mark.setAttribute("aria-hidden", "true");
      Object.assign(mark.style, { display: "inline-block", inlineSize: "0", blockSize: "0" });
      text.append(mark);
    }
    return mark;
  }

  /** The native side's text boxes — cap line and last baseline — and, in the controls row,
      each control's outer box, drawn across the whole block so the fallback side is read
      against them. */
  function drawGuides(block: HTMLElement) {
    block.querySelectorAll(":scope > .guide").forEach((g) => g.remove());
    const top = block.getBoundingClientRect().top;
    const edges: number[] = [];
    for (const text of block.querySelectorAll<HTMLElement>('[data-side="native"] [data-text-box="block"] > .text')) {
      edges.push(text.getBoundingClientRect().top, baselineMark(text).getBoundingClientRect().bottom);
    }
    for (const control of block.querySelectorAll<HTMLElement>('[data-side="native"] .control-line > :is(.Button, .AffixField)')) {
      const r = control.getBoundingClientRect();
      edges.push(r.top, r.bottom);
    }
    for (const y of edges) {
      const g = document.createElement("div");
      g.className = "guide";
      g.setAttribute("aria-hidden", "true");
      g.style.insetBlockStart = `${y - top}px`;
      block.append(g);
    }
  }

  function measure(bench: HTMLElement) {
    // What the CSS did, not what the browser claims: the native side's computed trim.
    const sample = bench.querySelector<HTMLElement>('[data-side="native"] [data-text-box="block"] > .text')!;
    const native = getComputedStyle(sample).getPropertyValue("text-box-trim") === "trim-both";
    bench.querySelector<HTMLElement>("[data-branch]")!.textContent = native
      ? "This browser trims natively: the left side is the native branch, the right the fallback."
      : "This browser cannot trim natively: both sides run the fallback, and they must agree to the pixel.";

    // The two branches trim differently: native shrinks the text's own box, the fallback
    // pulls the cell in with negative margins and leaves the box whole. So the readout is
    // what the cell gets — the footprint — and where the last baseline sits in it. An
    // icon-only button has no text, so its row reads the footprint only.
    const read = (row: HTMLElement, side: string) => {
      const probe = row.querySelector<HTMLElement>(`[data-side="${side}"] .probe`)!;
      const text = probe.querySelector<HTMLElement>(":scope > * > .text");
      const p = probe.getBoundingClientRect();
      const cs = getComputedStyle(probe);
      const pad = parseFloat(cs.paddingBlockStart) + parseFloat(cs.paddingBlockEnd) + parseFloat(cs.borderBlockStartWidth) + parseFloat(cs.borderBlockEndWidth);
      const contentBottom = p.bottom - parseFloat(cs.paddingBlockEnd) - parseFloat(cs.borderBlockEndWidth);
      return {
        footprint: p.height - pad,
        baseline: text ? contentBottom - baselineMark(text).getBoundingClientRect().bottom : null,
      };
    };

    const rows = [...bench.querySelectorAll<HTMLElement>(".row")].filter((r) => r.dataset.sample !== "Controls md");
    const lines = rows.map((row) => {
      const n = read(row, "native");
      const f = read(row, "fallback");
      const baseline = n.baseline === null || f.baseline === null ? "" : ` · last baseline above the cell's end ${px(n.baseline)} / ${px(f.baseline)}`;
      return `${row.dataset.sample}: footprint ${px(n.footprint)} / ${px(f.footprint)} · Δ ${px(n.footprint - f.footprint)}${baseline}`;
    });

    // One height for every md control: text, text and icon, icon only, and the field.
    const controls = bench.querySelector<HTMLElement>('.row[data-sample="Controls md"]')!;
    for (const side of ["native", "fallback"]) {
      const h = [...controls.querySelectorAll<HTMLElement>(`[data-side="${side}"] .control-line > :is(.Button, .AffixField)`)].map((el) => px(el.getBoundingClientRect().height));
      lines.push(`controls md (${side}): text ${h[0]} · icon ${h[1]} · icon only ${h[2]} · field ${h[3]}`);
    }

    // The composed card: how far the fallback's stack has slid by its last baseline.
    const cardEnd = (side: string) => {
      const card = bench.querySelector<HTMLElement>(`.composed [data-side="${side}"] .card`)!;
      const texts = card.querySelectorAll<HTMLElement>('[data-text-box="block"] > .text');
      const c = card.getBoundingClientRect();
      return { height: c.height, baseline: baselineMark(texts[texts.length - 1]).getBoundingClientRect().bottom - c.top };
    };
    const cn = cardEnd("native");
    const cf = cardEnd("fallback");
    lines.push(
      `composed card: height ${px(cn.height)} / ${px(cf.height)} · Δ ${px(cn.height - cf.height)} · last baseline from the card's top ${px(cn.baseline)} / ${px(cf.baseline)} · Δ ${px(cn.baseline - cf.baseline)}`,
    );

    bench.querySelector("output")!.textContent = lines.join("\n");
    bench.querySelectorAll<HTMLElement>("[data-guides]").forEach(drawGuides);
  }

  function run() {
    document.querySelectorAll<HTMLElement>(".TextBoxBench").forEach(measure);
  }

  // The two switches write the bench's state; the CSS reads it.
  for (const bench of document.querySelectorAll<HTMLElement>(".TextBoxBench")) {
    const bind = (id: string, attr: "visualize" | "showGuides") => {
      const box = bench.querySelector<HTMLInputElement>(`#${id}`)!;
      const write = () => (bench.dataset[attr] = box.checked ? "true" : "false");
      box.addEventListener("change", write);
      write();
    };
    bind("bench-guides", "showGuides");
    bind("bench-visualize", "visualize");
  }

  run();
  addEventListener("resize", run);
  document.fonts?.ready.then(run);
</script>

<style>
  .TextBoxBench {
    display: grid;
    gap: var(--size-md);

    & .controls {
      display: flex;
      flex-wrap: wrap;
      gap: var(--size-md);
      align-items: center;
      justify-content: space-between;
    }

    & .switches {
      display: flex;
      flex-wrap: wrap;
      gap: var(--size-lg);
    }

    & .note {
      margin: 0;
      color: var(--color-text-secondary);
      font-size: var(--fontSize-label);
    }

    & .head,
    & .row,
    & .composed {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--size-md);
    }

    & .head {
      color: var(--color-text-secondary);
      font-size: var(--fontSize-label);
    }

    & .rows {
      display: grid;
      gap: var(--size-sm);
    }

    & .rows,
    & .composed {
      position: relative;
    }

    & .cell {
      min-inline-size: 0;
    }

    & .cell[data-narrow="true"] {
      max-inline-size: 14rem;
    }

    /* The dashed outline is the text's box: what the engine trimmed. The parts below are
       rendered by the components inside, so they carry no scope attribute of this file. */
    & .probe > :global(* > .text) {
      outline: 1px dashed var(--bench-guide);
    }

    & .control-line {
      display: flex;
      flex-wrap: wrap;
      gap: var(--size-sm);
      align-items: center;
    }

    & .stack {
      display: flex;
      flex-direction: column;
      gap: var(--size-md);
    }

    & .stack.tight {
      gap: var(--size-sm);
    }

    /* The guides are drawn by the script, so they carry no scope attribute. */
    & :global(.guide) {
      position: absolute;
      inset-inline: 0;
      border-block-start: 1px dashed var(--bench-guide);
      pointer-events: none;
    }

    &[data-show-guides="false"] :global(.guide) {
      display: none;
    }

    /* Visualize spacing: a container's padding green, the gaps between its children pink,
       each component's own box white — a slide shows as colour that does not line up. */
    &[data-visualize="true"] {
      & .probe,
      & .card,
      & .inset {
        background: var(--bench-gap);
      }

      & .probe,
      & .inset {
        box-shadow: inset 0 0 0 var(--size-md) var(--bench-padding);
      }

      & .card {
        box-shadow: inset 0 0 0 var(--size-lg) var(--bench-padding);
      }

      & .probe > :global(:not(.control-line)),
      & .control-line > :global(:is(.Button, .AffixField)),
      & .stack > :global(:not(.inset)),
      & .inset .stack > :global(*) {
        background: var(--bench-content);
      }
    }

    & .readout {
      white-space: pre-wrap;
      font-family: var(--fontFamily-code);
      font-size: var(--fontSize-label-small);
    }
  }
</style>
