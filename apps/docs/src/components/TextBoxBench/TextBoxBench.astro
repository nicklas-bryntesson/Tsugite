---
// The text-box bench (ADR-0024): every component on the engine, twice — as this browser
// resolves it, and with the fallback forced (data-test-text-box="fallback" on the cell).
// Each sample is a Card holding a Surface (neutral × primary): the Card is the frame — border,
// radius, clipping — and the Surface inside it owns the ground, the voice claim and the
// inset; a row puts the two side by side,
// and the native text's cap line and baseline are drawn across both, so a fallback that
// slides shows against the line. The controls row sets every md control beside a field —
// the one size that meets the field today. The composed card stacks every door the way
// a real page does, so drift that adds up shows too. Three switches: the guides (on), the
// text boxes (off) and "visualize spacing" (off), which paints padding, gaps and content boxes. A component
// joins with a row here when it moves onto the engine.
//
// Lives as long as the fallback does: when the fallback leaves engine/text-box.js, the
// forced side, the fallback column's texts and the per-row Δ have nothing left to show —
// rework this bench in the same change.
import "../../styles/instruments/instruments.css";
import Card from "tsugite/Card/Card.astro";
import Surface from "tsugite/Surface/Surface.astro";
import ChoiceField from "tsugite/ChoiceField/ChoiceField.astro";
import Text from "tsugite/Text/Text.astro";
import Heading from "tsugite/Heading/Heading.astro";
import Caption from "tsugite/Caption/Caption.astro";
import TextBlock from "tsugite/TextBlock/TextBlock.astro";
import ActionButton from "tsugite/Button/ActionButton.astro";
import AffixField from "tsugite/AffixField/AffixField.astro";

type Sample = {
  key: string;
  component: "Text" | "Heading" | "Caption" | "TextBlock" | "ActionButton" | "Controls";
  props?: Record<string, unknown>;
  label?: string;
  narrow?: true;
};
const samples: Sample[] = [
  { key: "Text sm", component: "Text", props: { size: "sm", text: "One line in body sm" } },
  { key: "Text md", component: "Text", props: { size: "md", text: "One line in body md" } },
  { key: "Text lg", component: "Text", props: { size: "lg", text: "One line in body lg" } },
  { key: "Text md, wrapped", component: "Text", props: { size: "md", text: "Wrapped body md, so the leading between the lines shows" }, narrow: true },
  { key: "Heading 2", component: "Heading", props: { size: "2", text: "A heading in size 2" } },
  { key: "Heading 6", component: "Heading", props: { size: "6", text: "A heading in size 6" } },
  { key: "Display 2", component: "Heading", props: { variant: "display", size: "2", text: "Display 2" } },
  { key: "Heading 3, link", component: "Heading", props: { element: "h3", href: "#TextBox", text: "A heading that is a link" } },
  { key: "Heading 3, wrapped", component: "Heading", props: { element: "h3", text: "A wrapped heading, the leading between its lines" }, narrow: true },
  { key: "Caption label sm", component: "Caption", props: { size: "sm", text: "A hint under a field" } },
  { key: "Caption label md", component: "Caption", props: { text: "A form label" } },
  { key: "Caption button md", component: "Caption", props: { variant: "button", text: "The button voice" } },
  { key: "Caption nav md", component: "Caption", props: { variant: "nav", text: "The nav voice" } },
  { key: "TextBlock preamble md", component: "TextBlock", props: { text: "A standfirst from a field" } },
  { key: "TextBlock body md", component: "TextBlock", props: { variant: "body", text: "A plain field in the body voice" } },
  { key: "TextBlock preamble, two field lines", component: "TextBlock", props: { text: "First line of the field\nSecond line of the field" } },
  { key: "Button sm", component: "ActionButton", props: { size: "sm", emphasis: "secondary" }, label: "Press" },
  { key: "Button md", component: "ActionButton", props: { size: "md", emphasis: "secondary" }, label: "Press" },
  { key: "Button lg", component: "ActionButton", props: { size: "lg", emphasis: "secondary" }, label: "Press" },
  { key: "Button md, wrapped", component: "ActionButton", props: { size: "md", emphasis: "secondary" }, label: "Press this button, please", narrow: true },
  { key: "Button md, icon", component: "ActionButton", props: { size: "md", emphasis: "secondary", icon: "icon-search" }, label: "Search" },
  { key: "Buttons, with and without words", component: "Controls" },
  { key: "A field with a value, a button", component: "Controls" },
  { key: "A field with a placeholder, an icon button", component: "Controls" },
  { key: "Fields with affixes, a button", component: "Controls" },
];
const components = { Text, Heading, Caption, TextBlock, ActionButton };
/** The bench in sections, one per component: rows, then that section's readout. */
const sections = [
  { name: "Text", keys: samples.filter((s) => s.component === "Text") },
  { name: "Heading", keys: samples.filter((s) => s.component === "Heading") },
  { name: "Caption", keys: samples.filter((s) => s.component === "Caption") },
  { name: "TextBlock", keys: samples.filter((s) => s.component === "TextBlock") },
  { name: "Button", keys: samples.filter((s) => s.component === "ActionButton") },
  { name: "Controls", keys: samples.filter((s) => s.component === "Controls") },
];
const sides = ["native", "fallback"] as const;
const forced = (side: (typeof sides)[number]) => (side === "fallback" ? { "data-test-text-box": "fallback" } : {});
---

<div class="TextBoxBench" data-visualize="false" data-show-guides="true" data-show-text-boxes="false">
  <div class="head">
    <div class="column">
      <Heading element="h3" size="4" text="Native — text-box-trim" />
      <Text>
        The browser trims the text's own box to the text: from the top of the capitals on
        the first line to the baseline of the last. No space above the first word, none
        below the last — the line height lives only between the lines.
      </Text>
    </div>
    <div class="column">
      <Heading element="h3" size="4" text="Fallback — negative margins" />
      <Text>
        For a browser without{" "}<code>text-box-trim</code>: the same cut, made from the
        typeface's own metrics. Half the leading is pulled in above and below, then the
        gap above the capitals at the top and the descent at the bottom; the voice's
        baseline offset nudges both. The box stays whole, the margins pull the cell in.
      </Text>
      <pre class="formula" tabindex="0"><code>margin-block-start: ((emBox − lineHeight) / 2 − capGap + baselineOffset) × 1em
margin-block-end:   ((emBox − lineHeight) / 2 − descent − baselineOffset) × 1em</code></pre>
      <Text>
        Deletable by design: the fallback is generated, so when text-box-trim
        reaches the browser floor it leaves in one edit — its two blocks in{" "}
        <code>engine/text-box.js</code>, the forced twin with them — and the native rule
        keeps working as written.
      </Text>
    </div>
  </div>

  <fieldset class="switches">
    <legend class="ScreenReaderText">Bench instruments</legend>
    <ChoiceField type="checkbox" id="bench-guides" name="bench-guides" label="Show guides" checked />
    <ChoiceField type="checkbox" id="bench-text-boxes" name="bench-text-boxes" label="Show text boxes" />
    <ChoiceField type="checkbox" id="bench-visualize" name="bench-visualize" label="Visualize spacing" />
  </fieldset>

  {sections.map((section) => (
    <section class="section" data-section={section.name}>
      <Heading element="h3" size="5" text={section.name} />
      <div class="rows" data-guides>
        {section.keys.map((s) => {
          const Component = s.component === "Controls" ? null : components[s.component];
          return (
            <div class="row" data-sample={s.key}>
              {sides.map((side) => (
                <div class="cell" data-side={side} data-narrow={s.narrow ? "true" : "false"} {...forced(side)}>
                  <Card border={true} padding="none">
                    <Surface theme="neutral" prominence="primary" capInline={false} class="probe">
                      {Component ? (
                        <Component {...s.props}>{s.label}</Component>
                      ) : (
                        <div class="control-line">
                          {s.key === "Buttons, with and without words" && (
                            <>
                              <ActionButton size="md" emphasis="primary" data-control="text, primary">Send</ActionButton>
                              <ActionButton size="md" emphasis="secondary" data-control="text, secondary">Cancel</ActionButton>
                              <ActionButton size="md" emphasis="secondary" icon="icon-search" data-control="text and icon">Search</ActionButton>
                              <ActionButton size="md" emphasis="secondary" icon="icon-search" aria-label="Search" data-control="icon only, secondary" />
                              <ActionButton size="md" emphasis="primary" icon="icon-search" aria-label="Search" data-control="icon only, primary" />
                            </>
                          )}
                          {s.key === "A field with a value, a button" && (
                            <>
                              <AffixField id={`bench-amount-${side}`} label="Amount" root={{ "data-control": "field, value" }} input={{ inputmode: "decimal", value: "1 200" }} />
                              <ActionButton size="md" emphasis="primary" data-control="text, primary">Send</ActionButton>
                            </>
                          )}
                          {s.key === "A field with a placeholder, an icon button" && (
                            <>
                              <AffixField id={`bench-search-${side}`} label="Search" root={{ "data-control": "field, placeholder" }} input={{ type: "search", placeholder: "Search the docs" }} />
                              <ActionButton size="md" emphasis="secondary" icon="icon-search" aria-label="Search" data-control="icon only, secondary" />
                            </>
                          )}
                          {s.key === "Fields with affixes, a button" && (
                            <>
                              <AffixField id={`bench-url-${side}`} label="Address" root={{ "data-control": "field, prefix" }} prefix={{ text: "https://" }} input={{ value: "tsugite.dev" }} />
                              <AffixField id={`bench-price-${side}`} label="Price" root={{ "data-control": "field, suffix" }} suffix={{ text: "SEK" }} input={{ inputmode: "decimal", value: "450" }} />
                              <ActionButton size="md" emphasis="secondary" data-control="text, secondary">Apply</ActionButton>
                            </>
                          )}
                        </div>
                      )}
                    </Surface>
                  </Card>
                </div>
              ))}
            </div>
          );
        })}
      </div>
      <output class="readout" data-readout={section.name} tabindex="0"></output>
    </section>
  ))}

  <section class="section" data-section="Composed">
  <Heading element="h3" size="5" text="Composed" />
  <p class="note">
    Every door stacked as a page would stack them — eyebrow, heading, two paragraphs, an
    inset with its own label, a button, the small print. The guides run from every native
    text box across both cards.
  </p>
  <div class="composed" data-guides>
    {sides.map((side) => (
      <div class="cell" data-side={side} {...forced(side)}>
        <Card element="article" border={true} padding="none">
        <Surface theme="neutral" prominence="primary" capInline={false} class="card">
          <div class="stack">
            <Caption size="sm" text="For your team" />
            <Heading element="h3" size="3" text="Your trial ends on Friday" />
            <Text text="Your project is ready to go live, and the plan you are on keeps it running until the end of the week." />
            <Text text="Here is a code for the first month of the next plan. It works on every plan above it, in any currency." />
            <Card class="inset" border={true} padding="md">
              <div class="stack tight">
                <Caption size="sm" text="Your personal code" />
                <Text text="TRIAL-20-K7QX takes the first month off any plan above the one you have. It works once." />
              </div>
            </Card>
            <div>
              <ActionButton size="md" emphasis="primary">Claim the month</ActionButton>
            </div>
            <Text size="sm" text="The code is personal to this account, works once, and cannot be combined with another offer." />
          </div>
        </Surface>
        </Card>
      </div>
    ))}
  </div>
  <output class="readout" data-readout="Composed" tabindex="0"></output>
  </section>
</div>

<script>
  const px = (n: number) => `${n.toFixed(2)}px`;

  /** A readout as a plain-text table: columns padded to their widest cell, a rule under the head. */
  function tabulate(rows: string[][]) {
    const widths = rows[0].map((_, c) => Math.max(...rows.map((r) => r[c].length)));
    const line = (r: string[]) => r.map((cell, c) => cell.padEnd(widths[c])).join("   ").trimEnd();
    return [line(rows[0]), widths.map((w) => "─".repeat(w)).join("   "), ...rows.slice(1).map(line)].join("\n");
  }

  /** An empty inline-block at the end of a text: its bottom edge is the last baseline. */
  function baselineMark(text: HTMLElement) {
    let mark = text.querySelector<HTMLElement>(":scope > [data-baseline-mark]");
    if (!mark) {
      mark = document.createElement("span");
      mark.dataset.baselineMark = "";
      mark.setAttribute("aria-hidden", "true");
      Object.assign(mark.style, { display: "inline-block", inlineSize: "0", blockSize: "0" });
      text.append(mark);
    }
    return mark;
  }

  /** The native side's text boxes — cap line and last baseline — and, in the controls row,
      each control's outer box, drawn across the whole block so the fallback side is read
      against them. */
  function drawGuides(block: HTMLElement) {
    block.querySelectorAll(":scope > .guide").forEach((g) => g.remove());
    const top = block.getBoundingClientRect().top;
    const edges: number[] = [];
    for (const text of block.querySelectorAll<HTMLElement>('[data-side="native"] [data-text-box="block"] > .text')) {
      edges.push(text.getBoundingClientRect().top, baselineMark(text).getBoundingClientRect().bottom);
    }
    for (const control of block.querySelectorAll<HTMLElement>('[data-side="native"] [data-control]')) {
      const r = control.getBoundingClientRect();
      edges.push(r.top, r.bottom);
    }
    for (const y of edges) {
      const g = document.createElement("div");
      g.className = "guide";
      g.setAttribute("aria-hidden", "true");
      g.style.insetBlockStart = `${y - top}px`;
      block.append(g);
    }
  }

  function measure(bench: HTMLElement) {
    // The two branches trim differently: native shrinks the text's own box, the fallback
    // pulls the cell in with negative margins and leaves the box whole. So the readout is
    // what the cell gets — the footprint — and where the last baseline sits in it. An
    // icon-only button has no text, so its row reads the footprint only.
    const read = (row: HTMLElement, side: string) => {
      const probe = row.querySelector<HTMLElement>(`[data-side="${side}"] .probe`)!;
      const text = probe.querySelector<HTMLElement>(":scope > .content > * > .text");
      const p = probe.getBoundingClientRect();
      const cs = getComputedStyle(probe);
      const pad = parseFloat(cs.paddingBlockStart) + parseFloat(cs.paddingBlockEnd) + parseFloat(cs.borderBlockStartWidth) + parseFloat(cs.borderBlockEndWidth);
      const contentBottom = p.bottom - parseFloat(cs.paddingBlockEnd) - parseFloat(cs.borderBlockEndWidth);
      return {
        footprint: p.height - pad,
        baseline: text ? contentBottom - baselineMark(text).getBoundingClientRect().bottom : null,
      };
    };

    const write = (section: string, table: string[][]) => {
      bench.querySelector<HTMLOutputElement>(`output[data-readout="${section}"]`)!.textContent = tabulate(table);
    };

    for (const section of bench.querySelectorAll<HTMLElement>(".section[data-section]")) {
      const name = section.dataset.section!;
      if (name === "Controls" || name === "Composed") continue;
      const table = [["sample", "footprint native / fallback", "Δ", "last baseline native / fallback"]];
      for (const row of section.querySelectorAll<HTMLElement>(".row")) {
        const n = read(row, "native");
        const f = read(row, "fallback");
        const baseline = n.baseline === null || f.baseline === null ? "—" : `${px(n.baseline)} / ${px(f.baseline)}`;
        table.push([row.dataset.sample!, `${px(n.footprint)} / ${px(f.footprint)}`, px(n.footprint - f.footprint), baseline]);
      }
      write(name, table);
    }

    // One height for every md control in a line: each control's outer height, native /
    // fallback, named by its data-control word.
    const controlRows = [["line", "control", "height native / fallback"]];
    for (const row of bench.querySelectorAll<HTMLElement>('.section[data-section="Controls"] .row')) {
      const heights = (side: string) =>
        [...row.querySelectorAll<HTMLElement>(`[data-side="${side}"] [data-control]`)].map((el) => [el.dataset.control!, px(el.getBoundingClientRect().height)]);
      const n = heights("native");
      const f = heights("fallback");
      n.forEach(([control, h], i) => controlRows.push([i === 0 ? row.dataset.sample! : "", control, `${h} / ${f[i][1]}`]));
    }
    write("Controls", controlRows);

    // The composed card: how far the fallback's stack has slid by its last baseline.
    const cardEnd = (side: string) => {
      const card = bench.querySelector<HTMLElement>(`.composed [data-side="${side}"] .card`)!;
      const texts = card.querySelectorAll<HTMLElement>('[data-text-box="block"] > .text');
      const c = card.getBoundingClientRect();
      return { height: c.height, baseline: baselineMark(texts[texts.length - 1]).getBoundingClientRect().bottom - c.top };
    };
    const cn = cardEnd("native");
    const cf = cardEnd("fallback");
    write("Composed", [
      ["", "native / fallback", "Δ"],
      ["card height", `${px(cn.height)} / ${px(cf.height)}`, px(cn.height - cf.height)],
      ["last baseline from the card's top", `${px(cn.baseline)} / ${px(cf.baseline)}`, px(cn.baseline - cf.baseline)],
    ]);

    bench.querySelectorAll<HTMLElement>("[data-guides]").forEach(drawGuides);
  }

  function run() {
    document.querySelectorAll<HTMLElement>(".TextBoxBench").forEach(measure);
  }

  // The two switches write the bench's state; the CSS reads it.
  for (const bench of document.querySelectorAll<HTMLElement>(".TextBoxBench")) {
    const bind = (id: string, attr: "visualize" | "showGuides" | "showTextBoxes") => {
      const box = bench.querySelector<HTMLInputElement>(`#${id}`)!;
      const write = () => (bench.dataset[attr] = box.checked ? "true" : "false");
      box.addEventListener("change", write);
      write();
    };
    bind("bench-guides", "showGuides");
    bind("bench-text-boxes", "showTextBoxes");
    bind("bench-visualize", "visualize");
  }

  run();
  addEventListener("resize", run);
  document.fonts?.ready.then(run);
</script>

<style>
  .TextBoxBench {
    display: grid;
    gap: var(--size-md);

    /* The instruments, framed like the resolution panel's cells. */
    & .switches {
      display: flex;
      flex-wrap: wrap;
      gap: var(--size-lg);
      margin: 0;
      padding: var(--size-lg) var(--size-md);
      border: 1px solid var(--color-border-subtle);
      border-radius: var(--size-sm);
    }

    /* The fallback's two margins, one formula a line, never wrapped. */
    & .formula {
      margin: 0;
      overflow-x: auto;
      padding: var(--size-md);
      border: 1px solid var(--color-border-subtle);
      background: var(--color-surface-page);
      font-family: var(--fontFamily-code);
      font-size: var(--fontSize-label-small);
    }

    & .note {
      margin: 0;
      color: var(--color-text-secondary);
      font-size: var(--fontSize-label);
    }

    & .head,
    & .row,
    & .composed {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--size-md);
    }

    & .column {
      display: grid;
      gap: var(--size-md);
      align-content: start;
    }

    & .rows {
      display: grid;
      gap: var(--size-sm);
    }

    & .rows,
    & .composed {
      position: relative;
    }

    & .cell {
      min-inline-size: 0;
    }

    & .cell[data-narrow="true"] {
      max-inline-size: 14rem;
    }

    /* Surface is built for page bands (2xl block, the site offset inline); inside a bench
       Card it is the card's inset, so the bench sets the Surface's own knobs on its root
       (ADR-0013 §3). */
    & .probe {
      --_sf-paddingBlock: var(--size-md);
      --_sf-paddingInline: var(--size-md);
    }

    & .card {
      --_sf-paddingBlock: var(--size-lg);
      --_sf-paddingInline: var(--size-lg);
    }

    /* "Show text boxes": the outline is the text's box, what the engine trimmed. The parts
       are rendered by the components inside, so they carry no scope attribute of this file. */
    &[data-show-text-boxes="true"] .cell :global([data-text-box="block"] > .text) {
      outline: 1px dashed var(--bench-textbox);
    }

    & .control-line {
      display: flex;
      flex-wrap: wrap;
      gap: var(--size-sm);
      align-items: center;
    }

    & .stack {
      display: flex;
      flex-direction: column;
      gap: var(--size-md);
    }

    & .stack.tight {
      gap: var(--size-sm);
    }

    /* The guides are drawn by the script, so they carry no scope attribute. */
    & :global(.guide) {
      position: absolute;
      inset-inline: 0;
      border-block-start: 1px dashed var(--bench-guide);
      pointer-events: none;
    }

    &[data-show-guides="false"] :global(.guide) {
      display: none;
    }

    /* Visualize spacing: a container's padding green, the gaps between its children pink,
       each component's own box white — a slide shows as colour that does not line up. */
    &[data-visualize="true"] {
      & .probe,
      & .card,
      & .inset {
        background: var(--bench-gap);
      }

      & .probe,
      & .inset {
        box-shadow: inset 0 0 0 var(--size-md) var(--bench-padding);
      }

      & .card {
        box-shadow: inset 0 0 0 var(--size-lg) var(--bench-padding);
      }

      & .probe > :global(.content > :not(.control-line)),
      & .control-line :global([data-control]),
      & .stack > :global(:not(.inset)),
      & .inset .stack > :global(*) {
        background: var(--bench-content);
      }
    }

    & .section {
      display: grid;
      gap: var(--size-md);
    }

    /* A section's readout: the measured numbers as a plain-text table under its rows. */
    & .readout {
      display: block;
      overflow-x: auto;
      padding: var(--size-md);
      border: 1px solid var(--color-border-subtle);
      background: var(--color-surface-page);
      white-space: pre;
      font-family: var(--fontFamily-code);
      font-size: var(--fontSize-label-small);
    }
  }
</style>
