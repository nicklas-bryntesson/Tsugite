---
// ResolutionBar — the live readout strip: what THIS window resolves to,
// right now. Indicators are read-only (appearance × contrast cell,
// viewport tier, width); the one control is the type-scale spoof, which
// steps --TYPE-SCALE on :root the way Chrome's font-size setting steps
// its ladder (Small ×0.75 … plus ×2 as a stress stop). The Header's
// ThemeSwitch stays the only appearance control — this bar never writes
// data-appearance. Contrast cannot be spoofed from here: that branch is
// media-keyed only (a logged upstream finding, not an app workaround).
---

<aside class="ResolutionBar grid-container" aria-label="Resolution readout">
  <div class="rb-strip">
    <ul class="rb-readouts">
      <li><span class="rb-name">appearance</span> <output class="rb-value" data-readout="appearance"></output></li>
      <li><span class="rb-name">contrast</span> <output class="rb-value" data-readout="contrast"></output></li>
      <li><span class="rb-name">tier</span> <output class="rb-value" data-readout="tier"></output></li>
      <li><span class="rb-name">width</span> <output class="rb-value" data-readout="width"></output></li>
    </ul>
    <label class="rb-scale">
      <span class="rb-name">type scale</span>
      <select data-control="type-scale">
        <option value="0.75">Small ×0.75</option>
        <option value="1" selected>Medium ×1</option>
        <option value="1.25">Large ×1.25</option>
        <option value="1.5">Very large ×1.5</option>
        <option value="2">×2</option>
      </select>
    </label>
  </div>
</aside>

<script>
  const root = document.documentElement;
  const set = (readout: string, value: string) => {
    const out = document.querySelector<HTMLElement>(`[data-readout="${readout}"]`);
    if (out) out.textContent = value;
  };

  // Appearance: a data-appearance attribute is a pinned user override
  // (ThemeSwitch, ADR-0021); absence means the OS decides.
  const darkQuery = matchMedia("(prefers-color-scheme: dark)");
  const readAppearance = () => {
    const pinned = root.getAttribute("data-appearance");
    set(
      "appearance",
      pinned ? `${pinned} (pinned)` : `${darkQuery.matches ? "dark" : "light"} (system)`,
    );
  };
  readAppearance();
  darkQuery.addEventListener("change", readAppearance);
  new MutationObserver(readAppearance).observe(root, {
    attributes: true,
    attributeFilter: ["data-appearance"],
  });

  // Contrast: media-keyed only — readable, not spoofable from the app.
  const contrastQuery = matchMedia("(prefers-contrast: more)");
  const readContrast = () =>
    set("contrast", contrastQuery.matches ? "more" : "no-preference");
  readContrast();
  contrastQuery.addEventListener("change", readContrast);

  // Tier: the same bounded ranges as the token ramps (ADR-0001).
  const tiers: Array<[string, MediaQueryList]> = [
    ["FLOOR", matchMedia("(max-width: 21.24999rem)")],
    ["MOBILE", matchMedia("(min-width: 21.25rem) and (max-width: 48.74rem)")],
    ["DESKTOP", matchMedia("(min-width: 48.75rem) and (max-width: 89.99rem)")],
    ["WIDE", matchMedia("(min-width: 90rem)")],
  ];
  const readTier = () => {
    const hit = tiers.find(([, mq]) => mq.matches);
    set("tier", hit ? hit[0] : "unknown");
  };
  readTier();
  for (const [, mq] of tiers) mq.addEventListener("change", readTier);

  const readWidth = () => set("width", `${window.innerWidth}px`);
  readWidth();
  window.addEventListener("resize", readWidth);

  // Type scale: every fontSize token is FLOOR × --TYPE-SCALE, so one
  // :root override scales the whole ramp and composes with the tier
  // stops. ×1 removes the override — the authored default is the truth.
  const scale = document.querySelector<HTMLSelectElement>('[data-control="type-scale"]');
  scale?.addEventListener("change", () => {
    if (scale.value === "1") root.style.removeProperty("--TYPE-SCALE");
    else root.style.setProperty("--TYPE-SCALE", scale.value);
  });
</script>

<style is:global>
.ResolutionBar {
  background-color: var(--color-surface-chrome);
  border-block-end: 1px solid var(--color-border-subtle);

  & .rb-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 0.5rem;
  }

  & .rb-readouts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }

  & .rb-readouts li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  & .rb-name {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  & .rb-value {
    font-family: var(--MONOSPACE);
    font-size: 0.8rem;
    color: var(--color-text-primary);
  }

  & .rb-scale {
    display: flex;
    align-items: center;
    gap: 0.5rem;

    & select {
      font: inherit;
      font-size: 0.8rem;
      color: var(--color-text-primary);
      background-color: var(--color-surface-inset);
      border: 1px solid var(--color-border-subtle);
      border-radius: 0.25rem;
      padding: 0.125rem 0.375rem;
    }
  }
}
</style>
