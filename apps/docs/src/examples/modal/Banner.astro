---
import Modal from "tsugite/Modal/Modal.astro";
import ActionButton from "tsugite/Button/ActionButton.astro";
import Card from "tsugite/Card/Card.astro";
import Surface from "tsugite/Surface/Surface.astro";
import Heading from "tsugite/Heading/Heading.astro";
import Text from "tsugite/Text/Text.astro";
---
<ActionButton emphasis="secondary" command="show-modal" commandfor="consent">Show the banner</ActionButton>

<Modal id="consent" dismiss="none">
  <Card padding="none" style="align-self: end">
    <Surface>
      <Heading text="Cookies" data-channel="title" />
      <Text text="We remember your choices." data-channel="description" />
      <ActionButton data-channel="close" value="accept">Accept</ActionButton>
      <ActionButton emphasis="secondary" data-channel="close" value="reject">Reject</ActionButton>
    </Surface>
  </Card>
</Modal>
