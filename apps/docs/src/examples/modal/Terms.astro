---
import Modal from "tsugite/Modal/Modal.astro";
import ActionButton from "tsugite/Button/ActionButton.astro";
import Card from "tsugite/Card/Card.astro";
import Surface from "tsugite/Surface/Surface.astro";
import Heading from "tsugite/Heading/Heading.astro";
import Text from "tsugite/Text/Text.astro";
---
<ActionButton emphasis="secondary" command="show-modal" commandfor="terms-of-use">Read the terms</ActionButton>

<Modal id="terms-of-use" dismiss="any">
  <Card padding="none" style="justify-self: center">
    <Surface>
      <Heading text="Terms" data-channel="title" />
      {Array.from({ length: 20 }, (_, i) => <Text text={`Section ${i + 1}. Long enough to be taller than the window.`} />)}
      <ActionButton data-channel="close" value="read">Done</ActionButton>
    </Surface>
  </Card>
</Modal>
