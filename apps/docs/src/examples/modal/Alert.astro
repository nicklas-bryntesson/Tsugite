---
import Modal from "tsugite/Modal/Modal.astro";
import ActionButton from "tsugite/Button/ActionButton.astro";
import Card from "tsugite/Card/Card.astro";
import Surface from "tsugite/Surface/Surface.astro";
import Heading from "tsugite/Heading/Heading.astro";
---
<ActionButton intent="destructive" command="show-modal" commandfor="delete">Delete everything</ActionButton>

<Modal id="delete" role="alertdialog" dismiss="none">
  <Card padding="none" style="justify-self: center">
    <Surface>
      <Heading text="Delete everything?" data-channel="title" />
      <ActionButton intent="destructive" data-channel="close" value="delete">Delete</ActionButton>
      <ActionButton emphasis="secondary" data-channel="close" value="cancel">Cancel</ActionButton>
    </Surface>
  </Card>
</Modal>
