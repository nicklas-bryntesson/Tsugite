---
import Modal from "tsugite/Modal/Modal.astro";
import ActionButton from "tsugite/Button/ActionButton.astro";
import Card from "tsugite/Card/Card.astro";
import Surface from "tsugite/Surface/Surface.astro";
import Heading from "tsugite/Heading/Heading.astro";
---
<ActionButton emphasis="secondary" command="show-modal" commandfor="welcome">Open in Swedish</ActionButton>

<Modal id="welcome">
  <Card padding="none" style="justify-self: center" lang="sv">
    <Surface>
      <Heading text="Välkommen tillbaka" data-channel="title" />
      <ActionButton data-channel="close" value="ok">Stäng</ActionButton>
    </Surface>
  </Card>
</Modal>
