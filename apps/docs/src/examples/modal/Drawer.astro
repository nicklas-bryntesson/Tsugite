---
import Modal from "tsugite/Modal/Modal.astro";
import ActionButton from "tsugite/Button/ActionButton.astro";
import Card from "tsugite/Card/Card.astro";
import Surface from "tsugite/Surface/Surface.astro";
import Heading from "tsugite/Heading/Heading.astro";
---
<ActionButton emphasis="secondary" command="show-modal" commandfor="filters">Filters</ActionButton>

<Modal id="filters" dismiss="any">
  <Card padding="none" style="justify-self: end; align-self: stretch; inline-size: 24rem">
    <Surface>
      <Heading text="Filters" data-channel="title" />
      <ActionButton emphasis="secondary" data-channel="close" value="done">Done</ActionButton>
    </Surface>
  </Card>
</Modal>
