---
import TextBlock from "tsugite/components/TextBlock/TextBlock.astro";
---
{/* The body voice, for a plain field that is not a standfirst. One door per
    look: an authored single-run body text is Text; a body-voiced BLOCK from
    a plain field is TextBlock. */}
<TextBlock variant="body" text="Body lg — a description field, read at the large step." size="lg" />
<TextBlock variant="body" text="Body md — the everyday description field." />
<TextBlock variant="body" text="Body sm — a footnote field, or the fine print." size="sm" />
