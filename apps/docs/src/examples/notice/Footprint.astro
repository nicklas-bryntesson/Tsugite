---
import Notice from "tsugite/components/Notice/Notice.astro";
---
{/* Two booleans on the inline axis (ADR-0015). grow: may it take more room than its
    content; cap: is there a reading ceiling. Default is grow + cap. */}
<Notice variant="success" growInline={false} capInline={false} title="Saved">
  <p>Natural width, no ceiling.</p>
</Notice>
<Notice variant="info" growInline={false} title="Natural width, capped">
  <p>A long message shrinks to its text but wraps at the reading ceiling instead of running on across the whole page.</p>
</Notice>
<Notice variant="error" capInline={false} title="Three fields need attention">
  <p>A validation summary fills the form it belongs to, whatever its width.</p>
</Notice>
