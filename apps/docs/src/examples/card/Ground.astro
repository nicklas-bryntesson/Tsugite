---
import Card from "tsugite/Card/Card.astro";
import Surface from "tsugite/Surface/Surface.astro";
import Text from "tsugite/Text/Text.astro";

const grounds = [
  { theme: "neutral", prominence: "subtle" },
  { theme: "inverse", prominence: "primary" },
];
const cards = [
  { theme: undefined, prominence: undefined, text: "No voice of its own: the card is its ground's colour, and both tones are the ground's." },
  { theme: "brand", prominence: "primary", text: "Brand on this ground: the ground's ink, and a glow of brand." },
  { theme: "accent", prominence: "primary", text: "Accent on this ground: the ground's ink, and a glow of accent." },
];
---
{/* A card's shadow mixes two tones. The first is the ground's ink, published by the
    Surface the card lies on. The second is a glow of the card's own surface, through the
    valves of the voice it speaks — per mode, turned down in dark. Here the voice is
    claimed on the card itself (data-theme, data-prominence); whether Card takes them as
    props is still open. A card whose voice lives on a Surface inside it glows with its
    ground's tone, since a card cannot read what lies inside it. */}
{grounds.map((ground) => (
  <Surface theme={ground.theme} prominence={ground.prominence} capInline={false}>
    {cards.map(({ theme, prominence, text }) => (
      <Card elevation="md" data-theme={theme} data-prominence={prominence}>
        <Text text={text} />
      </Card>
    ))}
  </Surface>
))}
