---
import Card from "tsugite/Card/Card.astro";
import Surface from "tsugite/Surface/Surface.astro";
import Text from "tsugite/Text/Text.astro";

const grounds = [
  { theme: "neutral", prominence: "subtle" },
  { theme: "brand", prominence: "subtle" },
  { theme: "accent", prominence: "subtle" },
  { theme: "inverse", prominence: "primary" },
];
---
{/* The shadow's first layer: the ink of the Surface the card lies on. The last card
    speaks brand on a neutral ground and still casts neutral's ink — the ground's shadow is
    resolved on the ground, and the card's own voice cannot repaint it. The second layer,
    the card's own tone mixed in, is not built yet. */}
{grounds.map(({ theme, prominence }) => (
  <Surface theme={theme} prominence={prominence} capInline={false}>
    <Card elevation="md" padding="none">
      <Surface theme="neutral" prominence="primary" capInline={false}>
        <Text text={`On ${theme} · ${prominence}: the shadow is this ground's ink.`} />
      </Surface>
    </Card>
  </Surface>
))}
<Surface theme="neutral" prominence="subtle" capInline={false}>
  <Card elevation="md" padding="none">
    <Surface theme="brand" prominence="primary" capInline={false}>
      <Text text="A brand card on neutral · subtle casts neutral's shadow, not its own." />
    </Surface>
  </Card>
</Surface>
