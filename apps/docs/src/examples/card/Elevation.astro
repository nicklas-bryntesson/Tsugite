---
import Card from "tsugite/components/Card/Card.astro";
import Text from "tsugite/components/Text/Text.astro";
---
{/* Three steps of shadow. The attribute is only written when asked for —
    a card without an elevation prop carries no data-elevation at all. */}
<Card elevation="sm">
  <Text text="elevation sm — barely lifted." />
</Card>
<Card elevation="md">
  <Text text="elevation md — clearly off the page." />
</Card>
<Card elevation="lg">
  <Text text="elevation lg — floating." />
</Card>
