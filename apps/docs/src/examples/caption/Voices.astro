---
import Caption from "tsugite/components/Caption/Caption.astro";
---
{/* Two UI voices, three steps each. label marks the interface up; button is the
    pressable voice, which Button reads as tokens — here it speaks standalone. */}
<Caption element="p" text="Label lg — a field group's title" size="lg" />
<Caption element="p" text="Label md — a form label, a table header" />
<Caption element="p" text="Label sm — a hint, a helper line under a field" size="sm" />
<Caption element="p" variant="button" text="Button lg — the pressable voice, standalone" size="lg" />
<Caption element="p" variant="button" text="Button md — same tokens Button.css reads" />
<Caption element="p" variant="button" text="Button sm" size="sm" />
