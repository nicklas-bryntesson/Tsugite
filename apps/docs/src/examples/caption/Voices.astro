---
import Caption from "tsugite/Caption/Caption.astro";
---
{/* Three UI voices, three steps each. label marks the interface up; button is the
    pressable voice; nav is the wayfinding voice. The controls read them as tokens —
    here they speak standalone. Same values in this theme, separate knobs. */}
<Caption element="p" text="Label lg — a field group's title" size="lg" />
<Caption element="p" text="Label md — a form label, a table header" />
<Caption element="p" text="Label sm — a hint, a helper line under a field" size="sm" />
<Caption element="p" variant="button" text="Button lg — the pressable voice, standalone" size="lg" />
<Caption element="p" variant="button" text="Button md — same tokens Button.css reads" />
<Caption element="p" variant="button" text="Button sm" size="sm" />
<Caption element="p" variant="nav" text="Nav lg — the wayfinding voice, standalone" size="lg" />
<Caption element="p" variant="nav" text="Nav md — what the navigation items read" />
<Caption element="p" variant="nav" text="Nav sm" size="sm" />
