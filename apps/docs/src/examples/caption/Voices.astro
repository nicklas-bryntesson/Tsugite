---
import Text from "tsugite/components/Text/Text.astro";
---
{/* The second quiet voice. label runs on the UI face (Inter) where body
    runs on the reading face (Noto Serif) — same three steps. */}
<Text text="Label lg — a field group's title" variant="label" size="lg" />
<Text text="Label md — a form label, a table header" variant="label" />
<Text text="Label sm — a hint, a helper line under a field" variant="label" size="sm" />
