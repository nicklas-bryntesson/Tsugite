---
import Heading from "tsugite/components/Heading/Heading.astro";
---
{/* The element is the document outline; the size is the visual step.
    They are independent: an h2 can look like size 4 when the layout asks for it. */}
<Heading text="An h2 at size 2 (the default: element decides size)" element="h2" />
<Heading text="An h2 at size 4 — same outline level, quieter" element="h2" size="4" />
<Heading text="An h3 at size 1 — a deep heading that leads a hero" element="h3" size="1" />
