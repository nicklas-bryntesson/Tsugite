---
import Heading from "tsugite/components/Heading/Heading.astro";
---
{/* The quiet voice on heading-shaped elements — a heading that should read
    like body text. legend and figcaption are in this farm too. */}
<Heading text="A body-voiced h3, size lg" element="h3" variant="body" size="lg" />
<Heading text="A body-voiced h4, size md" element="h4" variant="body" size="md" />
<fieldset>
  <Heading text="A legend in the body voice" element="legend" variant="body" size="md" />
  <p>Fieldset content.</p>
</fieldset>
