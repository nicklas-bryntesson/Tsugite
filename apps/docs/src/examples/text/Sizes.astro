---
import Text from "tsugite/components/Text/Text.astro";
---
{/* The body voice has three steps. md is the default; the element never
    decides the size here — a p, span or div all start at md. */}
<Text text="Size lg — a lead paragraph, a standfirst under a heading" size="lg" />
<Text text="Size md — the default; the everyday reading size" />
<Text text="Size sm — a footnote, a byline, a timestamp" size="sm" />
