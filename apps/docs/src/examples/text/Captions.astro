---
import Text from "tsugite/components/Text/Text.astro";
---
{/* The element is the semantics, the voice is the look, and the two never force each
    other. A nested fieldset in a wizard binds its group with a legend; that legend may
    look like a label. A figure's caption may read like body. A form label speaks the
    label voice on the element that is actually a label. */}
<fieldset>
  <Text element="legend" variant="label" text="Contact details" />
  <Text element="label" variant="label" size="sm" text="Email" for="captions-email" />
  <input id="captions-email" type="email" />
</fieldset>
<figure>
  <Text element="figcaption" text="A caption in the body voice, on the element a caption is." />
</figure>
