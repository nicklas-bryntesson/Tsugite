---
import Text from "tsugite/components/Text/Text.astro";
import Caption from "tsugite/components/Caption/Caption.astro";
---
{/* Two voices on one line: a body-voiced block host with a label-voiced
    inline run (Caption) at its start. Each run resolves its own bundle; the line
    negotiates the baseline. */}
<Text element="p" variant="body" size="lg">
  <Caption element="span" size="lg" text="Found a mistake?" /> Let us know.
</Text>
