---
import NavLink from "tsugite/components/NavItem/NavLink.astro";
import NavButton from "tsugite/components/NavItem/NavButton.astro";
---
{/* The element is the gate (ADR-0019). A link given `expanded` is refused: only a button
    opens a disclosure. A button given `href` is refused: a button goes nowhere. Both show
    in development and render nothing in production. */}
<NavLink href="#" expanded={true}>A link cannot expand</NavLink>
<NavButton href="#">A button goes nowhere</NavButton>
