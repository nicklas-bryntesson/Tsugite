---
import CtaLinkButton from "tsugite/components/CtaButton/CtaLinkButton.astro";
---
{/* Three sizes of the button voice; everything else is em, so the sheen, the shadow and
    the padding scale with the words. */}
<div style="display: flex; flex-wrap: wrap; gap: var(--size-md); padding-block-end: 2.5em;">
  <CtaLinkButton href="#" size="md">Medium</CtaLinkButton>
  <CtaLinkButton href="#" size="lg">Large</CtaLinkButton>
  <CtaLinkButton href="#" size="jumbo">Jumbo</CtaLinkButton>
</div>
