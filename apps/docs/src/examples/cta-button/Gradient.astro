---
import CtaLinkButton from "tsugite/CtaButton/CtaLinkButton.astro";
---
{/* The first variant: a sweep through four semantic stops — indigo, onsen water, cypress,
    amber — a sheen along the top, and the same sweep cast as a shadow toward the viewer.
    Hover lifts it and hurries the sweep; reduced motion stills both. */}
<div style="display: flex; flex-wrap: wrap; gap: var(--size-md); padding-block-end: 2.5em;">
  <CtaLinkButton href="#" size="jumbo">Click me!</CtaLinkButton>
</div>
