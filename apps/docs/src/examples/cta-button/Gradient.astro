---
import CtaLinkButton from "tsugite/CtaButton/CtaLinkButton.astro";
---
{/* The first variant: a sweep through four semantic stops, all in the blue — indigo,
    deeper indigo, deep onsen water, the deepest indigo — a sheen along the top, and the same sweep cast as a shadow toward the viewer.
    Hover lifts it and hurries the sweep; reduced motion stills both. */}
<div style="display: flex; flex-wrap: wrap; gap: var(--size-md); padding-block-end: 2.5em;">
  <CtaLinkButton href="#" size="lg">Click me!</CtaLinkButton>
</div>
