---
// /lab/grid — a stage between the site's header and footer for spoofing the content
// blocks a content-heavy front page is made of. Not on the map, not a docs page.
//
// The blocks below were lifted from another Astro project (stealing/) and converted
// to this system's form: page bands are Surfaces (voice, rhythm, adjacency collapse
// for free), every axis is a data-* word with a gate per value, every var() is a
// registry name, and no rule names another component's class. What could not be
// converted without a decision carries a TODO(lab).
import Layout from "../../layouts/Layout.astro";
import Surface from "tsugite/components/Surface/Surface.astro";
import Heading from "tsugite/components/Heading/Heading.astro";
import Prose from "tsugite/components/Prose/Prose.astro";
import LinkButton from "tsugite/components/Button/LinkButton.astro";
import Quote from "tsugite/components/Quote/Quote.astro";
import QuoteReact from "tsugite/components/Quote/Quote.tsx";
import amal from "tsugite/fixtures/media/amal-s.jpg";
import david from "tsugite/fixtures/media/david-becker.jpg";
import jean from "tsugite/fixtures/media/jean-philippe.jpg";
---

<Layout title="Grid lab">
  <main class="GridLab">

    {/* 1. Prose beside media, on the container grid: text in the main column, media
        may break out. The draft §6 composition without a name yet. */}
    <Surface element="section" theme="neutral" capInline={false}>
      <div class="ProseWithMedia grid-container" data-media-side="end" data-media-ratio="landscape" data-text-valign="start">
        <article class="text">
          <Heading element="h2" size="2" text="Prose beside media" />
          <Prose variant="basic">
            <p>The text sits in the main column; the media takes the outer half of the breakout. Flip <code>data-media-side</code> to move it.</p>
          </Prose>
        </article>
        <figure class="media">
          <img src={amal.src} width={amal.width} height={amal.height} alt="" loading="lazy" />
        </figure>
      </div>
    </Surface>

    {/* 2. CTA on the breakout grid: 14 tracks, text 2–8, media 8–14. */}
    <Surface element="section" theme="brand" capInline={false}>
      <div class="CtaWithMedia grid-breakout" data-media-side="end">
        <div class="text">
          <Heading element="h2" size="3" text="Find the answer to your question" />
          <Prose variant="basic">
            <p>We collected the questions teachers ask most. Someone may already have asked yours.</p>
          </Prose>
          <div class="actions">
            <LinkButton href="#">Search questions</LinkButton>
            <LinkButton href="#" emphasis="secondary">Contact us</LinkButton>
          </div>
        </div>
        <figure class="media">
          <img src={david.src} width={david.width} height={david.height} alt="" loading="lazy" />
        </figure>
      </div>
    </Surface>

    {/* 3. A testimonial: Quote, large words and a portrait, on a brand · subtle band.
        The band is the host; Quote lays itself out from its own width. */}
    <Surface element="section" theme="brand" prominence="subtle">
      <Quote id="lab-testimonial" size="lg" source="Sarah Johnson, Acme Corp" image={jean} alt="Portrait of Sarah Johnson"
        quote="Working with this team completely transformed our digital presence. The results exceeded every expectation we had." />
    </Surface>

    {/* 4. Three-up on the layout grid, same voice as the previous band: the second
        Surface drops its start padding (generated adjacency, ADR-0016). */}
    <Surface element="section" theme="brand" prominence="subtle" capInline={false}>
      <div class="ThreeUp grid-layout">
        <div class="lab-block" data-label="span 4">a</div>
        <div class="lab-block" data-label="span 4">b</div>
        <div class="lab-block" data-label="span 4">c</div>
      </div>
    </Surface>

    {/* 5. A pull quote in the flow: an RTE block, no band of its own, the page ground. */}
    <Surface element="section">
      <Quote id="lab-pullquote" source="Aldous Huxley" image={amal} alt="">
        <p>Words can be like X-rays, if you use them properly — they'll go through anything. You read and you're pierced.</p>
      </Quote>
    </Surface>

    {/* 5b. The same quote twice: rendered by Quote.astro and by Quote.tsx, one recipe,
        one CSS (ADR-0017). React renders on the server, nothing hydrates. */}
    <Surface element="section" theme="neutral" prominence="subtle">
      <div class="Renderers">
        <Quote id="lab-astro" data-renderer="astro" source="Rendered by Quote.astro" image={david} alt=""
          quote="The contract is the rendered DOM. Whoever writes it is an adapter." />
        <QuoteReact id="lab-react" data-renderer="react" source="Rendered by Quote.tsx" image={{ src: david.src, width: david.width, height: david.height }} alt=""
          quote="The contract is the rendered DOM. Whoever writes it is an adapter." />
      </div>
    </Surface>

    {/* 6. A CTA aside: heading, prose, two actions. */}
    <Surface element="aside" theme="accent">
      <div class="CtaAside">
        <Heading element="h3" size="3" text="Let's talk" />
        <Prose variant="basic">
          <p>We'd love to hear about your project. Drop us a line and we'll get back to you within 24 hours.</p>
        </Prose>
        <div class="actions">
          <LinkButton href="/contact">Get in touch</LinkButton>
          <LinkButton href="/book" emphasis="secondary">Book a call</LinkButton>
        </div>
      </div>
    </Surface>

    {/* 7. Text with image: the draft §6 axes as written — layout, media side, media
        ratio, text valign — on the layout grid (wide) or the breakout grid (full). */}
    <Surface element="section" capInline={false}>
      <div class="TextWithMedia" data-layout="wide" data-media-side="start" data-media-ratio="portrait" data-text-valign="start">
        <div class="text">
          <Heading element="h2" size="2" text="Text with image" />
          <Prose variant="basic">
            <p>Lorem ipsum dolor sit amet. Sed sunt accusantium et quae galisum ea consequatur veritatis est dolorem omnis id sequi exercitationem. Ut beatae quod et corporis nobis, reiciendis galisum est error ipsum.</p>
            <p>More text.</p>
          </Prose>
          <div class="actions">
            <LinkButton href="/">CTA Button</LinkButton>
            <LinkButton href="/" emphasis="secondary">CTA Button</LinkButton>
          </div>
        </div>
        <figure class="media grid-stack">
          <img class="grid-stack-item foreground" src={david.src} width={david.width} height={david.height} alt="" loading="lazy" />
          <img class="grid-stack-item blur" src={david.src} width={64} height={64} alt="" aria-hidden="true" loading="lazy" />
        </figure>
      </div>
    </Surface>

    {/* 8. A full-bleed image in the flow. */}
    <Surface element="section" capInline={false}>
      <figure class="Image grid-container">
        <img class="grid-container-full" src={jean.src} width={jean.width} height={jean.height} alt="" loading="lazy" />
        <figcaption>A caption, centred under the image.</figcaption>
      </figure>
    </Surface>

  </main>
</Layout>

<script>
  // Nicklas's debug panel: grid overlay, tier indicators, container debugger.
  import { init } from "../../lib/debugPanel";
  init();
</script>

<style is:global>
  /* ── Lab helpers. Not part of the system. ───────────────────────────────── */
  .GridLab {
    min-block-size: 40vh;
  }

  .lab-block {
    position: relative;
    min-block-size: 6rem;
    padding: var(--size-md);
    outline: 1px dashed var(--color-border-default);
    background-color: color-mix(in srgb, var(--color-interactive-primary) 6%, transparent);

    &::before {
      content: attr(data-label);
      position: absolute;
      inset-block-start: 0;
      inset-inline-start: 0;
      padding: 0.125rem 0.375rem;
      font: var(--fontWeight-label) 0.75rem var(--fontFamily-label);
      color: var(--color-text-secondary);
      background-color: var(--color-surface-inset);
    }
  }

  /* Surface today wraps content in .content with a measure cap; capInline={false}
     lifts the cap so the grid recipes can run edge to edge. When Surface takes the
     grid recipe itself (the Grid spike), these wrappers and the utility classes go. */

  /* ── 1. ProseWithMedia — container grid, media may break out ───────────── */
  .ProseWithMedia {
    /* TODO(lab): the vertical rhythm inside a band; --size-lg until sections have rhythm tokens. */
    row-gap: var(--size-lg);

    & .text {
      grid-column: main;
      display: flex;
      flex-direction: column;
      gap: var(--size-md);
    }

    & .media {
      margin: 0;
      overflow: hidden;
      border-radius: var(--ui-radius);

      & img {
        display: block;
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
      }
    }

    &[data-media-ratio="landscape"] .media { aspect-ratio: 16 / 9; }
    &[data-media-ratio="portrait"]  .media { aspect-ratio: 3 / 4; }
    &[data-media-ratio="square"]    .media { aspect-ratio: 1; }
    &[data-media-ratio="golden"]    .media { aspect-ratio: 1.618 / 1; }

    &[data-text-valign="start"]  .text { justify-content: start; }
    &[data-text-valign="center"] .text { justify-content: center; }
    &[data-text-valign="end"]    .text { justify-content: end; }

    /* Below the desktop tier both stack in the main column. */
    @media (max-width: 48.74rem) {
      &[data-media-side="start"] .media,
      &[data-media-side="end"]   .media { grid-column: main; }
    }

    @media (min-width: 48.75rem) {
      & .text  { grid-row: 1; }
      & .media { grid-row: 1; }

      /* The container grid has only two named regions; the split is made inside
         main by giving text a max measure and letting media take the rest. */
      /* TODO(lab): real side-by-side needs the breakout or layout grid — the container
         grid has no columns to place on. This block belongs on breakout; kept here to
         show the limit. */
      &[data-media-side="end"]   .media { grid-column: main-end / full-end; }
      &[data-media-side="start"] .media { grid-column: full-start / main-start; }
    }
  }

  /* ── 2. CtaWithMedia — breakout grid, 14 tracks ─────────────────────────── */
  .CtaWithMedia {
    row-gap: var(--size-lg);

    & .text {
      display: flex;
      flex-direction: column;
      gap: var(--size-md);
      grid-column: 2 / 14;
    }

    & .media {
      margin: 0;
      overflow: hidden;
      border-radius: var(--ui-radius);
      grid-column: 2 / 14;

      & img {
        display: block;
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
      }
    }

    & .actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--size-sm);
    }

    @media (min-width: 48.75rem) {
      & .text,
      & .media { grid-row: 1; }

      &[data-media-side="end"]   .text  { grid-column: 2 / 8; }
      &[data-media-side="end"]   .media { grid-column: 8 / 14; }
      &[data-media-side="start"] .media { grid-column: 2 / 8; }
      &[data-media-side="start"] .text  { grid-column: 8 / 14; }
    }
  }

  /* ── 4. ThreeUp — layout grid, three equal spans ────────────────────────── */
  .ThreeUp {
    row-gap: var(--size-md);

    & > * { grid-column: 1 / -1; }

    @media (min-width: 48.75rem) {
      & > * { grid-column: span 4; }
    }
  }

  /* ── 5b. Renderers — two Quotes side by side ────────────────────────────── */
  .Renderers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: var(--size-lg);
  }

  /* ── 6. CtaAside — heading, prose, actions ──────────────────────────────── */
  .CtaAside {
    display: flex;
    flex-direction: column;
    gap: var(--size-md);

    & .actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--size-sm);
    }
  }

  /* ── 7. TextWithMedia — the draft §6 axes ───────────────────────────────── */
  .TextWithMedia {
    display: grid;
    row-gap: var(--size-lg);

    &[data-layout="wide"] {
      grid-template-columns: var(--grid-layout-columns);
      column-gap: var(--grid-layout-gap);
    }

    &[data-layout="full"] {
      grid-template-columns: var(--grid-breakout-columns);
      column-gap: var(--grid-breakout-gap);
    }

    & .text {
      display: flex;
      flex-direction: column;
      gap: var(--size-md);
      grid-column: 1 / -1;
    }

    & .actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--size-sm);
    }

    & .media {
      margin: 0;
      grid-column: 1 / -1;
      inline-size: 100%;
      margin-block: auto;
      border-radius: var(--ui-radius);
      overflow: hidden;
    }

    &[data-media-ratio="landscape"] .media { aspect-ratio: 16 / 9; }
    &[data-media-ratio="portrait"]  .media { aspect-ratio: 3 / 4; }
    &[data-media-ratio="square"]    .media { aspect-ratio: 1; }
    &[data-media-ratio="golden"]    .media { aspect-ratio: 1.618 / 1; }

    &[data-text-valign="start"]  .text { justify-content: start; }
    &[data-text-valign="center"] .text { justify-content: center; }
    &[data-text-valign="end"]    .text { justify-content: end; }

    @media (min-width: 48.75rem) {
      & .text,
      & .media { grid-row: 1; }

      /* wide: 12 tracks. full: 14 tracks with fluid outer columns, so placements shift by one. */
      &[data-layout="wide"][data-media-side="end"]   .text  { grid-column: 1 / 7; }
      &[data-layout="wide"][data-media-side="end"]   .media { grid-column: 8 / 13; }
      &[data-layout="wide"][data-media-side="start"] .media { grid-column: 1 / 6; }
      &[data-layout="wide"][data-media-side="start"] .text  { grid-column: 7 / 13; }

      &[data-layout="full"][data-media-side="end"]   .text  { grid-column: 3 / 8; }
      &[data-layout="full"][data-media-side="end"]   .media { grid-column: 11 / 15; }
      &[data-layout="full"][data-media-side="start"] .media { grid-column: 1 / 5; }
      &[data-layout="full"][data-media-side="start"] .text  { grid-column: 6 / 12; }
    }
  }

  /* ── The blurred-image stack, shared by 5 and 7 ─────────────────────────── */
  /* TODO(decide): this is a candidate primitive — Picture with a blurred echo
     behind it. It is a stack recipe (grid-stack) plus two rules, and two blocks
     already want it. */
  .grid-stack > .foreground {
    position: relative;
    z-index: 1;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .grid-stack > .blur {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    padding: 10%;
    translate: 0 10%;
    opacity: 0.7;
    filter: blur(20px);
  }

  /* ── 8. Image — full bleed on the container grid ────────────────────────── */
  .Image {
    margin: 0;
    row-gap: var(--size-sm);

    & img {
      display: block;
      inline-size: 100%;
      block-size: auto;
    }

    & figcaption {
      grid-column: main;
      text-align: center;
      font-family: var(--fontFamily-label);
      font-size: var(--fontSize-label-small);
      color: var(--theme-textMuted, var(--color-text-secondary));
    }
  }
</style>
