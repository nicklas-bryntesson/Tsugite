---
// /docs/color — Foundations: the color system, RENDERED FROM THE FACTORIES.
// The page imports the same JS sources that generate the CSS, so it cannot
// drift from the system. Authored values paint as literals (all four modes,
// resolved at build); the "live now" column paints with var(token) and
// shows what YOUR active mode actually resolves. Every word goes through a
// typography door, every frame is a Card; this file only arranges.
import Layout from "../../layouts/Layout.astro";
import Heading from "tsugite/Heading/Heading.astro";
import Text from "tsugite/Text/Text.astro";
import Caption from "tsugite/Caption/Caption.astro";
import Card from "tsugite/Card/Card.astro";
import DocPage from "../../components/DocPage/DocPage.astro";
import { palette, rawColorTokens, rawName, rawRefName } from "tsugite/theme-default/raw.color.tokens.js";
import { semanticColorTokens } from "tsugite/theme-default/semantic.color.tokens.js";
import { themeVoices, voiceMatrix } from "tsugite/theme-default/theme.voices.tokens.js";
import { resolveValue } from "tsugite/engine/color-engine.js";
import { oklch } from "culori";
import { toSrgbHex } from "tsugite/engine/color-engine.js";

const MODES = ["light", "dark", "light-contrast", "dark-contrast"] as const;

/** Authored factory value → paintable literal (var pointers resolve via RAW). */
function paintable(value: unknown): string | null {
  const r = resolveValue(value);
  const css: string = r.css;
  const name = rawRefName(css);
  if (name) return rawColorTokens[name];
  if (css.includes("var(") || css.includes("px")) return null; // shadow lists etc.
  return css;
}

// The RAW palette, per family (ADR-0020): the structure is the source, the names are derived.
const families = Object.entries(palette).map(([key, family]) => ({
  key,
  label: family.label,
  glyph: family.glyph,
  note: family.note,
  steps: family.steps.map(([step, literal]) => ({
    step,
    name: rawName(key, step),
    literal,
    hex: toSrgbHex(oklch(literal)),
  })),
}));

const semantics = Object.entries(semanticColorTokens).map(([name, modes]) => ({
  name,
  cells: MODES.map((m) => paintable((modes as Record<string, unknown>)[m])),
}));

const voices = Object.entries(voiceMatrix).flatMap(([voice, volumes]) =>
  (volumes as string[]).map((volume) => ({
    voice,
    volume,
    cells: MODES.map((m) => ({
      surface: paintable((themeVoices as any)[voice][volume].surface[m]),
      text: paintable((themeVoices as any)[voice][volume].text[m]),
    })),
  })),
);
---

<Layout title="Color">
  <DocPage
    section="Foundations"
    title="Color"
    tags={[{ text: "Foundations", primary: true }]}
    lead="Rendered from the same sources that generate the CSS. The live now column paints with var(token) and should match your active mode’s column — if it doesn’t, something broke."
  >
    <div class="ColorDoc">
      <Heading element="h2" size="3" text="RAW palette" />
      <div class="note">
        <Text text="Authored in oklch, as families (ADR-0020). A family is a label and an ordered ladder of steps; the CSS names are derived from it. Hex is the build-computed sRGB rendering." />
      </div>
      {families.map((f) => (
        <section class="family" aria-labelledby={`family-${f.key}`}>
          <header class="family-head">
            <Heading element="h3" size="5" id={`family-${f.key}`} text={f.label} />
            {f.glyph && <div class="family-glyph" aria-hidden="true"><Caption size="md" text={f.glyph} lang="ja" /></div>}
            <div class="family-count"><Caption size="sm" text={`${f.steps.length} steps`} /></div>
          </header>
          {f.note && <div class="note"><Text size="sm" text={f.note} /></div>}
          <ul class="ramp">
            {f.steps.map((r) => (
              <li>
                <Card border={true} padding="sm">
                  <div class="raw">
                    <span class="raw-swatch" style={`background: ${r.literal}`}></span>
                    <Caption size="sm"><code>{f.label}-{r.step}</code></Caption>
                    <div class="raw-val"><Caption size="sm"><code>{r.literal}</code></Caption></div>
                    <div class="raw-val"><Caption size="sm"><code>{r.hex}</code></Caption></div>
                  </div>
                </Card>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <Heading element="h2" size="3" text="Semantic roles" />
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th><Caption size="sm" text="token" /></th>
              {MODES.map((m) => <th><Caption size="sm" text={m} /></th>)}
              <th><Caption size="sm" text="live now" /></th>
            </tr>
          </thead>
          <tbody>
            {semantics.map((row) => (
              <tr>
                <td><Caption size="sm"><code>{row.name}</code></Caption></td>
                {row.cells.map((c) =>
                  c ? (
                    <td><span class="cell-swatch" style={`background: ${c}`}></span></td>
                  ) : (
                    <td class="nonpaint"><Caption size="sm" text="list" /></td>
                  ),
                )}
                <td><span class="cell-swatch live" style={`background: var(${row.name})`}></span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <Heading element="h2" size="3" text="Voices × volumes" />
      <div class="note">
        <Text>Surface + text per mode. The <a href="/control-room">control room</a> shows the living matrix.</Text>
      </div>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th><Caption size="sm" text="voice × volume" /></th>{MODES.map((m) => <th><Caption size="sm" text={m} /></th>)}</tr>
          </thead>
          <tbody>
            {voices.map((v) => (
              <tr>
                <td><Caption size="sm"><code>{v.voice}</code> × <code>{v.volume}</code></Caption></td>
                {v.cells.map((c) => (
                  <td>
                    <span class="voice-swatch" style={`background: ${c.surface}; color: ${c.text}`}><Caption inline size="sm" text="Aa" /></span>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </DocPage>
</Layout>

<style is:global>
/* Arrangement and ink only: the words are the typography doors', the frames Card's. The muted channel rides wrappers, since the doors set no colour. */
.ColorDoc {
  display: flex;
  flex-direction: column;
  gap: var(--size-md);

  & .note,
  & .family-glyph,
  & .family-count,
  & .raw-val,
  & .nonpaint {
    color: var(--color-text-secondary);
  }

  & .family {
    display: grid;
    gap: var(--size-sm);
    inline-size: 100%;
  }

  & .family-head {
    display: flex;
    align-items: baseline;
    gap: var(--size-sm);
    flex-wrap: wrap;
  }

  & .family-count {
    margin-inline-start: auto;
  }

  & .ramp {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(9rem, 100%), 1fr));
    gap: var(--size-sm);
    inline-size: 100%;
  }

  /* the raw card's inner layout; the frame is Card's */
  & .raw {
    display: grid;
    gap: var(--size-xs);
  }

  /* TODO(token): swatch radii are raw; the radius ramp is in the parking lot. */
  & .raw-swatch {
    display: block;
    block-size: 2.5rem;
    border-radius: 0.4rem;
    border: 1px solid var(--color-border-subtle);
  }

  & .raw-val {
    overflow-wrap: anywhere;
  }

  & .table-scroll {
    overflow-x: auto;
    inline-size: 100%;
  }

  & th,
  & td {
    text-align: start;
    white-space: nowrap;
  }

  & .cell-swatch {
    display: inline-block;
    inline-size: 2.4rem;
    block-size: 1.4rem;
    border-radius: 0.3rem;
    border: 1px solid var(--color-border-subtle);
  }

  & .cell-swatch.live {
    outline: 2px solid var(--color-interactive-primary);
    outline-offset: 1px;
  }

  & .voice-swatch {
    display: inline-grid;
    place-items: center;
    inline-size: 3rem;
    block-size: 1.8rem;
    border-radius: 0.35rem;
    border: 1px solid var(--color-border-subtle);
  }
}
</style>
