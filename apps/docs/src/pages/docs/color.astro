---
// /docs/color — Foundations: the color system, RENDERED FROM THE FACTORIES.
// The page imports the same JS sources that generate the CSS, so it cannot
// drift from the system. Authored values paint as literals (all four modes,
// resolved at build); the "live now" column paints with var(token) and
// shows what YOUR active mode actually resolves.
import Layout from "../../layouts/Layout.astro";
import Heading from "tsugite/components/Heading/Heading.astro";
import Prose from "tsugite/components/Prose/Prose.astro";
import { palette, rawColorTokens, rawName, rawRefName } from "tsugite/theme-default/raw.color.tokens.js";
import { semanticColorTokens } from "tsugite/theme-default/semantic.color.tokens.js";
import { themeVoices, voiceMatrix } from "tsugite/theme-default/theme.voices.tokens.js";
import { resolveValue } from "tsugite/engine/color-engine.js";
import { oklch } from "culori";
import { toSrgbHex } from "tsugite/engine/color-engine.js";

const MODES = ["light", "dark", "light-contrast", "dark-contrast"] as const;

/** Authored factory value → paintable literal (var pointers resolve via RAW). */
function paintable(value: unknown): string | null {
  const r = resolveValue(value);
  const css: string = r.css;
  const name = rawRefName(css);
  if (name) return rawColorTokens[name];
  if (css.includes("var(") || css.includes("px")) return null; // shadow lists etc.
  return css;
}

// The RAW palette, per family (ADR-0020): the structure is the source, the names are derived.
const families = Object.entries(palette).map(([key, family]) => ({
  key,
  label: family.label,
  glyph: family.glyph,
  note: family.note,
  steps: family.steps.map(([step, literal]) => ({
    step,
    name: rawName(key, step),
    literal,
    hex: toSrgbHex(oklch(literal)),
  })),
}));

const semantics = Object.entries(semanticColorTokens).map(([name, modes]) => ({
  name,
  cells: MODES.map((m) => paintable((modes as Record<string, unknown>)[m])),
}));

const voices = Object.entries(voiceMatrix).flatMap(([voice, volumes]) =>
  (volumes as string[]).map((volume) => ({
    voice,
    volume,
    cells: MODES.map((m) => ({
      surface: paintable((themeVoices as any)[voice][volume].surface[m]),
      text: paintable((themeVoices as any)[voice][volume].text[m]),
    })),
  })),
);
---

<Layout title="Color">
  <main class="Main ColorDoc grid-container">
    <div class="content">
      <nav class="doc-breadcrumb" aria-label="Map"><a href="/map">Map</a> <span aria-hidden="true">/</span> Foundations</nav>
      <Heading element="h1" size="1" text="Color" />
      <Prose variant="basic">
        <p>
          Rendered from the same sources that generate the CSS. The <strong>live now</strong>
          column paints with <code>var(token)</code> and should match your active mode’s
          column — if it doesn’t, something broke.
        </p>
      </Prose>

      <Heading element="h2" size="3" text="RAW palette" />
      <p class="note">
        Authored in oklch, as families (ADR-0020). A family is a label and an ordered ladder of
        steps; the CSS names are derived from it. Hex is the build-computed sRGB rendering.
      </p>
      {families.map((f) => (
        <section class="family" aria-labelledby={`family-${f.key}`}>
          <header class="family-head">
            <Heading element="h3" size="5" id={`family-${f.key}`} text={f.label} />
            {f.glyph && <span class="family-glyph" aria-hidden="true">{f.glyph}</span>}
            <span class="family-count">{f.steps.length} steps</span>
          </header>
          {f.note && <p class="family-note">{f.note}</p>}
          <ul class="ramp">
            {f.steps.map((r) => (
              <li class="raw-card">
                <span class="raw-swatch" style={`background: ${r.literal}`}></span>
                <code class="raw-name">{f.label}-{r.step}</code>
                <code class="raw-val">{r.literal}</code>
                <code class="raw-val">{r.hex}</code>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <Heading element="h2" size="3" text="Semantic roles" />
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>token</th>
              {MODES.map((m) => <th>{m}</th>)}
              <th>live now</th>
            </tr>
          </thead>
          <tbody>
            {semantics.map((row) => (
              <tr>
                <td><code>{row.name}</code></td>
                {row.cells.map((c) =>
                  c ? (
                    <td><span class="cell-swatch" style={`background: ${c}`}></span></td>
                  ) : (
                    <td class="nonpaint">list</td>
                  ),
                )}
                <td><span class="cell-swatch live" style={`background: var(${row.name})`}></span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <Heading element="h2" size="3" text="Voices × volumes" />
      <p class="note">Surface + text per mode. The <a href="/control-room">control room</a> shows the living matrix.</p>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>voice × volume</th>{MODES.map((m) => <th>{m}</th>)}</tr>
          </thead>
          <tbody>
            {voices.map((v) => (
              <tr>
                <td><code>{v.voice}</code> × <code>{v.volume}</code></td>
                {v.cells.map((c) => (
                  <td>
                    <span class="voice-swatch" style={`background: ${c.surface}; color: ${c.text}`}>Aa</span>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </main>
</Layout>

<style is:global>
.ColorDoc {
  padding-block: 3rem 4rem;
  background-color: var(--color-surface-page);

  & .content {
    /* placed in the main area by the .grid-container > * default */
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  & .doc-breadcrumb {
    font-size: var(--fontSize-label-small);
    color: var(--color-text-secondary);
    & a { color: var(--color-interactive-secondary-text); }
  }

  & .note { margin: 0; color: var(--color-text-secondary); font-size: var(--fontSize-label); }

  & .family {
    display: grid;
    gap: 0.5rem;
    inline-size: 100%;
  }

  & .family-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  & .family-glyph { color: var(--color-text-secondary); }
  & .family-count { margin-inline-start: auto; color: var(--color-text-secondary); font-size: var(--fontSize-label-small); }
  & .family-note { margin: 0; color: var(--color-text-secondary); font-size: var(--fontSize-label); max-inline-size: 72ch; }

  & .ramp {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(9rem, 100%), 1fr));
    gap: 0.5rem;
    inline-size: 100%;
  }

  & .raw-card {
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.6rem;
    padding: 0.6rem;
    display: grid;
    gap: 0.15rem;
    background-color: var(--color-surface-chrome);
  }

  & .raw-swatch {
    display: block;
    block-size: 2.5rem;
    border-radius: 0.4rem;
    border: 1px solid var(--color-border-subtle);
  }

  & .raw-name { font-weight: var(--fontWeight-body-bold); font-size: var(--fontSize-label-small); color: var(--color-text-primary); }
  & .raw-val { font-size: var(--fontSize-label-small); color: var(--color-text-secondary); overflow-wrap: anywhere; }

  & .table-scroll { overflow-x: auto; inline-size: 100%; }

  & table { border-collapse: collapse; font-size: var(--fontSize-label); }
  & th, & td {
    text-align: start;
    padding: 0.35rem 0.6rem;
    border-block-end: 1px solid var(--color-border-subtle);
    white-space: nowrap;
  }
  /* th tracked-caps manner stays raw pending the Eyebrow primitive; inline
     code scales relatively — the Prose mechanism */
  & th { color: var(--color-text-secondary); font-weight: var(--fontWeight-body-bold); font-size: var(--fontSize-label-small); text-transform: uppercase; letter-spacing: 0.08em; }
  & td code { font-size: 0.875em; }

  & .cell-swatch {
    display: inline-block;
    inline-size: 2.4rem;
    block-size: 1.4rem;
    border-radius: 0.3rem;
    border: 1px solid var(--color-border-subtle);
  }
  & .cell-swatch.live { outline: 2px solid var(--color-interactive-primary); outline-offset: 1px; }
  & .nonpaint { color: var(--color-text-secondary); font-size: var(--fontSize-label-small); }

  & .voice-swatch {
    display: inline-grid;
    place-items: center;
    inline-size: 3rem;
    block-size: 1.8rem;
    border-radius: 0.35rem;
    border: 1px solid var(--color-border-subtle);
    font-size: var(--fontSize-label-small);
    font-weight: var(--fontWeight-body-bold);
  }
}
</style>
