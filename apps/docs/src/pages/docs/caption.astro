---
// /docs/caption — explicit page. The page is the view: it imports exactly the
// examples it shows, each one file under src/examples/caption/, mounted twice
// (Figure + Code). The CaptionSection fixture is mounted last as the bench.
import Layout from "../../layouts/Layout.astro";
import Heading from "tsugite/components/Heading/Heading.astro";
import TextBlock from "tsugite/components/TextBlock/TextBlock.astro";
import CaptionSection from "tsugite/fixtures/CaptionSection.astro";
import Example from "../../components/Example/Example.astro";
import DocPage from "../../components/DocPage/DocPage.astro";
import { entryFor } from "../../lib/manifest.ts";

import Voices from "../../examples/caption/Voices.astro";
import voicesSrc from "../../examples/caption/Voices.astro?raw";
import Elements from "../../examples/caption/Elements.astro";
import elementsSrc from "../../examples/caption/Elements.astro?raw";
import Emphasis from "../../examples/caption/Emphasis.astro";
import emphasisSrc from "../../examples/caption/Emphasis.astro?raw";

const entry = entryFor("caption");
---

<Layout title={entry.title}>
  <DocPage entry={entry}>
    <TextBlock
      text="The UI voices of the typography family: label marks the interface up — form labels, legends, figcaptions, table headers, hints — and button is the pressable voice, which Button reads as tokens and this door speaks standalone. One door, two sibling voices, like Heading with heading and display, on whatever element the semantics need."
    />

    <Example id="voices" title="Two voices, three steps" lead="label and button are siblings that share a door, not a voice and its variant. In this theme they carry the same values — Inter 400 — on purpose: same value, separate knob, so a brand can turn one without the other." source={voicesSrc} block>
      <Voices />
    </Example>

    <Example id="elements" title="The element is the semantics" lead="Whatever the markup needs: a legend that is a heading, a label that is a label, a figcaption. Nested fieldsets in a wizard bind their groups with legends at every level, and each looks like what the design wants — the voice never forces the element, the element never forces the voice. The farm is the whole family's for exactly this reason." source={elementsSrc} block>
      <Elements />
    </Example>

    <Example id="emphasis" title="Emphasis: a door, not a law" lead="strong asks for the voice's bold weight with one fallback to the voice's own. This theme gives the UI voices one weight, so emphasis renders flat here — by value, not by law. A theme that adds a bold weight to the voice opens the door without a line of CSS changing. em stays italic." source={emphasisSrc} block>
      <Emphasis />
    </Example>

    <section class="doc-bench" id="test-bench">
      <Heading text="Test bench" element="h2" size="2" />
      <p class="doc-note">The Caption fixture — every voice × size × element, and the button voice beside a Button, mounted unchanged.</p>
      <CaptionSection />
    </section>
  </DocPage>
</Layout>
