---
// /docs/tiers — Foundations: the viewport tier ladder and the type ramp,
// LIVE-RENDERED: every specimen and bar paints with var(token), so the page
// shows exactly what the active tier resolves. Resize and watch the steps.
// (Size tokens live in SCSS constants; live rendering is the truth here.)
import Layout from "../../layouts/Layout.astro";
import Heading from "tsugite/Heading/Heading.astro";
import Text from "tsugite/Text/Text.astro";
import Prose from "tsugite/Prose/Prose.astro";

// Each specimen is rendered THROUGH THE FAMILY, in its own voice — display in the display
// face, heading in the heading face, body in the body face — as an inline run on a span,
// so what steps with the tier is the real bundle, not one face at twelve sizes.
const typeRamp: Array<{ token: string; label: string; voice: "display" | "heading" | "body"; size: string }> = [
  { token: "--fontSize-display-1", label: "Display 1", voice: "display", size: "1" },
  { token: "--fontSize-display-2", label: "Display 2", voice: "display", size: "2" },
  { token: "--fontSize-display-3", label: "Display 3", voice: "display", size: "3" },
  { token: "--fontSize-h1", label: "Heading 1", voice: "heading", size: "1" },
  { token: "--fontSize-h2", label: "Heading 2", voice: "heading", size: "2" },
  { token: "--fontSize-h3", label: "Heading 3", voice: "heading", size: "3" },
  { token: "--fontSize-h4", label: "Heading 4", voice: "heading", size: "4" },
  { token: "--fontSize-h5", label: "Heading 5", voice: "heading", size: "5" },
  { token: "--fontSize-h6", label: "Heading 6", voice: "heading", size: "6" },
  { token: "--fontSize-body-large", label: "Body large", voice: "body", size: "lg" },
  { token: "--fontSize-body", label: "Body", voice: "body", size: "md" },
  { token: "--fontSize-body-small", label: "Body small", voice: "body", size: "sm" },
];

const sizeRamp = ["--size-xs", "--size-sm", "--size-md", "--size-lg", "--size-xl", "--size-2xl"];
---

<Layout title="Tiers">
  <main class="Main TiersDoc grid-container">
    <div class="content">
      <nav class="doc-breadcrumb" aria-label="Map"><a href="/map">Map</a> <span aria-hidden="true">/</span> Foundations</nav>
      <Heading element="h1" size="1" text="Tiers" />
      <Prose variant="basic">
        <p>
          <strong>FLOOR · MOBILE · DESKTOP · WIDE</strong> — explicit stops, never fluid.
          Everything below paints with <code>var(token)</code>. Resize the window and
          watch the ladder step.
        </p>
      </Prose>

      <Heading element="h2" size="3" text="Type ramp" />
      <ul class="ramp">
        {typeRamp.map(({ token, label, voice, size }) => (
          <li class="specimen">
            <code class="specimen-token">{token}</code>
            <span class="specimen-text">
              {voice === "body" ? (
                <Text element="span" variant="body" size={size} text={label} />
              ) : (
                <Heading element="span" variant={voice} size={size} text={label} />
              )}
            </span>
            <output class="specimen-value" data-measure={token}></output>
          </li>
        ))}
      </ul>

      <Heading element="h2" size="3" text="Size ramp + site offset" />
      <ul class="bars">
        {sizeRamp.map((token) => (
          <li class="bar-row">
            <code>{token}</code>
            <span class="bar" style={`inline-size: var(${token})`}></span>
            <output class="specimen-value" data-measure={token}></output>
          </li>
        ))}
        <li class="bar-row">
          <code>--site-offset</code>
          <span class="bar" style="inline-size: var(--site-offset)"></span>
          <output class="specimen-value" data-measure="--site-offset"></output>
        </li>
      </ul>
    </div>
  </main>
</Layout>

<script>
  // Read resolved px live + on resize, so tier steps show as numbers.
  const measure = () => {
    const cs = getComputedStyle(document.documentElement);
    document.querySelectorAll<HTMLElement>("[data-measure]").forEach((out) => {
      const token = out.dataset.measure!;
      const probe = document.createElement("div");
      probe.style.position = "absolute";
      probe.style.inlineSize = `var(${token})`;
      document.body.append(probe);
      const px = probe.getBoundingClientRect().width;
      probe.remove();
      out.textContent = `${cs.getPropertyValue(token).trim()} → ${px.toFixed(0)}px`;
    });
  };
  measure();
  let raf = 0;
  addEventListener("resize", () => {
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(measure);
  });
</script>

<style is:global>
.TiersDoc {
  padding-block: 3rem 4rem;
  background-color: var(--color-surface-page);

  & .content {
    /* placed in the main area by the .grid-container > * default */
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  & .doc-breadcrumb {
    font-size: var(--fontSize-label-small);
    color: var(--color-text-secondary);
    & a { color: var(--color-interactive-secondary-text); }
  }

  & .ramp, & .bars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    inline-size: 100%;
  }

  & .specimen {
    display: grid;
    grid-template-columns: 12rem 1fr auto;
    align-items: baseline;
    gap: 1rem;
    border-block-end: 1px solid var(--color-border-subtle);
    padding-block-end: 0.5rem;
  }
  @media (max-width: 48rem) {
    & .specimen { grid-template-columns: 1fr; gap: 0.2rem; }
  }

  & .specimen-token { font-size: var(--fontSize-label-small); color: var(--color-text-secondary); }
  /* the specimen's face, weight and leading are the component's; the row only keeps it on one line */
  & .specimen-text {
    color: var(--color-text-primary);
    white-space: nowrap;
  }
  & .specimen-value { font-family: var(--fontFamily-code); font-size: var(--fontSize-label-small); color: var(--color-text-secondary); }

  & .bar-row {
    display: grid;
    grid-template-columns: 12rem auto 1fr;
    align-items: center;
    gap: 1rem;

    & code { font-size: 0.875em; /* inline code scales relatively — the Prose mechanism */ color: var(--color-text-secondary); }
  }

  & .bar {
    display: block;
    block-size: 1rem;
    border-radius: 0.2rem;
    background-color: var(--color-interactive-primary);
  }
}
</style>
