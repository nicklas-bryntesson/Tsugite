---
// /docs/tiers — Foundations: the viewport tier ladder and the type ramp,
// LIVE-RENDERED: every specimen and bar paints with var(token), so the page
// shows exactly what the active tier resolves. Resize and watch the steps.
// Every word goes through a typography door; this file only arranges.
import Layout from "../../layouts/Layout.astro";
import Heading from "tsugite/Heading/Heading.astro";
import Text from "tsugite/Text/Text.astro";
import Caption from "tsugite/Caption/Caption.astro";
import TextBlock from "tsugite/TextBlock/TextBlock.astro";
import DocPage from "../../components/DocPage/DocPage.astro";
import { TIERS, typeSizes } from "tsugite/theme-default/typography.tokens.js";
import { spaceSteps, sizeConstantName } from "tsugite/theme-default/size.tokens.js";
import { siteOffset, siteOffsetConstantName } from "tsugite/theme-default/site.tokens.js";

// Each specimen is rendered THROUGH THE FAMILY, in its own voice and through its own door —
// display and heading through Heading, body through Text, the UI voices through Caption,
// preamble through TextBlock — so what steps with the tier is the real bundle, not one face
// at many sizes. The rows come from typeSizes itself, so no voice can be missing; a voice
// with no door yet (code) shows its values without a specimen.
const ORDER = ["display", "heading", "body", "preamble", "label", "button", "nav", "code"];
const voiceOf = (key: string): { voice: string; size: string } => {
  const h = key.match(/^h(\d)$/);
  if (h) return { voice: "heading", size: h[1] };
  const d = key.match(/^display-(\d)$/);
  if (d) return { voice: "display", size: d[1] };
  const q = key.match(/^(\w+?)(?:-(small|large))?$/)!;
  return { voice: q[1], size: q[2] === "small" ? "sm" : q[2] === "large" ? "lg" : "md" };
};
const DOORS: Record<string, { door: any; inline: boolean }> = {
  display: { door: Heading, inline: true },
  heading: { door: Heading, inline: true },
  body: { door: Text, inline: true },
  label: { door: Caption, inline: true },
  button: { door: Caption, inline: true },
  nav: { door: Caption, inline: true },
  preamble: { door: TextBlock, inline: false },
};
const sizeRank = (size: string) => ["1", "2", "3", "4", "5", "6", "lg", "md", "sm"].indexOf(size);
const typeRamp = Object.keys(typeSizes)
  .map((key) => ({ token: `--fontSize-${key}`, ...voiceOf(key) }))
  .sort((a, b) => ORDER.indexOf(a.voice) - ORDER.indexOf(b.voice) || sizeRank(a.size) - sizeRank(b.size))
  .map((r) => {
    const d = DOORS[r.voice];
    return { ...r, Door: d?.door, props: d ? { voice: r.voice, size: r.size, text: "Aa", ...(d.inline ? { inline: true } : {}) } : null };
  });

// The four tiers, side by side, from the same sources that generate the CSS: each cell
// sets the token to that tier's RAW constant on a wrapper, through the chain the
// generated CSS writes, and the door reads the token as it always does. The literal
// under each specimen is the authored value; the live column is the tier you are in.
const tiers = TIERS as readonly string[];
const up = (v: string) => v.toUpperCase();
const typeRows = typeRamp.map((r) => {
  const key = r.token.replace("--fontSize-", "");
  return {
    ...r,
    cells: tiers.map((tier) => ({
      tier,
      style: `${r.token}: calc(var(--FONTSIZE-${up(key)}-${up(tier)}) * var(--TYPE-SCALE, 1))`,
      value: (typeSizes as Record<string, Record<string, string>>)[key][tier],
    })),
  };
});

const sizeRows = [
  ...["xs", "sm", "md", "lg", "xl", "2xl"].map((step) => ({
    token: `--size-${step}`,
    cells: tiers.map((tier) => ({
      tier,
      width: `calc(var(${sizeConstantName(step, tier)}) * var(--SPACE-SCALE, 1))`,
      value: (spaceSteps as Record<string, Record<string, string>>)[step][tier],
    })),
  })),
  {
    token: "--site-offset",
    cells: tiers.map((tier) => ({ tier, width: `var(${siteOffsetConstantName(tier)})`, value: (siteOffset as Record<string, string>)[tier] })),
  },
];
---

<Layout title="Tiers">
  <DocPage
    section="Foundations"
    title="Tiers"
    tags={[{ text: "Foundations", primary: true }]}
    lead="The screen widths the system is designed for. There are four tiers — floor, mobile, desktop and wide — and every size in the system has one value per tier. A page uses the values of the tier it is in; nothing scales smoothly in between."
  >
    <div class="TiersDoc">
      <div class="note">
        <Text text="The tiers are explicit stops, not fluid ranges: FLOOR up to 21.25rem, MOBILE up to 48.75rem, DESKTOP up to 90rem, WIDE beyond. The tokens carry the ladder, so a component reads one name and gets its tier’s value. Everything below paints with var(token): resize the window and watch the values step." />
      </div>

      <section class="block">
        <Heading element="h2" size="3" text="Type ramp" />
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th><Caption size="sm" text="token" /></th>
                {tiers.map((t) => <th><Caption size="sm" text={up(t)} /></th>)}
                <th><Caption size="sm" text="live now" /></th>
              </tr>
            </thead>
            <tbody>
              {typeRows.map(({ token, Door, props, cells }) => (
                <tr>
                  <td class="muted"><Caption size="sm"><code>{token}</code></Caption></td>
                  {cells.map((c) => (
                    <td>
                      <div class="specimen" style={c.style}>
                        {Door ? <Door {...props} /> : <span class="muted"><Caption inline size="sm" text="—" /></span>}
                      </div>
                      <div class="muted"><Caption size="sm"><code>{c.value}</code></Caption></div>
                    </td>
                  ))}
                  <td class="live">
                    <div class="specimen">
                      {Door ? <Door {...props} /> : <span class="muted"><Caption inline size="sm" text="—" /></span>}
                    </div>
                    <div class="muted"><Caption size="sm"><code><output data-measure={token}></output></code></Caption></div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="block">
        <Heading element="h2" size="3" text="Size ramp + site offset" />
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th><Caption size="sm" text="token" /></th>
                {tiers.map((t) => <th><Caption size="sm" text={up(t)} /></th>)}
                <th><Caption size="sm" text="live now" /></th>
              </tr>
            </thead>
            <tbody>
              {sizeRows.map(({ token, cells }) => (
                <tr>
                  <td class="muted"><Caption size="sm"><code>{token}</code></Caption></td>
                  {cells.map((c) => (
                    <td>
                      <span class="bar" style={`inline-size: ${c.width}`}></span>
                      <div class="muted"><Caption size="sm"><code>{c.value}</code></Caption></div>
                    </td>
                  ))}
                  <td class="live">
                    <span class="bar" style={`inline-size: var(${token})`}></span>
                    <div class="muted"><Caption size="sm"><code><output data-measure={token}></output></code></Caption></div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </DocPage>
</Layout>

<script>
  // Read resolved px live + on resize, so tier steps show as numbers.
  const measure = () => {
    const cs = getComputedStyle(document.documentElement);
    document.querySelectorAll<HTMLElement>("[data-measure]").forEach((out) => {
      const token = out.dataset.measure!;
      const probe = document.createElement("div");
      probe.style.position = "absolute";
      probe.style.inlineSize = `var(${token})`;
      document.body.append(probe);
      const px = probe.getBoundingClientRect().width;
      probe.remove();
      out.textContent = `${cs.getPropertyValue(token).trim()} → ${px.toFixed(0)}px`;
    });
  };
  measure();
  let raf = 0;
  addEventListener("resize", () => {
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(measure);
  });
</script>

<style is:global>
/* Arrangement and ink only: the words are the typography doors'. The muted channel rides
   wrappers, since the doors set no colour. One flow on every docs page: --size-md inside a
   block, --size-xl between blocks. */
.TiersDoc {
  display: flex;
  flex-direction: column;
  gap: var(--size-xl);

  & .block {
    display: flex;
    flex-direction: column;
    gap: var(--size-md);
  }

  & .note,
  & .muted {
    color: var(--color-text-secondary);
  }

  & .table-scroll {
    overflow-x: auto;
    inline-size: 100%;
  }

  & th,
  & td {
    text-align: start;
    vertical-align: bottom;
    white-space: nowrap;
  }

  /* the specimen keeps its line; its face, size and leading are the door's */
  & .specimen {
    white-space: nowrap;
    margin-block-end: var(--size-xs);
  }

  /* the column you are in now: the receipt that the side-by-side cells are the real chain */
  /* TODO(token): halfway between page and chrome has no role; runtime color-mix is unguarded
     under the Chrome 109 floor (parking lot, gradients and shadows row). */
  & .live {
    background-color: color-mix(in oklch, var(--color-surface-chrome) 50%, var(--color-surface-page));
  }

  /* TODO(token): the bar's radius is raw; the radius ramp is in the parking lot. */
  & .bar {
    display: block;
    block-size: 1rem;
    margin-block-end: var(--size-xs);
    border-radius: 0.2rem;
    background-color: var(--color-interactive-primary);
  }
}
</style>
