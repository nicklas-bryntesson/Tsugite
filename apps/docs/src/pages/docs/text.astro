---
// /docs/text — explicit page. The page is the view: it imports exactly the
// examples it shows, each one file under src/examples/text/, mounted twice
// (Figure + Code). The TextSection fixture is mounted last as the bench.
import Layout from "../../layouts/Layout.astro";
import Heading from "tsugite/components/Heading/Heading.astro";
import TextBlock from "tsugite/components/TextBlock/TextBlock.astro";
import TextSection from "tsugite/fixtures/TextSection.astro";
import Example from "../../components/Example/Example.astro";
import DocPage from "../../components/DocPage/DocPage.astro";
import { entryFor } from "../../lib/manifest.ts";

import BodyOnHeading from "../../examples/text/BodyOnHeading.astro";
import bodyOnHeadingSrc from "../../examples/text/BodyOnHeading.astro?raw";
import Sizes from "../../examples/text/Sizes.astro";
import sizesSrc from "../../examples/text/Sizes.astro?raw";
import ElementAndRun from "../../examples/text/ElementAndRun.astro";
import elementAndRunSrc from "../../examples/text/ElementAndRun.astro?raw";
import Emphasis from "../../examples/text/Emphasis.astro";
import emphasisSrc from "../../examples/text/Emphasis.astro?raw";
import Chain from "../../examples/text/Chain.astro";
import chainSrc from "../../examples/text/Chain.astro?raw";
import Sovereignty from "../../examples/text/Sovereignty.astro";
import sovereigntySrc from "../../examples/text/Sovereignty.astro?raw";
import AlignWrap from "../../examples/text/AlignWrap.astro";
import alignWrapSrc from "../../examples/text/AlignWrap.astro?raw";
import LineLength from "../../examples/text/LineLength.astro";
import lineLengthSrc from "../../examples/text/LineLength.astro?raw";

const entry = entryFor("text");
---

<Layout title={entry.title}>
  <DocPage entry={entry}>
    <TextBlock
      text="The text primitive. Authored single-run reading text in the body voice, on p, span and div, on the captions legend, figcaption and label, and on h1–h6 when the outline needs a heading that reads like text. The family litmus: do you author the element? Text for reading, Caption for the UI voices, Heading for the loud ones. A flow you don't control? Prose."
    />

    <Example id="sizes" title="Sizes" lead="The body voice has three steps, md by default. Unlike Heading, the element never decides the size." source={sizesSrc} block>
      <Sizes />
    </Example>

    <Example id="element-and-run" title="Element and run mode" lead="The element is the markup shape, the voice is the look, and the two are independent. The shape decides the run mode: a span is an inline run that flows on the line and leaves trim to its host; p and div are block runs that own their trim (ADR-0012, law c)." source={elementAndRunSrc} block>
      <ElementAndRun />
    </Example>

    <Example id="body-on-heading" title="Body on a heading shape" lead="A heading that should read like text. The element is the outline's business, the voice the design's; the two never force each other. The quiet voice keeps its emphasis law here — strong stays bold — where Heading would flatten it, which is why this cell is Text's and not Heading's (ADR-0023)." source={bodyOnHeadingSrc} block>
      <BodyOnHeading />
    </Example>
    <Example id="emphasis" title="Emphasis keeps its semantics" lead="Child content runs through the same engine as prop text. In the body voice strong takes the body-bold weight and em stays italic — the loud voices flatten instead (ADR-0012, law b)." source={emphasisSrc} block>
      <Emphasis />
    </Example>

    <Example id="chain" title="Two voices on one line" lead="A Caption in the label voice as an inline run at the start of a body-voiced block. Each run resolves its own bundle; the line negotiates the baseline." source={chainSrc} block>
      <Chain />
    </Example>

    <Example id="sovereignty" title="Voice sovereignty" lead="An unvoiced span inherits the run's metrics; a voiced child owns its own bundle. Nearest voice wins by inheritance, never by specificity (ADR-0012, law d)." source={sovereigntySrc} block>
      <Sovereignty />
    </Example>

    <Example id="align-wrap" title="Alignment and wrapping" lead="align-inline sets the inline alignment with logical values, start | center | end; wrap chooses the line-breaking strategy — pretty by default, where Heading defaults to balance." source={alignWrapSrc} block>
      <AlignWrap />
    </Example>

    <Example id="line-length" title="Line length" lead="A paragraph is capped at the body stop's line length, on by default (ADR-0021). The ceiling is in ch, so it steps with the size; capInline={false} releases it." source={lineLengthSrc} block>
      <LineLength />
    </Example>

    <section class="doc-bench" id="test-bench">
      <Heading text="Test bench" element="h2" size="2" />
      <p class="doc-note">The Text fixture — the run engine laws and every size × element the body voice allows, mounted unchanged.</p>
      <TextSection />
    </section>
  </DocPage>
</Layout>
