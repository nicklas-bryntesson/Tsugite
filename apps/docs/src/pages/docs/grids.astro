---
// /docs/grids — Foundations: the three grids, LIVE-RENDERED. Every figure is the
// real recipe class from styles/utils/grids on the real tokens, with one cell per
// track, so what the page shows is exactly what the active step resolves. The
// readout under each figure is measured from the browser, not typed. Resize and
// watch the tracks step. The grid has its own ladder (40 / 48 / 80rem, grid.tokens.js).
import Layout from "../../layouts/Layout.astro";
import Heading from "tsugite/components/Heading/Heading.astro";
import Prose from "tsugite/components/Prose/Prose.astro";

// The cell counts come from the generated token CSS (the public contract), not from a
// number typed here: the largest column count any step declares. Redefine the grids and
// the figures follow; the browser then decides, per step, how many of the cells show.
import baseTokens from "tsugite/styles/tokens/base/base.generated.css?raw";
// A count token points at a RAW constant (--GRID-COLUMNS-<STEP>: 12); follow the pointer.
const declared = new Map([...baseTokens.matchAll(/(--[\w-]+):\s*([^;]+);/g)].map((m) => [m[1], m[2].trim()]));
const numberOf = (name: string, depth = 0): number => {
  const v = declared.get(name) ?? "";
  const ref = v.match(/^var\((--[\w-]+)\)$/);
  return ref && depth < 4 ? numberOf(ref[1], depth + 1) : Number(v);
};
const maxCount = (recipe: string) =>
  Math.max(...[...declared.keys()].filter((k) => k.startsWith(`--grid-${recipe}-columns-count-`)).map((k) => numberOf(k)).filter((n) => !Number.isNaN(n)));
const layoutCells = Array.from({ length: maxCount("layout") }, (_, i) => i + 1);
const breakoutColumns = Array.from({ length: maxCount("breakout") }, (_, i) => i + 1);

const containerTokens = ["--grid-container-offset", "--grid-container-maxWidth"];
const layoutTokens = ["--grid-layout-gap", "--grid-layout-columns"];
const breakoutTokens = ["--grid-breakout-gap", "--grid-breakout-columns"];
---

<Layout title="Grids">
  {/* main is not a grid: every child is either a grid-container of text or a demo grid
      at full width, so each figure meets the page's edge exactly as the recipe does. */}
  <main class="Main GridsDoc">
    <header class="grid-container text">
      <nav class="doc-breadcrumb" aria-label="Map"><a href="/map">Map</a> <span aria-hidden="true">/</span> Foundations</nav>
      <Heading element="h1" size="1" text="Grids" />
      <Prose variant="basic">
        <p>
          Three recipes on one table of tokens: <strong>container</strong>, <strong>layout</strong>, <strong>breakout</strong>.
          Each figure below is the real class on the real tokens, one cell per
          track, at the page's full width. The numbers are measured live; resize the window and watch the tracks
          step. The <em>LAB</em> button bottom right lays the same grid over any page,
          and <a href="/lab/grid">the grid lab</a> shows the three recipes in use: eleven
          page layouts placed on them, copy and pictures as sketch strokes.
        </p>
      </Prose>
    </header>

    <section class="grid-container text">
      <Heading element="h2" size="3" text="Container" />
      <Prose variant="basic">
        <p>
          A centered column between two fluid gutters. Three tracks, four named lines:
          <code>full-start</code>, <code>main-start</code>, <code>main-end</code>, <code>full-end</code>.
          The gutters never go below the offset; the column never grows past the max width.
        </p>
      </Prose>
    </section>
    <figure class="figure">
      <div class="demo">
        <div class="grid-container" data-grid-figure="container">
          <span class="cell cell-gutter" style="grid-column: full-start / main-start"></span>
          <span class="cell" style="grid-column: main"></span>
          <span class="cell cell-gutter" style="grid-column: main-end / full-end"></span>
        </div>
      </div>
      <figcaption class="grid-container readout">
        <output data-readout="container"></output>
        <ul class="tokens">
          {containerTokens.map((t) => <li><code>{t}</code> <output class="value" data-measure={t}></output></li>)}
        </ul>
      </figcaption>
    </figure>

    <section class="grid-container text">
      <Heading element="h2" size="3" text="Layout" />
      <Prose variant="basic">
        <p>
          Equal columns with a gap, centered in a container; the count steps with the
          grid's own ladder. As many cells as the widest step has columns are placed, and
          the ones beyond the current step's count fall into a row of no height, so what
          you see is one cell per column, whatever the step.
        </p>
      </Prose>
    </section>
    <figure class="figure">
      <div class="demo grid-container">
        <div class="grid-layout" data-grid-figure="layout">
          {layoutCells.map(() => <span class="cell"></span>)}
        </div>
      </div>
      <figcaption class="grid-container readout">
        <output data-readout="layout"></output>
        <ul class="tokens">
          {layoutTokens.map((t) => <li><code>{t}</code> <output class="value" data-measure={t}></output></li>)}
        </ul>
      </figcaption>
    </figure>

    <section class="grid-container text">
      <Heading element="h2" size="3" text="Breakout" />
      <Prose variant="basic">
        <p>
          The layout's columns inside the container's gutters, as one grid: the columns
          named <code>main</code> between a fluid first and last track. Every track is
          placeable, the outer two included; that is the point of breakout, a child can run
          from the screen's edge into the centred columns. One cell per track; the outer two
          are pinned to the first and last track.
        </p>
      </Prose>
    </section>
    <figure class="figure">
      <div class="demo">
        <div class="grid-breakout" data-grid-figure="breakout">
          {/* the outer tracks are placeable like any other — that is what breakout is for — so
              their cells look like the rest; they come first in source, pinned to the first and
              last track, so the auto-placed columns cannot take the last track first */}
          <span class="cell" style="grid-column: 1"></span>
          <span class="cell" style="grid-column: -2"></span>
          {breakoutColumns.map(() => <span class="cell"></span>)}
        </div>
      </div>
      <figcaption class="grid-container readout">
        <output data-readout="breakout"></output>
        <ul class="tokens">
          {breakoutTokens.map((t) => <li><code>{t}</code> <output class="value" data-measure={t}></output></li>)}
        </ul>
      </figcaption>
    </figure>
  </main>
</Layout>

<script>
  // Measure the real grids: tracks and gap from the computed template, tokens as the
  // browser resolved them. Re-read on resize so the steps show as numbers.
  const px = (v: string) => `${Math.round(parseFloat(v))}px`;

  const measure = () => {
    const cs = getComputedStyle(document.documentElement);

    document.querySelectorAll<HTMLElement>("[data-grid-figure]").forEach((grid) => {
      const name = grid.dataset.gridFigure!;
      const style = getComputedStyle(grid);
      // the computed template carries the line names in brackets; the tracks are the rest
      const tracks = style.gridTemplateColumns.replace(/\[[^\]]*\]/g, " ").trim().split(/\s+/);
      const gap = style.columnGap === "normal" ? "0px" : style.columnGap;
      const out = document.querySelector<HTMLElement>(`[data-readout="${name}"]`);
      if (out) out.textContent = `${tracks.length} tracks · gap ${px(gap)} · ${tracks.map(px).join(" ")}`;
    });

    document.querySelectorAll<HTMLElement>("[data-measure]").forEach((out) => {
      const token = out.dataset.measure!;
      const value = cs.getPropertyValue(token).trim().replace(/\s+/g, " ");
      out.textContent = value.length > 72 ? `${value.slice(0, 72)}…` : value;
      out.title = value;
    });
  };

  measure();
  let raf = 0;
  addEventListener("resize", () => {
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(measure);
  });
</script>

<style is:global>
.GridsDoc {
  padding-block: 3rem 4rem;
  background-color: var(--color-surface-page);

  display: flex;
  flex-direction: column;
  gap: var(--size-lg);

  & .text {
    row-gap: var(--size-lg);
  }

  & .doc-breadcrumb {
    font-size: var(--fontSize-label-small);
    color: var(--color-text-secondary);
    & a { color: var(--color-interactive-secondary-text); }
  }

  & .figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  & .demo {
    padding-block: 0.75rem;
    border-block: 1px dashed var(--color-border-subtle);
  }

  & [data-grid-figure] {
    grid-template-rows: auto;
    grid-auto-rows: 0;
    row-gap: 0;
    overflow: clip;
  }

  & [data-grid-figure="breakout"] {
    grid-auto-flow: dense;
  }

  & .cell {
    display: block;
    min-inline-size: 0.25rem;
    block-size: 2rem;
    border-radius: 0.2rem;
    background-color: var(--color-interactive-primary);
  }

  & .cell-gutter {
    background-color: var(--color-surface-inset);
    outline: 1px dashed var(--color-border-default);
    outline-offset: -1px;
  }

  & .readout {
    row-gap: 0.25rem;
    font-family: var(--fontFamily-code);
    font-size: var(--fontSize-label-small);
    color: var(--color-text-secondary);
    overflow-wrap: anywhere;
  }

  & .tokens {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;

    & code { color: var(--color-text-primary); }
  }
}
</style>
