---
// /docs/button/coverage — every button, every state. The bench on /docs/button draws the
// state map for two emphases; this page mounts ButtonCoverage, which draws it for every
// emphasis × intent of an action and every emphasis of a link. Nothing hidden by omission.
import Layout from "../../../layouts/Layout.astro";
import Heading from "tsugite/Heading/Heading.astro";
import TextBlock from "tsugite/TextBlock/TextBlock.astro";
import ButtonCoverage from "tsugite/fixtures/ButtonCoverage.astro";
---

<Layout title="Button — full coverage">
  <main class="Main ButtonCoveragePage grid-container">
    <div class="content">
      <nav class="doc-breadcrumb" aria-label="Map"><a href="/map">Map</a> <span aria-hidden="true">/</span> <a href="/docs/button">Button</a> <span aria-hidden="true">/</span> Full coverage</nav>
      <Heading element="h1" size="1" text="Button — full coverage" />
      <TextBlock text="Every emphasis, every intent, every content, every state and every pair of states, at every size, square and pill. One table per content: idle above, each state alone on the diagonal, two states meeting below it, the triples underneath. What cannot happen is hatched with its reason; pairs not yet measured are marked." />
      <ButtonCoverage />
    </div>
  </main>
</Layout>

<style is:global>
/* The page's arrangement only, as the control room's. */
.ButtonCoveragePage {
  padding-block: 3rem 4rem;
  background-color: var(--color-surface-page);

  & .content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  & .doc-breadcrumb {
    font-size: var(--fontSize-label-small);
    color: var(--color-text-secondary);
    & a { color: var(--color-interactive-secondary-text); }
  }
}
</style>
