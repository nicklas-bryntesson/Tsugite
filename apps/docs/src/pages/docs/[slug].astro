---
// /docs/[slug] — one page per component, from the manifest (flat URLs:
// the pillar is a data column, never a path segment). Mounts the
// component's EXISTING kitchensink section — same component as the test
// bench, two mounts, no drift. The heavier doc content grows later.
import Layout from "../../layouts/Layout.astro";
import Heading from "tsugite/components/Heading/Heading.astro";
import { manifest, pillarLabels } from "../../lib/manifest.ts";

export function getStaticPaths() {
  return manifest
    .filter((e) => e.published && e.pillar !== "chrome")
    .map((e) => ({ params: { slug: e.slug }, props: { entry: e } }));
}

const { entry } = Astro.props;

// Explicit section map — glob cannot cross the package boundary.
import { sections } from "../../lib/sections.ts";
const Section = entry.section ? sections[entry.section] : undefined;

---

<Layout title={entry.title}>
  <main class="Main DocPage grid-container">
    <div class="content">
      <nav class="doc-breadcrumb" aria-label="Map">
        <a href="/map">Map</a> <span aria-hidden="true">/</span> {pillarLabels[entry.pillar]}
      </nav>

      <Heading element="h1" size="1" text={entry.title} />

      <ul class="doc-meta">
        <li class="chip" data-kind="pillar">{pillarLabels[entry.pillar]}</li>
        {entry.family && <li class="chip" data-kind="family">fields</li>}
      </ul>

      {Section ? (
        <div class="doc-demo">
          <Section />
        </div>
      ) : entry.demoHref ? (
        <p class="doc-note">
          Lives in the page flow — see <a href={entry.demoHref}>{entry.demoHref}</a>.
        </p>
      ) : null}
    </div>
  </main>
</Layout>

<style is:global>
.DocPage {
  padding-block: 3rem 4rem;
  background-color: var(--color-surface-page);

  & .content {
    /* placed in the main area by the .grid-container > * default */
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  & .doc-breadcrumb {
    font-size: 0.85rem;
    color: var(--color-text-secondary);

    & a { color: var(--color-interactive-secondary-text); }
  }

  & .doc-meta {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  & .chip {
    font-size: 0.75rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-secondary);
    background-color: var(--color-surface-chrome);

    &[data-kind="pillar"] {
      border-color: var(--color-interactive-primary);
      color: var(--color-text-primary);
    }
    & code { font-size: 0.72rem; }
  }

  & .doc-note { color: var(--color-text-secondary); }

  /* sections carry bench classes; give them the same breathing room */
  & .doc-demo {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    inline-size: 100%;
  }
}
</style>
