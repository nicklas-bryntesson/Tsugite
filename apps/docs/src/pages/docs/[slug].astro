---
// /docs/[slug] — the FALLBACK page for every component that has no explicit
// page of its own yet. It mounts the component's test-bench fixture, the same
// component the conformance suite runs against. An explicit page
// (docs/notice.astro) wins by Astro's route priority; it is also excluded
// here so the two never both build.
import Layout from "../../layouts/Layout.astro";
import DocPage from "../../components/DocPage/DocPage.astro";
import { manifest } from "../../lib/manifest.ts";
import { sections } from "../../lib/sections.ts";

export function getStaticPaths() {
  // Slugs with an explicit page: every docs/*.astro that is not this file.
  const explicit = new Set(
    Object.keys(import.meta.glob("./*.astro")).map((p) => p.replace("./", "").replace(".astro", "")),
  );
  return manifest
    .filter((e) => e.published && e.pillar !== "chrome" && !explicit.has(e.slug))
    .map((e) => ({ params: { slug: e.slug }, props: { entry: e } }));
}

const { entry } = Astro.props;
const Section = entry.section ? sections[entry.section] : undefined;
---

<Layout title={entry.title}>
  <DocPage entry={entry}>
    {Section ? (
      <div class="doc-demo">
        <Section />
      </div>
    ) : entry.demoHref ? (
      <p class="doc-note">
        Lives in the page flow — see <a href={entry.demoHref}>{entry.demoHref}</a>.
      </p>
    ) : null}
  </DocPage>
</Layout>
