---
// /docs/modal — the Modal page, explicit. Each example is one file under
// src/examples/modal/, mounted twice (Figure + Code), the code without its imports. The
// bench the suite runs against is mounted at /docs/modal/test.
import Text from "tsugite/Text/Text.astro";
import Layout from "../../layouts/Layout.astro";
import Example from "../../components/Example/Example.astro";
import DocPage from "../../components/DocPage/DocPage.astro";
import { entryFor } from "../../lib/manifest.ts";

import Alert from "../../examples/modal/Alert.astro";
import alertSrc from "../../examples/modal/Alert.astro?raw";
import Terms from "../../examples/modal/Terms.astro";
import termsSrc from "../../examples/modal/Terms.astro?raw";
import Drawer from "../../examples/modal/Drawer.astro";
import drawerSrc from "../../examples/modal/Drawer.astro?raw";
import Banner from "../../examples/modal/Banner.astro";
import bannerSrc from "../../examples/modal/Banner.astro?raw";
import Lang from "../../examples/modal/Lang.astro";
import langSrc from "../../examples/modal/Lang.astro?raw";

const entry = entryFor("modal");
---

<Layout title={entry.title}>
  <DocPage
    entry={entry}
    lead={'Any content as a modal, without the content knowing it is in one. The modal gives it the top layer, a locked page, Esc and focus returned. The content names and closes it with attributes — data-channel="title", "description", "close" — no id, any framework.'}
  >
    <Example id="alert" title="An alert" lead="Closed only by an answer." source={alertSrc} frontmatter={false} block frame={false}>
      <Alert />
    </Example>

    <Example id="terms" title="Long content" lead="The modal scrolls, the page does not. A click beside the content closes it." source={termsSrc} frontmatter={false} block frame={false}>
      <Terms />
    </Example>

    <Example id="drawer" title="A drawer" lead="The content places itself; the modal has no placement." source={drawerSrc} frontmatter={false} block frame={false}>
      <Drawer />
    </Example>

    <Example id="banner" title="A banner" lead="Neither Esc nor a click beside it closes it — only a choice." source={bannerSrc} frontmatter={false} block frame={false}>
      <Banner />
    </Example>

    <Example id="lang" title="Its name keeps the content's language" lead="The modal owns no words; its name is the content's title, in the title's language." source={langSrc} frontmatter={false} block frame={false}>
      <Lang />
    </Example>

    <div class="doc-note"><Text>Every case, measured, is on <a href="/docs/modal/test">the test bench</a>.</Text></div>
  </DocPage>
</Layout>
