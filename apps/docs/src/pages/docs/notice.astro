---
// /docs/notice — the Notice page, explicit. The page is the view: it
// imports exactly the examples it needs. Each example is one file under
// src/examples/notice/, mounted twice — rendered in the Figure, shown as
// source in the Code — so the documentation can never drift from the demo.
// The test bench (the package fixture the conformance suite runs against)
// is mounted last, unchanged.
import Layout from "../../layouts/Layout.astro";
import Heading from "tsugite/components/Heading/Heading.astro";
import TextBlock from "tsugite/components/TextBlock/TextBlock.astro";
import NoticeSection from "tsugite/fixtures/NoticeSection.astro";
import Example from "../../components/Example/Example.astro";
import DocPage from "../../components/DocPage/DocPage.astro";
import { entryFor } from "../../lib/manifest.ts";

import Variants from "../../examples/notice/Variants.astro";
import variantsSrc from "../../examples/notice/Variants.astro?raw";
import Border from "../../examples/notice/Border.astro";
import borderSrc from "../../examples/notice/Border.astro?raw";
import Emphasis from "../../examples/notice/Emphasis.astro";
import emphasisSrc from "../../examples/notice/Emphasis.astro?raw";
import NoIcon from "../../examples/notice/NoIcon.astro";
import noIconSrc from "../../examples/notice/NoIcon.astro?raw";

const entry = entryFor("notice");
---

<Layout title={entry.title}>
  <DocPage entry={entry}>
    <TextBlock
      text="A presentational message: severity, icon and text. Payload only — no live role, no announcement, no dismissal. To announce it, the context renders it into a persistent live region."
    />

    <Example
      id="variants"
      title="Variants"
      lead="One accent token per severity. The icon carries the meaning alongside the colour; the tint is derived from the accent."
      source={variantsSrc}
    >
      <Variants />
    </Example>

    <Example
      id="border"
      title="Border"
      lead="data-border adds a full border in the accent colour. Nothing else changes."
      source={borderSrc}
    >
      <Border />
    </Example>

    <Example
      id="emphasis"
      title="Emphasis"
      lead="data-emphasis is the styled hook: a thick leading bar. The toggles are independent and compose."
      source={emphasisSrc}
    >
      <Emphasis />
    </Example>

    <Example
      id="icon"
      title="Without icon"
      lead="data-icon=&quot;false&quot; drops the icon and lets the content take the whole width."
      source={noIconSrc}
    >
      <NoIcon />
    </Example>

    <section class="doc-bench" id="test-bench">
      <Heading text="Test bench" element="h2" size="2" />
      <p class="doc-note">
        The package fixture the conformance suite runs against — every variant and state, mounted unchanged.
      </p>
      <NoticeSection />
    </section>
  </DocPage>
</Layout>
