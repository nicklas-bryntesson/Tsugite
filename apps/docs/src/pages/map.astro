---
// /map — the system map, rendered entirely from the docs manifest:
// the map cannot lie about the system, because it IS the system's data.
// Three pillars stand on the ground strip (Foundations + Kernel — the
// no-DOM material); the test bench is linked but lives outside the map.
// The site's own shell is the docs app's, not the system's, and is not on it. Every word goes through a typography door,
// every frame is a Card, every ground a Surface; this file only arranges.
import Layout from "../layouts/Layout.astro";
import Heading from "tsugite/Heading/Heading.astro";
import Text from "tsugite/Text/Text.astro";
import TextBlock from "tsugite/TextBlock/TextBlock.astro";
import Caption from "tsugite/Caption/Caption.astro";
import Card from "tsugite/Card/Card.astro";
import Surface from "tsugite/Surface/Surface.astro";
import { manifest, foundations, kernelModules, pillarLabels, pillarMeta, foundationsMeta, type Pillar } from "../lib/manifest.ts";

const pillars: Pillar[] = ["primitive", "composition", "region"];
const byPillar = (p: Pillar) => manifest.filter((e) => e.pillar === p);
const pillarNotes: Record<string, string> = {
  primitive: "Owns its own vocabulary — is content.",
  composition: "Owns arrangement only.",
  region: "Governs a capability, projects state.",
};

/** One row of the map: a link when the page exists, the title and "soon" when it does not. */
type Row = { title: string; href?: string; badge?: string };
const rowsOf = (p: Pillar): Row[] =>
  byPillar(p).map((e) => (e.published ? { title: e.title, href: `/docs/${e.slug}`, badge: e.family } : { title: e.title, badge: "soon" }));
const foundationRows: Row[] = foundations.map((f) => (f.published ? { title: f.title, href: f.href } : { title: f.title, badge: "soon" }));
---

<Layout title="Map">
  <main class="Main MapPage grid-container">
    <div class="content">
      <Heading element="h1" size="1" text="Map" />
      <TextBlock text="Everything in the system, sorted by what each piece owns." />

      <div class="pillars">
        {pillars.map((p) => (
          <Card border={true} padding="none">
            <Surface element="section" theme="neutral" prominence="primary" capInline={false} class="pillar" aria-labelledby={`pillar-${p}`}>
              <div class="pillar-body">
              <header class="pillar-head">
                {pillarMeta[p].romaji && (
                  <Caption size="sm">
                    {pillarMeta[p].romaji}{" "}<span lang="ja" aria-hidden="true">{pillarMeta[p].kanji}</span>
                  </Caption>
                )}
                <Heading element="h2" size="4" text={pillarLabels[p]} id={`pillar-${p}`} />
                <Text size="sm" text={pillarNotes[p]} />
              </header>
              <ul class="rows">
                {rowsOf(p).map((r) => {
                  const Tag = r.href ? "a" : "div";
                  return (
                  <li>
                    <Tag class="minicard" href={r.href} data-unpublished={r.href ? undefined : ""}>
                      <Card border={true} padding="none">
                        <Surface theme="neutral" prominence="subtle" capInline={false} class="row"><div class="row-line">
                          <Caption voice="nav" text={r.title} />
                          {r.badge && (
                            <div class="badge">
                              <Surface theme="inverse" prominence="primary" capInline={false} class="pill"><Caption size="sm" text={r.badge} /></Surface>
                            </div>
                          )}
                        </div></Surface>
                      </Card>
                    </Tag>
                  </li>
                  );
                })}
              </ul>
              </div>
            </Surface>
          </Card>
        ))}
      </div>

      <section class="ground" aria-label="Foundations">
        <div class="ground-col">
          <header class="pillar-head">
            <Caption size="sm">
              {foundationsMeta.romaji}{" "}<span lang="ja" aria-hidden="true">{foundationsMeta.kanji}</span>
            </Caption>
            <Heading element="h2" size="5" text={foundationsMeta.label} />
            <Text size="sm" text="Tokens — what everything is made of." />
          </header>
          <ul class="rows">
            {foundationRows.map((r) => {
              const Tag = r.href ? "a" : "div";
              return (
              <li>
                <Tag class="minicard" href={r.href} data-unpublished={r.href ? undefined : ""}>
                  <Card border={true} padding="none">
                    <Surface theme="neutral" prominence="subtle" capInline={false} class="row"><div class="row-line">
                      <Caption voice="nav" text={r.title} />
                      {r.badge && (
                        <div class="badge">
                          <Surface theme="inverse" prominence="primary" capInline={false} class="pill"><Caption size="sm" text={r.badge} /></Surface>
                        </div>
                      )}
                    </div></Surface>
                  </Card>
                </Tag>
              </li>
              );
            })}
          </ul>
        </div>
        <div class="ground-col">
          <header class="pillar-head">
            <Heading element="h2" size="5" text="Kernel" />
            <Text size="sm" text="Logic without DOM." />
          </header>
          <ul class="kernel-list">
            {kernelModules.map((m) => (
              <li class="chip"><Caption size="sm"><code>{m}</code></Caption></li>
            ))}
          </ul>
        </div>
      </section>

      <Text size="sm">
        <a href="/control-room">Control room</a> — drift checks
      </Text>
    </div>
  </main>
</Layout>

<style is:global>
/* Arrangement only: the words are the typography doors', the frames Card's, the grounds
   Surface's (its own knobs set here, ADR-0013 §3). The texts are trimmed to their letters,
   so every gap below is all the air between them — none comes from a line height. */
.MapPage {
  padding-block: 4rem;
  background-color: var(--color-surface-page);

  & .content {
    /* placed in the main area by the .grid-container > * default */
    display: flex;
    flex-direction: column;
    gap: var(--size-xl);
  }

  & .pillars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: 1.25rem;
    align-items: start;
    inline-size: 100%;
  }

  & .pillar {
    --_sf-paddingBlock: var(--size-lg);
    --_sf-paddingInline: var(--size-lg);
  }

  & .pillar-body {
    display: flex;
    flex-direction: column;
    gap: var(--size-lg);
  }

  & .pillar-head {
    display: flex;
    flex-direction: column;
    gap: var(--size-md);
  }

  & .rows,
  & .kernel-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--size-sm);
  }

  & .rows {
    flex-direction: column;
  }

  & .kernel-list {
    flex-wrap: wrap;
  }

  & .row {
    --_sf-paddingBlock: var(--size-md);
    --_sf-paddingInline: var(--size-md);
  }

  & .row-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--size-sm);
  }

  /* TODO(decide): the mini card — a whole card that is one link, authored words, grouped
     information and something at the end (an icon, here a pill) — is a component the
     system does not have yet (the "Found a mistake? Contact us →" row is the other case).
     Until its decisions are made it lives in this template; pull it out into its own
     component when it gets them. */
  & .minicard {
    display: block;
    color: inherit;
    text-decoration: none;
    border-radius: 0.5rem;
  }

  /* Card's own border knob, set on its root (ADR-0013 §3). */
  & a.minicard:hover > .Card {
    --_cd-borderColor: var(--color-interactive-primary);
  }

  & a.minicard:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  & [data-unpublished] {
    opacity: 0.6;
  }

  /* TODO(decide): the badge and the kernel chip are a Caption in a frame until the pill
     primitive is designed (parking lot: badges, the resolution panel's chips and the doc
     chips together). */
  /* The faux pill: an inverse × primary Surface owns the ground and the ink; the wrapper
     only rounds and clips it. */
  & .badge {
    border-radius: 999px;
    overflow: hidden;
  }

  & .pill {
    --_sf-paddingBlock: var(--size-xs);
    --_sf-paddingInline: var(--size-sm);
  }

  & .chip {
    padding: var(--size-xs) var(--size-sm);
    border-radius: var(--size-xs);
    background-color: var(--color-surface-inset);
  }

  /* the ground strip the pillars stand on */
  & .ground {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: 1.25rem;
    inline-size: 100%;
    border-block-start: 3px solid var(--color-border-default);
    padding-block-start: 1.5rem;
  }

  & .ground-col {
    display: flex;
    flex-direction: column;
    gap: var(--size-lg);
  }
}
</style>
