---
// /control-room — drift checks for humans. The conformance suites are
// the mechanical twin; this is the instrument panel where drift SHOWS:
//   1. Resolution — which branch of every support gate THIS browser and
//      display actually resolve (drag the window to another monitor and
//      watch the gamut row change).
//   2. Alignment — the comparison table: the field control (one height,
//      2.5rem) against each button size, between dashed guides. Which
//      button stop lines up with a field is a finding, not a given.
//   3. Baseline trim — the heading text-trim check (shared with the bench).
//   4. The donut matrix — voices × volumes (shared with the bench).
import Layout from "../layouts/Layout.astro";
import ResolutionPanel from "../components/ResolutionPanel/ResolutionPanel.astro";
import Heading from "tsugite/components/Heading/Heading.astro";
import Prose from "tsugite/components/Prose/Prose.astro";
import AffixField from "tsugite/components/AffixField/AffixField.astro";
import LinkButton from "tsugite/components/Button/LinkButton.astro";
import ActionButton from "tsugite/components/Button/ActionButton.astro";
import Misc from "tsugite/fixtures/Misc.astro";
import ThemesSection from "tsugite/fixtures/ThemesSection.astro";

const buttonSizes = ["sm", "md", "lg"];
---

<Layout title="Control room">
  <main class="Main ControlRoom grid-container">
    <div class="content">
      <nav class="doc-breadcrumb" aria-label="Map"><a href="/map">Map</a> <span aria-hidden="true">/</span> Control room</nav>
      <Heading element="h1" size="1" text="Control room" />
      <Prose variant="basic">
        <p>Where drift shows before it ships. Every control has a mechanical twin in the e2e suite.</p>
      </Prose>

      <section class="KitchenSink-section" id="Resolution">
        <Heading element="h2" size="2" text="Resolution" />
        <p class="note">
          What this browser and display actually resolve. Drag the window to another
          monitor and watch the gamut row follow.
        </p>
        <ResolutionPanel />
        <div class="gamut-pair">
          <span class="gamut-swatch" style="background: oklch(67.13% 0.2851 343.06)"></span>
          <span class="gamut-swatch" style="background: #ff0ac2"></span>
          <p class="note">
            The same color, authored (oklch) and gamut-mapped (hex). Identical on an
            sRGB display — the left one is more saturated on P3.
          </p>
        </div>
      </section>

      <section class="KitchenSink-section" id="Alignment">
        <Heading element="h2" size="2" text="Alignment" />
        <p class="note">
          The field control has one height — <code>2.5rem</code>. Each row pairs it
          with one button size between the guides: a row that doesn't line up is a
          finding, not a layout bug on this page.
        </p>

        {buttonSizes.map((size) => (
          <div class="guide-group">
            <p class="guide-label">field × button <code>{size}</code></p>
            <div class="guide-row" data-guide={size}>
              <AffixField id={`align-affix-${size}`} label="Amount" input={{ inputmode: "decimal" }} />
              <LinkButton href="#Alignment" size={size} emphasis="primary">Link {size}</LinkButton>
              <ActionButton size={size} emphasis="secondary">Action {size}</ActionButton>
            </div>
          </div>
        ))}
      </section>

      <Misc />

      <ThemesSection />
    </div>
  </main>
</Layout>

<style is:global>
.ControlRoom {
  padding-block: 3rem 4rem;
  background-color: var(--color-surface-page);

  & .content {
    /* placed in the main area by the .grid-container > * default */
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  & .doc-breadcrumb {
    font-size: var(--fontSize-label-small);
    color: var(--color-text-secondary);
    & a { color: var(--color-interactive-secondary-text); }
  }

  & .note { margin: 0; color: var(--color-text-secondary); font-size: var(--fontSize-label); }

  & .gamut-pair {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-block-start: 0.75rem;
  }

  & .gamut-swatch {
    inline-size: 3rem;
    block-size: 3rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border-subtle);
    flex: none;
  }

  & .guide-group { inline-size: 100%; }

  & .guide-label {
    margin: 1rem 0 0.25rem;
    font-size: var(--fontSize-label-small);
    font-weight: var(--fontWeight-body-bold);
    /* tracked-caps manner stays raw pending the Eyebrow primitive */
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  /* dashed guides around the control line; controls bottom-align so
     labels can hang above without disturbing the measurement */
  & .guide-row {
    display: flex;
    align-items: flex-end;
    gap: 1rem;
    flex-wrap: wrap;
    border-block: 1px dashed var(--color-feedback-error);
    padding-block: 0;
    inline-size: 100%;
  }
}
</style>
