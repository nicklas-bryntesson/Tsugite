---
// Home — what Tsugite is, told through the system itself: the hero is the
// CoverComposition (primitives → composition → page), and the sections
// below speak with the system's own voices (data-theme × data-prominence).
import Layout from "../layouts/Layout.astro";
import CoverComposition from "tsugite/CoverComposition/CoverComposition.astro";
import Heading from "tsugite/Heading/Heading.astro";
import Prose from "tsugite/Prose/Prose.astro";
import LinkButton from "tsugite/Button/LinkButton.astro";
import Text from "tsugite/Text/Text.astro";
import Card from "tsugite/Card/Card.astro";
import Surface from "tsugite/Surface/Surface.astro";

const cover = {
  title: "Tsugite",
  preamble:
    "A design-system reference built like joinery: pieces meet through contracts that fit exactly — and refuse what doesn't.",
  videoSrc: "/media/multicolored-background.mp4",
  poster: "/media/poster.webp",
};

const cta = [
  { url: "/map", text: "Explore the map", emphasis: "primary", newTab: false },
  { url: "/control-room", text: "Control room", emphasis: "secondary", newTab: false },
];

const principles = [
  {
    voice: "brand",
    title: "Colour by context, not by prop",
    body: "A component shouldn't need a prop for every place it can appear. A section sets whose palette speaks and how loud — two attributes — and everything inside reads it through one chain.",
    href: "/docs/color",
    link: "See the color system",
  },
  {
    voice: "neutral",
    title: "Contrast that is checked, not hoped for",
    body: "Light, dark and both contrast modes are generated from one source, and their contrast is tested at build. A colour change that breaks WCAG should fail a test, not a reader.",
    href: "/docs/button/test",
    link: "See a test bench",
  },
  {
    voice: "accent",
    title: "A baseline that always works",
    body: "The page should work in every browser, with or without JavaScript. Enhancements sit behind support gates, and each colour is authored once in oklch, with its sRGB fallback computed from it.",
    href: "/control-room",
    link: "Watch it resolve",
  },
];
---

<Layout title="Tsugite" template="home" preloadImage={cover.poster}>
  <main class="Main grid-container Home">
    <section class="Hero">
      <CoverComposition
        headingLevel="h1"
        title={cover.title}
        preamble={cover.preamble}
        videoSrc={cover.videoSrc}
        poster={cover.poster}
        buttons={cta}
      />
    </section>

    <section class="HomeIntro">
      <div class="kanji-mark"><Heading element="p" voice="display" size="2" text="継手" lang="ja" aria-hidden="true" /></div>
      <Heading element="h2" size="2" text="Joints, not glue" />
      <Prose variant="basic">
        <p>
          <strong>Tsugite</strong> (継手) are the joints of Japanese carpentry: pieces cut
          to meet so precisely that no nails are needed, and a wrong assembly will not fit.
          Tsugite brings that idea to the front end. Every interface is a contract, and
          what a contract does not allow does not exist.
        </p>
      </Prose>
    </section>

    <div class="HomePrinciples">
      {principles.map((p) => (
        <Card padding="none">
          <Surface element="section" theme={p.voice} prominence="subtle" capInline={false} class="principle">
            <div class="principle-body">
              <Heading element="h3" size="4" text={p.title} />
              <Text text={p.body} />
              <LinkButton href={p.href} size="md" emphasis="primary">{p.link}</LinkButton>
            </div>
          </Surface>
        </Card>
      ))}
    </div>
  </main>
</Layout>

<style is:global>
/* Arrangement only: the words are the typography doors', each principle a Card holding a
   Surface that claims its voice (the Surface's own knobs set here, ADR-0013 §3). The
   texts are trimmed to their letters, so the gaps are all the air between them. */
.Home {
  & .HomeIntro {
    padding-block: 4rem 1rem;
    display: flex;
    flex-direction: column;
    gap: var(--size-lg);
    max-inline-size: 46rem;
  }

  /* the kanji mark is quieter than the words around it: the muted channel, inherited */
  & .kanji-mark {
    color: var(--color-text-secondary);
  }

  & .HomePrinciples {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: 1.25rem;
    inline-size: 100%;
    padding-block: 2rem 4rem;
  }

  & .principle {
    --_sf-paddingBlock: var(--size-lg);
    --_sf-paddingInline: var(--size-lg);

    /* the Card is a flex column and the grid stretches it, so the ground fills the card */
    flex: 1;
    display: flex;
    flex-direction: column;

    /* TODO(decide): this reaches into Surface's own part (.content) so the body can fill
       the card's height; Surface has no way to say "my content fills me". A knob or axis
       on Surface would end this. */
    & > .content {
      flex: 1;
      display: flex;
      flex-direction: column;
    }
  }

  & .principle-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--size-lg);
    align-items: flex-start;

    /* the button sits at the card's foot, whatever the length of the words above it */
    & > .Button {
      margin-block-start: auto;
    }
  }
}
</style>
